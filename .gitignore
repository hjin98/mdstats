# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Native build artifacts
*.o
*.obj
*.so
*.pyd
*.dll
*.dylib
*.a
*.lib

# Environments
.venv/
venv/
.env/
.env
.env.*
!.env.example

# Testing / coverage
.pytest_cache/
.coverage
htmlcov/

# Editors / OS
.vscode/
.idea/
.DS_Store
*~

# Scientific / runtime outputs
*.log
*.tmp
*.bak

# Large local data.  `data/` is a blanket rule for local inputs at any depth, so
# it also caught two directories that hold real tracked repository content: the
# package data pyproject already ships (`mdstats/data/*.json`) and the small
# deterministic fixtures the test suite reads.  Both are re-included here.
data/
!mdstats/data/
!tests/data/
trajectories/
results/
scratch/
tmp/

# Preserved P5A6 -> P6 compatibility fixture (generated campaign workspace with
# checkpoints). Its immutable identity, content manifest, database snapshot, and
# deterministic builder are tracked; the ~3 MiB workspace itself is not.
qualification/p6-p5a6-compat/workspace/

# Serena local/runtime state
.serena/*
!.serena/project.yml
