+        if self.callback is not None and (milestone or now - self.last_emit >= self.interval):
+            self.callback(self._message(heartbeat=False))
+            self.last_emit = now
+
+    def heartbeat_due(self) -> bool:
+        return time.monotonic() - self.last_emit >= self.interval
+
+    def heartbeat(self) -> None:
+        if self.callback is not None:
+            self.callback(self._message(heartbeat=True))
+            self.last_emit = time.monotonic()
