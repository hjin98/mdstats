+class _FamilyProgress:
+    """Rate-limited FEAS1 family progress/heartbeat formatter."""
+
+    __slots__ = (
+        "callback", "completed_blocks", "completed_witnesses", "family_id",
+        "interval", "last_emit", "started", "total_blocks", "total_witnesses",
+    )
+
+    def __init__(
+        self,
+        family_id: str,
+        *,
+        total_blocks: int,
+        total_witnesses: int,
+        interval_seconds: float,
+        callback: Callable[[str], None] | None,
+    ) -> None:
+        self.callback = callback
+        self.completed_blocks = 0
+        self.completed_witnesses = 0
+        self.family_id = str(family_id)
+        self.interval = max(0.1, float(interval_seconds))
+        self.started = time.monotonic()
+        self.last_emit = self.started
+        self.total_blocks = max(1, int(total_blocks))
+        self.total_witnesses = max(1, int(total_witnesses))
+
+    @staticmethod
+    def _duration(seconds: float) -> str:
+        value = max(0, int(round(seconds)))
+        hours, remainder = divmod(value, 3600)
+        minutes, secs = divmod(remainder, 60)
+        if hours:
+            return f"{hours:d}h{minutes:02d}m{secs:02d}s"
+        if minutes:
+            return f"{minutes:d}m{secs:02d}s"
+        return f"{secs:d}s"
+
+    def _message(self, *, heartbeat: bool) -> str:
+        now = time.monotonic()
+        elapsed = max(0.0, now - self.started)
+        rate = self.completed_witnesses / elapsed if elapsed > 0.0 else 0.0
+        remaining = max(0, self.total_witnesses - self.completed_witnesses)
+        eta = remaining / rate if rate > 0.0 else None
+        percent = 100.0 * self.completed_witnesses / self.total_witnesses
+        eta_text = "estimating" if eta is None else self._duration(eta)
+        kind = "heartbeat" if heartbeat else "progress"
+        return (
+            f"family {self.family_id}: {kind} "
+            f"blocks={self.completed_blocks}/{self.total_blocks}; "
+            f"witnesses={self.completed_witnesses}/{self.total_witnesses} "
+            f"({percent:.1f}%); elapsed={self._duration(elapsed)}; "
+            f"rate={rate:.1f} witness/s; eta={eta_text}"
+        )
