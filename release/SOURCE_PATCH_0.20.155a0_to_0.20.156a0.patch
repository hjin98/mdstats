+        return original(*args, **kwargs)
+
+    monkeypatch.setattr(lta, "compute_atomic_connectivity", counted)
+    monkeypatch.setattr(lta, "prepare_framework_dynamics_scene", lambda *args, **kwargs: SimpleNamespace())
