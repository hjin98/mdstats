+                np.abs(fractional - np.rint(fractional)),
+                0.5,
+                rtol=0.0,
+                atol=1.0e-10,
+            ),
+            axis=1,
+        )
+    else:
+        all_shifts = np.empty((0, 3), dtype=np.int64)
+        ties = np.empty(0, dtype=bool)
