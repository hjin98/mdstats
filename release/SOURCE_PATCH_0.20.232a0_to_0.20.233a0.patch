+    for token in (
+        "_Eval2StaticReductionMetadata",
+        "_eval2_static_reduction_metadata",
+        "bootstrap_target_temporary_bytes = 32 * 1024**2",
+        "memory_bounded_batch",
+        "vector = np.empty(int(view.total_atom_count)",
