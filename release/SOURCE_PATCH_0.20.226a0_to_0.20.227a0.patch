+    if progress_callback is not None:
+        progress_callback(
+            f"global complete: families={len(manifest)}; witnesses={total_witnesses}; edges={store.edge_count}; "
+            f"digest={store.content_digest[:12]}...; wall={telemetry.wall_seconds:.3f}s"
+        )
