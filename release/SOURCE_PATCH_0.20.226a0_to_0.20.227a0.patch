+                    }
+                )
+            domains.append(
+                {
+                    "label_domain_id": domain.label_domain_id,
+                    "frame_domain_digest": domain.frame_domain_digest,
+                    "candidate_count": domain.candidate_count,
+                    "authority_version": domain.authority_version,
