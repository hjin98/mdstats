+def _reuse_materialization_if_current(
+    store: CampaignStore,
+    *,
+    variant_id: str,
+    plan: Any,
+) -> tuple[Any, Any] | None:
+    """Restore an unchanged DATA7/DATA8 variant without rehashing its tree."""
+
+    import mdstats
+
+    materialization_key = f"materialization:{variant_id}"
+    data8_key = f"data8:{variant_id}"
+    if not store.has_record(materialization_key) or not store.has_record(data8_key):
+        return None
+    try:
+        record = store.get_record(
+            materialization_key,
+            mdstats.ProductionMaterializationRecord,
+        )
+        bundle = store.get_record(data8_key, mdstats.Data8PreparationBundle)
+    except Exception:
+        return None
+    if not record.complete or record.checkpoint.plan.content_digest != plan.content_digest:
+        return None
+    artifact = record.checkpoint.data8_artifact
+    if artifact is None or artifact.bundle_digest != bundle.content_digest:
+        return None
+    try:
+        _validate_data8_variant_identity(variant_id, bundle)
+    except CampaignCliError:
+        return None
+    root = Path(record.root_directory).resolve()
+    live = root / artifact.relative_directory
+    bundle_path = root / artifact.bundle_relative_path
+    if not live.is_dir() or not bundle_path.is_file():
+        return None
+    return record, bundle
