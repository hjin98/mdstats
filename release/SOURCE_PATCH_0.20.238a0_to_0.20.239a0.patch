+@dataclass(frozen=True, slots=True)
+class TemporalAssignmentResourcePolicy:
+    max_samples: int = 5_000_000
+    max_atoms: int = 100_000
+    max_intervals: int = 5_000_000
+    max_passages: int = 5_000_000
