+def _command_verify_train2_relax(
+    args: argparse.Namespace,
+    *,
+    cfg: Mapping[str, Any],
+    paths: CampaignPaths,
+    store: CampaignStore,
+    campaign: Any,
+    model_dtype: str,
+    deploy: Any,
+    pes: Any,
+) -> int:
+    """Run/reuse RELAX-VERIFY1 and hand passing candidates directly to DYN-VERIFY2."""
+
+    import mdstats
+
+    if pes.campaign_plan_digest != campaign.content_digest or pes.deploy_verify_campaign_digest != deploy.content_digest:
+        raise CampaignCliError("RELAX-VERIFY1 received stale PES-VERIFY1 authority.")
+    if pes.all_candidates_failed:
+        _mark_stage(store, paths, "verify", StageState.FAILED, "PES-VERIFY1 rejected every candidate before relaxation")
+        return 1
+    convergence = _load_verified_target_size_convergence_authority(store)
+    target_atoms, _ = _pes_verify_common_target(
+        paths=paths, store=store, campaign=campaign, convergence=convergence, deploy=deploy,
+    )
+    policy = _relax_verify_policy(cfg)
+    base_set, base_atoms = mdstats.build_relax_base_set(
+        pes.probe_set,
+        target_atoms,
+        policy=policy,
+        material_contracts=_material_profile_contracts(cfg),
+    )
+    request_root = (paths.results / "relax-verify1").resolve()
+    request = mdstats.write_relax_reference_request(base_set, base_atoms, request_root)
+    store.put_record("relax_verify_base_set", base_set)
+    store.put_record("relax_verify_request", request)
+
+    reference = None
+    ordered_reference = None
+    cached_reference = store.get_record_optional("relax_verify_reference", mdstats.RelaxReferenceArtifact)
+    if cached_reference is not None:
+        cached_path = Path(cached_reference.reference_path).resolve()
+        if (
+            cached_reference.base_set_digest == base_set.content_digest
+            and cached_path.is_file()
+            and _sha256(cached_path) == cached_reference.reference_sha256
+        ):
+            try:
+                reference, ordered_reference = mdstats.load_relax_reference_extxyz(
+                    base_set,
+                    base_atoms,
+                    cached_path,
+                    policy=policy,
+                    protocol_digest=cached_reference.protocol_digest,
+                    protocol_source=cached_reference.protocol_source,
+                    source_file_sha256s=cached_reference.source_file_sha256s,
+                )
+            except Exception:
+                reference = ordered_reference = None
+        if reference is None:
+            store.delete_record("relax_verify_reference")
+
+    external = _relax_external_reference_path(cfg, paths)
+    if reference is None and external is not None:
+        protocol_digest = _relax_reference_protocol_digest(cfg)
+        if protocol_digest is None:
+            raise CampaignCliError(
+                "RELAX-VERIFY1 external reference ExtXYZ requires [verification].relax_reference_protocol_digest "
+                "to authenticate the fixed-cell zero-K DFT relaxation protocol."
+            )
+        reference, ordered_reference = mdstats.load_relax_reference_extxyz(
+            base_set,
+            base_atoms,
+            external,
+            policy=policy,
+            protocol_digest=protocol_digest,
+            protocol_source="campaign_config_external_extxyz",
+        )
+
+    if reference is None:
+        collected = mdstats.collect_relax_reference_from_vasp(
+            base_set,
+            base_atoms,
+            request,
+            output_path=request_root / "dft-relaxed.extxyz",
+            policy=policy,
+        )
+        if collected is not None:
+            reference, ordered_reference = collected
+
+    if reference is None or ordered_reference is None:
+        _mark_stage(
+            store,
+            paths,
+            "verify",
+            StageState.WAITING,
+            "RELAX-VERIFY1 matched zero-K DFT relaxation reference requested",
+        )
+        print("\nRELAX-VERIFY1 DFT relaxation reference is required before verification can continue.")
+        print(f"  request manifest: {request.manifest_path}")
+        print(f"  request ExtXYZ:   {request.extxyz_path}")
+        print("  Run one fixed-cell zero-K VASP ionic relaxation in every dft-inputs directory")
+        print(
+            f"  using identical INCAR/KPOINTS/POTCAR settings and converge max force <= "
+            f"{policy.force_convergence_ev_per_angstrom:.3f} eV/A, then rerun `verify`."
+        )
+        return 0
+    store.put_record("relax_verify_reference", reference)
+
+    eligible_pes = tuple(record for record in pes.run_records if record.passed)
+    eligible_by_run = {record.run_plan_digest: record for record in eligible_pes}
+    cached_campaign = store.get_record_optional("relax_verify", mdstats.RelaxVerifyCampaignRecord)
+    if cached_campaign is not None:
+        reusable = bool(
+            cached_campaign.campaign_plan_digest == campaign.content_digest
+            and cached_campaign.pes_verify_campaign_digest == pes.content_digest
+            and cached_campaign.policy.policy_digest == policy.policy_digest
+            and cached_campaign.base_set.content_digest == base_set.content_digest
+            and cached_campaign.request_artifact.content_digest == request.content_digest
+            and cached_campaign.reference_artifact.content_digest == reference.content_digest
+            and {v.run_plan_digest for v in cached_campaign.run_records} == set(eligible_by_run)
+        )
+        if reusable:
+            for record in cached_campaign.run_records:
+                pes_record = eligible_by_run[record.run_plan_digest]
+                model_path = Path(record.candidate_model_path).resolve()
+                relaxed_path = Path(record.relaxed_artifact_path).resolve()
+                if (
+                    record.pes_verify_run_digest != pes_record.content_digest
+                    or record.candidate_model_sha256 != pes_record.candidate_model_sha256
+                    or not model_path.is_file()
+                    or _sha256(model_path) != record.candidate_model_sha256
+                    or not relaxed_path.is_file()
+                    or _sha256(relaxed_path) != record.relaxed_artifact_sha256
+                ):
+                    reusable = False
+                    break
+        if reusable:
+            if cached_campaign.all_candidates_failed:
+                _mark_stage(store, paths, "verify", StageState.FAILED, "RELAX-VERIFY1 rejected every PES-qualified candidate")
+                return 1
+            _ok(f"RELAX-VERIFY1 reused for {len(cached_campaign.run_records)} PES-qualified candidate(s)")
+            return _command_verify_train2_dyn(
+                args, cfg=cfg, paths=paths, store=store, campaign=campaign, model_dtype=model_dtype,
+                deploy=deploy, relax=cached_campaign,
+            )
+        store.delete_record("relax_verify")
+
+    device = str(_cfg(cfg, "verification", "device", _cfg(cfg, "training", "device", "cuda")))
+    _mark_stage(store, paths, "verify", StageState.RUNNING, "running RELAX-VERIFY1 zero-K topology/geometry qualification")
+    run_records = []
+    for pes_record in eligible_pes:
+        candidate_path = Path(pes_record.candidate_model_path).resolve()
+        if not candidate_path.is_file() or _sha256(candidate_path) != pes_record.candidate_model_sha256:
+            raise CampaignCliError("RELAX-VERIFY1 candidate target-only model bytes changed after PES-VERIFY1.")
+        print(f"[RELAX] relaxing candidate {pes_record.run_plan_digest[:12]} on {len(base_atoms)} common base(s)...", flush=True)
+        relaxed, steps, converged, energy_drop = mdstats.relax_mace_model(
+            candidate_path,
+            base_atoms,
+            policy=policy,
+            device=device,
+            model_dtype=model_dtype,
+            head=None,
+        )
+        metrics = mdstats.assess_relaxed_geometry(
+            base_set,
+            ordered_reference,
+            relaxed,
+            policy=policy,
+            optimizer_steps=steps,
+            converged=converged,
+            energy_drop_ev_per_atom=energy_drop,
+        )
+        qualification = mdstats.RelaxModelQualification(
+            model_sha256=pes_record.candidate_model_sha256,
+            model_role="candidate",
+            base_metrics=metrics,
+            policy_digest=policy.policy_digest,
+        )
+        artifact_path, artifact_sha = mdstats.write_relaxed_model_artifact(
+            relaxed,
+            request_root / "candidates" / pes_record.run_plan_digest / "relaxed.extxyz",
+            base_set,
+        )
+        record = mdstats.RelaxVerifyRunRecord(
+            run_plan_digest=pes_record.run_plan_digest,
+            pes_verify_run_digest=pes_record.content_digest,
+            candidate_model_path=str(candidate_path),
+            candidate_model_sha256=pes_record.candidate_model_sha256,
+            relaxed_artifact_path=artifact_path,
+            relaxed_artifact_sha256=artifact_sha,
+            qualification=qualification,
+        )
+        store.put_record(f"relax_verify_run:{record.run_plan_digest}", record)
+        run_records.append(record)
+        status = "PASS" if record.passed else "FAIL"
+        print(
+            f"[RELAX {status}] {record.run_plan_digest[:12]}: "
+            f"failed_bases={qualification.failed_base_count}",
+            flush=True,
+        )
+
+    authority = mdstats.RelaxVerifyCampaignRecord(
+        campaign_plan_digest=campaign.content_digest,
+        pes_verify_campaign_digest=pes.content_digest,
+        policy=policy,
+        base_set=base_set,
+        request_artifact=request,
+        reference_artifact=reference,
+        run_records=tuple(run_records),
+        stage_context=pes.stage_context,
+    )
+    store.put_record("relax_verify", authority)
+    _atomic_json(request_root / "relax-verify1.json", authority.to_dict())
+    if authority.all_candidates_failed:
+        _mark_stage(store, paths, "verify", StageState.FAILED, "RELAX-VERIFY1 rejected every PES-qualified candidate")
+        print("\nRELAX-VERIFY1 failed: every PES-qualified candidate changed topology or missed the DFT-relaxed geometry tolerances.")
+        return 1
+    _ok(f"RELAX-VERIFY1 complete: {authority.passed_run_count}/{len(authority.run_records)} PES-qualified candidate(s) passed")
+    return _command_verify_train2_dyn(
+        args, cfg=cfg, paths=paths, store=store, campaign=campaign, model_dtype=model_dtype,
+        deploy=deploy, relax=authority,
+    )
+
