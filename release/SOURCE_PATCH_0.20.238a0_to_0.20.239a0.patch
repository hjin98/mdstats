+class SourceTrajectoryAssessmentMode(str, Enum):
+    CONTROLS_ONLY = "controls_only"
+    FULL_IF_AVAILABLE = "full_if_available"
+    FULL_REQUIRED = "full_required"
+
+
+class SourceAssessmentStatus(str, Enum):
