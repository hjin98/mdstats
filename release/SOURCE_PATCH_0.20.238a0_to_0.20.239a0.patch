+BOUNDARY_CROSSING_DIAGNOSTIC_SCHEMA = "mdstats.boundary-crossing-diagnostic.v1"
+STATE_GEOMETRY_REFINEMENT_SCHEMA = "mdstats.state-geometry-refinement.v1"
