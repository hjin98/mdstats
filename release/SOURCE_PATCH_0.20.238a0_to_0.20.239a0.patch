+def command_extend_seed(args: argparse.Namespace) -> int:
+    """Append one optimizer seed to a completed conventional-MLCV campaign and resume it."""
+
+    import mdstats
+
+    cfg, paths = _load_config(args.config)
+    store = CampaignStore(paths.state_db)
+    seed = int(args.seed)
+    if seed < 0:
+        raise CampaignCliError("Seed extension requires a nonnegative optimizer seed.")
+    if str(_cfg(cfg, "evaluation", "checkpoint_strategy", "")).strip().lower() != "mlcv_nested_cv":
+        raise CampaignCliError("`extend-seed` is available only for conventional mlcv_nested_cv campaigns.")
+
+    campaign = store.get_record("training_campaign", mdstats.TrainingCampaignPlan)
+    modes = tuple(sorted({run.training_mode.value for run in campaign.runs}))
+    mode = getattr(args, "training_mode", None)
+    if mode is None:
+        if len(modes) != 1:
+            raise CampaignCliError(
+                "Campaign contains multiple training methods; pass --training-mode explicitly for seed extension."
+            )
+        mode = modes[0]
+    mode = str(mode)
+    if mode not in modes:
+        raise CampaignCliError(f"Training mode {mode!r} is absent from the completed campaign.")
+
+    sizes = tuple(sorted({run.selection_size for run in campaign.runs if run.training_mode.value == mode}))
+    selection_size = getattr(args, "selection_size", None)
+    if selection_size is None:
+        if len(sizes) != 1:
+            raise CampaignCliError(
+                "Campaign contains multiple target selection sizes for this method; pass --selection-size explicitly."
+            )
+        selection_size = sizes[0]
+    selection_size = int(selection_size)
+    if selection_size not in sizes:
+        raise CampaignCliError(
+            f"Selection size n{selection_size} is absent from the completed {mode} campaign."
+        )
+    configured_sizes = tuple(int(value) for value in _cfg(cfg, "selection", "sizes", (512,)))
+    if len(configured_sizes) != 1 or configured_sizes[0] != selection_size:
+        raise CampaignCliError(
+            "`extend-seed` currently requires exactly one configured [selection].sizes value so adding a method seed "
+            "cannot silently create additional size variants."
+        )
+
+    method = _method_spec_by_mode(cfg, mode)
+    if method.seed_mode != "optimizer_only":
+        raise CampaignCliError(
+            "This extension requires seed_mode='optimizer_only' so the appended model uses exactly the same CV folds. "
+            "optimizer_and_cv_partition intentionally changes folds between seeds."
+        )
+    if method.cross_validation_folds < 2:
+        raise CampaignCliError(
+            "Committee seed extension requires conventional CV with at least two folds; the current method has "
+            f"cross_validation_folds={method.cross_validation_folds}."
+        )
+
+    parent_seeds = tuple(sorted({
+        run.seed for run in campaign.runs
+        if run.training_mode.value == mode and run.selection_size == selection_size
+    }))
+    extension_id = f"{mode}-n{selection_size}-seed{seed}"
+    extension_key = _seed_extension_key(mode, selection_size, seed)
+    extension = store.get_payload_optional(extension_key)
+
+    if extension is None:
+        forbidden = _seed_extension_forbidden_authority(store)
+        if forbidden:
+            raise CampaignCliError(
+                "Seed extension is forbidden after VERIFY1/production authority has begun. "
+                "Create a new campaign identity instead. Frozen records present: " + ", ".join(forbidden)
+            )
+        committee = store.get_record_optional("mlcv_final_committee", mdstats.MlcvFinalCommitteeRecord)
+        final_selection = store.get_record_optional("mlcv_final_selection", mdstats.MlcvFinalSelectionRecord)
+        campaign_cv = store.get_record_optional("mlcv_campaign_cv", mdstats.MlcvCampaignCvAggregateRecord)
+        if committee is None or final_selection is None or campaign_cv is None:
+            raise CampaignCliError(
+                "Seed extension requires a completed SELECT1/AGG1/FINAL1 evaluation with an existing committee."
+            )
+        if committee.campaign_plan_digest != campaign.content_digest or final_selection.campaign_plan_digest != campaign.content_digest:
+            raise CampaignCliError("Existing FINAL1 evidence does not belong to the current training campaign.")
+        if seed in parent_seeds or seed in method.seeds:
+            raise CampaignCliError(
+                f"Seed {seed} is already part of this campaign. Use `train --seed {seed}` or `evaluate --seed {seed}` "
+                "to resume existing work rather than extending the campaign."
+            )
+        missing = []
+        for run in campaign.runs:
+            execution = store.get_record_optional(f"execution:{run.run_id}", mdstats.TrainingRunExecutionRecord)
+            if execution is None or execution.state is not mdstats.TrainingRunState.SUCCEEDED:
+                missing.append(run.run_id)
+        if missing:
+            raise CampaignCliError(
+                "Seed extension requires the parent campaign training matrix to be complete. Incomplete runs: "
+                + ", ".join(missing[:8])
+            )
+        if bool(getattr(args, "dry_run", False)):
+            print(
+                f"Would extend {mode} n{selection_size} from seeds {list(parent_seeds)} to "
+                f"{list((*method.seeds, seed))}; preserve {method.cross_validation_folds} identical CV folds; "
+                f"train {method.cross_validation_folds + 1} new run(s); then rebuild AGG1/FINAL1 over all seeds."
+            )
+            return 0
+
+        extension_root = paths.internal / "seed-extensions" / extension_id
+        extension_root.mkdir(parents=True, exist_ok=True)
+        before_config = extension_root / "campaign.before.toml"
+        if not before_config.exists():
+            shutil.copy2(paths.config, before_config)
+        before_sha, after_sha = _replace_method_seed_array(
+            paths.config, mode=mode, expected_existing=method.seeds, new_seed=seed
+        )
+        extension = {
+            "schema": SEED_EXTENSION_SCHEMA,
+            "extension_id": extension_id,
+            "training_mode": mode,
+            "selection_size": selection_size,
+            "seed": seed,
+            "parent_seeds": list(parent_seeds),
+            "cross_validation_folds": method.cross_validation_folds,
+            "fold_partition_seed": method.fold_partition_seed,
+            "seed_mode": method.seed_mode,
+            "parent_campaign_plan_digest": campaign.content_digest,
+            "parent_campaign_cv_digest": campaign_cv.content_digest,
+            "parent_final_selection_digest": final_selection.content_digest,
+            "parent_committee_digest": committee.content_digest,
+            "parent_committee_seeds": [member.seed for member in committee.members],
+            "config_before_sha256": before_sha,
+            "config_after_sha256": after_sha,
+            "registered_utc": _utc_now(),
+            "status": "registered",
+        }
+        extension["content_digest"] = digest({k: v for k, v in extension.items() if k != "content_digest"})
+        store.put_record(extension_key, extension)
+        _reopen_mlcv_authority_for_seed_extension(
+            store, extension_id=extension_id, parent_campaign=campaign
+        )
+        store.event(
+            "info", "extend-seed",
+            f"registered optimizer-seed extension {extension_id} from campaign {campaign.content_digest}",
+        )
+        _mark_stage(store, paths, "train", StageState.WAITING, f"seed extension {extension_id} requires new training jobs")
+        _mark_stage(store, paths, "evaluate", StageState.WAITING, f"seed extension {extension_id} requires AGG1/FINAL1 rebuild")
+        cfg, paths = _load_config(args.config)
+        method = _method_spec_by_mode(cfg, mode)
+    else:
+        if extension.get("schema") != SEED_EXTENSION_SCHEMA:
+            raise CampaignCliError(f"Stored seed-extension record is unsupported: {extension_key}.")
+        if int(extension.get("seed", -1)) != seed or str(extension.get("training_mode")) != mode or int(extension.get("selection_size", -1)) != selection_size:
+            raise CampaignCliError("Stored seed-extension identity does not match this invocation.")
+        if str(extension.get("status", "")).startswith("complete_"):
+            admitted = bool(extension.get("admitted_to_committee", False))
+            detail = "qualified committee member" if admitted else "completed but not qualified"
+            _ok(f"seed extension {extension_id} is already complete ({detail}); no work repeated")
+            return 0
+        forbidden = _seed_extension_forbidden_authority(store)
+        if forbidden:
+            raise CampaignCliError(
+                "An in-progress seed extension cannot resume after VERIFY1/production authority has begun. "
+                "Frozen records present: " + ", ".join(forbidden)
+            )
+        if seed not in method.seeds:
+            raise CampaignCliError(
+                "Seed-extension record exists but campaign.toml no longer contains the appended seed. "
+                "Restore the extension TOML or start a new campaign identity."
+            )
+        parent_seeds = tuple(int(value) for value in extension.get("parent_seeds", ()))
+        if bool(getattr(args, "dry_run", False)):
+            print(f"Seed extension {extension_id} is already registered; rerun without --dry-run to resume it.")
+            return 0
+
+    def update_extension_status(status: str, **extra: Any) -> None:
+        current = store.get_payload(extension_key)
+        payload = {**current, **extra, "status": status, "updated_utc": _utc_now()}
+        payload["content_digest"] = digest({k: v for k, v in payload.items() if k != "content_digest"})
+        store.put_record(extension_key, payload)
+
+    _print_header(f"Extend completed MLCV campaign: seed {seed}")
+    print(
+        f"Method={mode}; selection=n{selection_size}; folds={method.cross_validation_folds}; "
+        f"parent seeds={list(parent_seeds)}; new jobs={method.cross_validation_folds + 1}",
+        flush=True,
+    )
+
+    rc = command_doctor(argparse.Namespace(config=args.config))
+    if rc != 0:
+        update_extension_status("doctor_failed", return_code=rc)
+        return rc
+    update_extension_status("doctor_complete")
+
+    rc = command_prepare(argparse.Namespace(
+        config=args.config, approve_manifest=False, continue_after_approval=False,
+        refresh_inferences=False, rebuild_catalog=False, max_new_frames=None, max_new_domains=None,
+    ))
+    if rc != 0:
+        update_extension_status("prepare_incomplete", return_code=rc)
+        return rc
+    _assert_seed_extension_same_folds(
+        store, mode=mode, selection_size=selection_size, seed=seed, parent_seeds=parent_seeds
+    )
+    update_extension_status("prepare_complete_same_folds_authenticated")
+
+    rc = command_preflight(argparse.Namespace(config=args.config, check_only=False, run_smoke=False))
+    if rc != 0:
+        update_extension_status("preflight_incomplete", return_code=rc)
+        return rc
+    update_extension_status("preflight_complete")
+
+    rc = command_train(argparse.Namespace(
+        config=args.config, dry_run=False, run_id=None, max_runs=None,
+        training_mode=mode, seed=seed, selection_size=selection_size,
+    ))
+    if rc != 0:
+        update_extension_status("training_incomplete", return_code=rc)
+        return rc
+    update_extension_status("training_complete")
+
+    # Rebuild campaign-level AGG1/FINAL1 over the strict seed superset. Run-local
+    # SELECT1 and outer-fold records for the parent seeds are authenticated and
+    # reused; only the appended seed requires new checkpoint inference.
+    rc = command_evaluate(argparse.Namespace(
+        config=args.config, training_mode=None, seed=None, selection_size=None, require_complete=True
+    ))
+    if rc != 0:
+        update_extension_status("evaluation_incomplete", return_code=rc)
+        return rc
+
+    child_campaign = store.get_record("training_campaign", mdstats.TrainingCampaignPlan)
+    final_selection = store.get_record("mlcv_final_selection", mdstats.MlcvFinalSelectionRecord)
+    committee = store.get_record("mlcv_final_committee", mdstats.MlcvFinalCommitteeRecord)
+    admitted = seed in {member.seed for member in committee.members}
+    candidate = next((item for item in final_selection.candidates if int(item.seed) == seed), None)
+    update_extension_status(
+        "complete_qualified" if admitted else "complete_not_qualified",
+        child_campaign_plan_digest=child_campaign.content_digest,
+        child_final_selection_digest=final_selection.content_digest,
+        child_committee_digest=committee.content_digest,
+        admitted_to_committee=admitted,
+        final_candidate_outcome=(
+            None if candidate is None else ("qualified" if candidate.qualified else "rejected")
+        ),
+        final_candidate_rejection_reasons=(
+            [] if candidate is None else list(candidate.rejection_reasons)
+        ),
+        completed_utc=_utc_now(),
+    )
+    if admitted:
+        _ok(
+            f"seed {seed} qualified and was appended to FINAL1; committee now has "
+            f"{len(committee.members)} member(s)"
+        )
+    else:
+        _warn(
+            f"seed {seed} completed training/evaluation but did not qualify for FINAL1; "
+            f"committee remains at {len(committee.members)} member(s)"
+        )
+    return 0
+
+
+def command_guide(args: argparse.Namespace) -> int:
+    print(GUIDE_TEXT)
+    return 0
+
+
+def _checkpoint_metric_policy(cfg: Mapping[str, Any]) -> Any:
+    import mdstats
+    return mdstats.CheckpointMetricPolicy(
+        focus_atom_group_ids=("mobile_ions",),
+        focus_atomic_numbers=tuple(int(v) for v in _cfg(cfg, "profile", "mobile_atomic_numbers", (3, 11, 19))),
+        maximum_energy_mae_ev_per_atom=_optional_float(_cfg(cfg, "acceptance", "maximum_energy_mae_ev_per_atom")),
+        maximum_focus_force_rmse_ev_per_angstrom=_optional_float(_cfg(cfg, "acceptance", "maximum_focus_force_rmse_ev_per_angstrom")),
+        maximum_stress_rmse_ev_per_angstrom3=_optional_float(_cfg(cfg, "acceptance", "maximum_stress_rmse_ev_per_angstrom3")),
+        maximum_worst_condition_force_rmse_ev_per_angstrom=_optional_float(_cfg(cfg, "acceptance", "maximum_worst_condition_force_rmse_ev_per_angstrom")),
+        maximum_replay_degradation_fraction=(
+            None
+            if _training_policy_generation(cfg) == "train2"
+            else float(_cfg(cfg, "acceptance", "maximum_replay_degradation_fraction", 0.20))
+        ),
+    )
+
+
+def _optional_float(value: Any) -> float | None:
+    return None if value in (None, "", "none", "None") else float(value)
+
+
+def _optional_positive_float(value: Any) -> float | None:
+    parsed = _optional_float(value)
+    return None if parsed is None or parsed <= 0.0 else parsed
+
+
+def _config_template(
+    *,
+    workspace: str,
+    training_root: str,
+    foundation_model: str,
+    replay_set: str | None = None,
+    replay_train: str | None = None,
+    replay_monitor: str | None = None,
+    replay_true_labels: str | None = None,
+    foundation_family: str = "mace_mh_1",
+    foundation_head: str | None = None,
+    foundation_label: str | None = None,
+    acceleration_backend: str = "e3nn",
+    training_acceleration_backend: str = "cueq",
+    default_device: str = "cpu",
+    precision_profile: str = "single",
+) -> str:
+    precision = _precision_template(precision_profile)
+    family = str(foundation_family).strip().lower()
+    if family not in {"mace_mh_1", "mace_mpa_0"}:
+        raise CampaignCliError(
+            "_config_template foundation_family must be mace_mh_1 or mace_mpa_0 for a generated campaign."
+        )
+    resolved_head = str(foundation_head or ("omat_pbe" if family == "mace_mh_1" else "default")).strip()
+    if not resolved_head:
+        raise CampaignCliError("Generated campaign foundation head must be non-empty.")
+    label = str(foundation_label or ("MACE-MH-1" if family == "mace_mh_1" else "MPA-0-medium")).strip()
+    campaign_id = (
+        "lta-mh1-omat-pbe-finetune"
+        if family == "mace_mh_1" and resolved_head == "omat_pbe"
+        else "lta-mpa0-finetune"
+        if family == "mace_mpa_0" and resolved_head == "default"
+        else f"lta-{family.removeprefix('mace_').replace('_', '')}-{resolved_head.replace('_', '-')}-finetune"
+    )
+    legacy_evaluation_head = (
+        '# Historical MPA-0 compatibility selector; generalized campaigns omit this alias.\nreplay_baseline_head = ""\n'
+        if family == "mace_mpa_0"
+        else '# Source-foundation replay baseline head is canonical [foundation].head.\n'
+    )
+    legacy_pes_head = (
+        '# Historical MPA-0 compatibility selector; generalized campaigns omit this alias.\npes_foundation_head = ""\n'
+        if family == "mace_mpa_0"
+        else '# Source-foundation PES head is canonical [foundation].head.\n'
+    )
+    if replay_set not in (None, ""):
+        if any(value not in (None, "") for value in (replay_train, replay_monitor, replay_true_labels)):
+            raise CampaignCliError("_config_template cannot mix replay_set with legacy split replay paths.")
+        replay_paths_block = (
+            '# Single selected replay corpus, e.g. replay_fps_12000.extxyz produced by the\n'
+            '# replay_select_*.sh random+FPS workflow. mdstats owns qualification, the\n'
+            '# deterministic train/monitor split, pseudo-label generation, true-label views,\n'
+            '# and all reconstructable internal transport files.\n'
+            f'replay_set = "{replay_set}"'
+        )
+        replay_contract_block = (
+            '# REPLAY-UNIFY1: one external replay source. Foundation pseudo labels and source\n'
+            '# true labels are separate internal namespaces over the same frozen split.\n'
+            'label_mode = "foundation_pseudolabel"\n'
+            'split_ratio = "5:1"\n'
+            'split_seed = 42\n'
+            '# Foundation-pseudolabel qualification defaults inherited from the standalone\n'
+            '# replay preparation workflow. Threshold-only edits reuse cached predictions.\n'
+            'maximum_force_ev_per_angstrom = 20.0\n'
+            'force_component_rms_ev_per_angstrom = 5.0\n'
+            'maximum_abs_stress_ev_per_angstrom3 = 0.5\n'
+            'require_stress = false\n'
+            'prediction_batch_size = 32\n'
+            'prediction_shard_size = 256'
+        )
+    else:
+        # Internal compatibility factory used by historical tests/migrations.
+        # New user-facing `init` never selects this branch.
+        replay_train = replay_train or "/path/to/replay_train.extxyz"
+        replay_monitor = replay_monitor or "/path/to/replay_monitor.extxyz"
+        replay_true_labels = replay_true_labels or "/path/to/LTA_replay_true_labels"
+        replay_paths_block = (
+            f'replay_train = "{replay_train}"\n'
+            f'replay_monitor = "{replay_monitor}"\n'
+            '# Independent true labels for legacy replay retention/evaluation.\n'
+            f'replay_true_labels = "{replay_true_labels}"'
+        )
+        replay_contract_block = (
+            '# Legacy split-file replay interface retained for historical campaign compatibility.\n'
+            'mode = "external_pseudolabel"\n'
+            'seed = 42'
+        )
+    return f'''schema = "{CAMPAIGN_CLI_SCHEMA}"
+
+[campaign]
+id = "{campaign_id}"
+profile = "lta"
+precision_profile = "{precision['profile']}"
+workspace = "{workspace}"
+
+[foundation]
+# Canonical scientific source potential. The checkpoint itself is inspected in
+# later gates; filename/model labels are never authoritative for family or head.
+family = "{family}"
+head = "{resolved_head}"
+label = "{label}"
+
+[paths]
+training_root = "{training_root}"
+foundation_model = "{foundation_model}"
+{replay_paths_block}
+
+[data]
+dataset_id = "lta-dry-alkali-v1"
+manifest = "{DEFAULT_MANIFEST_NAME}"
+discovery_pattern = "**/*.xml"
+
+[manifest_inference]
+# Filename strain hints are candidates only. They are promoted after fixed-cell
+# XML controls and the exact LTA cell deformation pass these tolerances.
+fixed_cell_relative_tolerance = 1.0e-7
+reference_cell_relative_tolerance = 1.0e-7
+strain_matrix_absolute_tolerance = 5.0e-5
+strain_volume_ratio_tolerance = 5.0e-5
+maximum_rotation_radians = 1.0e-4
+conventional_axis_orthogonality_tolerance = 5.0e-6
+temperature_equality_tolerance_kelvin = 1.0e-6
+# hydro+5 / ortho-2 / shear+2 mean +5%, -2%, and +2%; decimal
+# forms such as hydro+0.05 retain their fractional interpretation.
+filename_values_at_or_above_one_are_percent = true
+
+[profile]
+profile_id = "dry-lta-alkali"
+framework_atomic_numbers = [8, 13, 14]
+mobile_atomic_numbers = [3, 11, 19]
+all_atomic_numbers = [3, 8, 11, 13, 14, 19]
+
+[partition]
+minimum_block_frames = 32
+purge_units_between_roles = 1
+
+[random]
+# Randomized PCA/range-finder seed used only when a DATA7 feature block is too
+# large for exact SVD. Exact-SVD paths are deterministic and ignore this seed.
+feature_projection_seed = 271828
+# ADAPT-MON1 deterministic random-start for balanced systematic online monitors.
+online_monitor_seed = 161803
+
+[model]
+# Compatibility/display label only. Scientific foundation identity is carried by
+# [foundation].family + [foundation].head and the inspected checkpoint identity.
+foundation_name = "{label}"
+device = "{default_device}"
+dtype = "{precision['model_dtype']}"
+# Completed frames append one recovery record immediately. This value controls
+# durable journal flushes, not full-history JSON rewrites. Use 1 for maximum
+# durability or a larger value for lower filesystem synchronization overhead.
+checkpoint_interval = 128
+# Persist descriptors/predictions in immutable multi-frame shards. Larger values
+# reduce inode and open/stat pressure; an abrupt interruption may recompute at
+# most one incomplete shard.
+artifact_shard_size = 128
+# Set a small positive value for a bounded first pass; 0 means finish the sweep.
+max_new_frames = 0
+# 0 chooses a VRAM-bounded automatic batch. CUDA OOM halves the batch and retries.
+inference_batch_size = 0
+maximum_inference_batch_size = 16
+estimated_inference_memory_mib_per_frame = 512.0
+# VRAM1 execution policy. Calibration uses the actual combined DATA6 workload,
+# stress-oriented frames, a fractional occupancy ceiling, and an absolute reserve.
+batch_calibration_stress_structures = 8
+vram_max_device_fraction = 0.80
+vram_reserve_gib = 4.0
+batch_throughput_tolerance_fraction = 0.05
+# PERF-P4 overlaps bounded artifact persistence with the next inference batch.
+# Queue depth is intentionally small so host-memory pressure remains explicit.
+pipeline_enabled = true
+persistence_queue_depth = 1
+
+[acceleration]
+# Revision 60 phase-separated default. Source inference, DATA6, pseudolabel
+# generation, checkpoint evaluation, and verification remain on authoritative
+# e3nn. TRAIN2 uses the portable pure-CuEq path by default and converts saved
+# checkpoints back to ordinary e3nn form.
+# Source/evaluation backend: e3nn remains the production default.
+backend = "{acceleration_backend}"
+# TRAIN2 backend: cueq is the generated default; set e3nn for a reference run.
+training_backend = "{training_acceleration_backend}"
+# Keep false so trained checkpoints remain portable e3nn artifacts.
+only_cueq = false
+# Fail instead of silently falling back if either requested backend is unavailable.
+require_available = true
+
+[selection]
+# One value is simplest. Multiple values build a learning curve.
+sizes = [512]
+# 0 auto-selects an economical outer thread count (up to 90% of available
+# CPUs, capped where these vectorized per-frame kernels stop scaling).
+structural_workers = 0
+
+[target_data.size_convergence]
+# TARGET-DATA2C fixed generic ladder plus TARGET-DATA2D successive-fidelity
+# authority. Coverage is hard admission only: every qualifying rung proceeds to
+# the common epoch-3 target-only screen. Epoch-3/10/30 evidence is supplied by
+# TRAIN2/EVAL2/VERIFY; legacy adaptive-stop runs cannot satisfy it.
+ladder_exponents = [7, 8, 9, 10, 11, 12, 13]
+minimum_materializable_rungs = 3
+reserve_required_strata = true
+reserve_correlation_intervals = true
+fps_tie_tolerance = 1.0e-12
+coverage_metric = "reference_mass_local_knn"
+coverage_threshold = 0.95
+coverage_resolution_mass = 0.0078125
+coverage_leave_one_out = true
+extent_quantile_alpha = 0.01
+extent_default_tolerance = "none"
+min_coverage_qualifiers = 3
+coarse_training_epochs = 3
+max_coarse_training_candidates = 4
+coarse_target_monitor_configurations = 256
+short_training_epochs = 10
+max_short_training_candidates = 2
+final_training_epochs = 30
+# Early practical equivalence is separately versioned/calibratable. Omit this
+# key to inherit practical_equivalence_mev_per_a.
+coarse_practical_equivalence_mev_per_a = 1.0
+practical_equivalence_mev_per_a = 1.0
+screening_optimizer_seed = 1
+
+[objective]
+energy_weight = 1.0
+forces_weight = 10.0
+stress_weight = 1.0
+
+[training]
+# TRAIN2A policy generation. Absence of this key in a historical campaign means
+# the immutable AdaptiveTrainingStopPolicy lifecycle that created that campaign;
+# it is never silently migrated. New campaigns use orthogonal TRAIN2/EVAL2
+# budget/LR/admissibility/selection authorities.
+policy_generation = "train2"
+# New campaigns default to multi-head replay fine-tuning only. Historical
+# modes/seeds configurations remain readable for restart compatibility; use the
+# explicit per-method tables below for new campaigns.
+device = "{default_device}"
+dtype = "{precision['training_dtype']}"
+learning_rate = 1.0e-4
+batch_size = 2
+valid_batch_size = 2
+# 0 chooses a CPU/RAM-bounded DataLoader worker count.
+num_workers = 0
+estimated_loader_memory_mib_per_worker = 256.0
+max_num_epochs = 30
+eval_interval = 1
+# ADAPT-MON1 fixed common online monitors. These are model-selection evidence only
+# and never supply gradients. Target frames are condition/trajectory/time balanced;
+# replay frames are selected from independent true-label replay evidence.
+online_target_monitor_configurations = 256
+online_replay_monitor_configurations = 512
+training_diagnostic_monitor_configurations = 256
+# TRAIN2B executes this frozen schedule once per optimizer update. Validation
+# never mutates the LR authority. The exact default is
+# 5% warm-up, 75% target adaptation, and 20% low-LR refinement.
+train2_warmup_end_fraction = 0.05
+train2_adaptation_end_fraction = 0.80
+train2_initial_lr_multiplier = 0.10
+train2_refinement_start_lr_multiplier = 0.10
+train2_final_lr_multiplier = 0.01
+target_head_weight = 5.0
+replay_head_weight = 1.0
+
+# ADAPT-PREC1: model precision is binary and controls learned-model arithmetic only.
+# mdstats-owned scientific reductions/statistics and persistent MD bookkeeping remain FP64.
+# There is intentionally no [training.precision] staged/refine schedule.
+
+[training.naive_fine_tuning]
+# Naive/native single-head fine-tuning is retained as an explicit comparison or
+# ablation option, but is disabled in newly initialized campaigns. Enable it
+# deliberately if a target-only baseline is scientifically useful.
+enabled = false
+# Default keeps the same CV partition across optimizer seeds so seed variance and
+# partition variance remain separately interpretable. Advanced robustness mode:
+# seed_mode = "optimizer_and_cv_partition"
+seed_mode = "optimizer_only"
+seeds = [1, 2]
+# Set to 0 to train only the final-development model for each seed; 1 is invalid.
+cross_validation_folds = 3
+# Keep this equal to the multi-head fold seed for paired comparisons when enabled.
+fold_partition_seed = 104729
+
+[training.multihead_replay]
+# Production default: two optimizer seeds, each with three cross-validation
+# folds plus one final-development fit: 2 * (3 + 1) = 8 multi-head jobs.
+# Shorten the seed array or set cross_validation_folds=0 only when intentionally
+# trading away seed/fold robustness for lower cost.
+enabled = true
+# optimizer_only is the scientific default. optimizer_and_cv_partition derives a
+# different deterministic fold partition for each optimizer seed; this broadens
+# CV robustness sampling but does NOT change final A+B+C training membership.
+seed_mode = "optimizer_only"
+seeds = [1, 2]
+# Set to 0 for final-only training; otherwise use K >= 2.
+cross_validation_folds = 3
+fold_partition_seed = 104729
+
+[runtime]
+# DATA8 is source-locked to this MACE interface. Change only after requalification.
+mace_version = "0.3.16"
+
+[performance]
+# Auto parallelism targets 90% of CPU threads and GPU/VRAM capacity. RAM remains
+# capped at 80% so the OS and unrelated programs retain baseline headroom.
+cpu_fraction = 0.90
+ram_fraction = 0.80
+gpu_memory_fraction = 0.90
+# 0 selects the automatic resource-bounded count. Explicit positive values are
+# still clipped by available CPU threads and the RAM budget.
+source_workers = 0
+feature_workers = 0
+# Exact TARGET-DATA2B/MVIDX1 cKDTree worker override. FEAS1-PERF3 uses
+# workers=1 inside each global queue task whenever global parallelism > 1; this
+# setting remains active for MVIDX1 and deliberately serial FEAS1 debugging.
+target_coverage_workers = 0
+# REPAIR-PAR1 immutable proposal workers. 0 uses the complete configured CPU
+# budget; repair-state mutation and winner application remain sequential.
+target_multi_view_repair_workers = 0
+# MVQUAL-PAR1 independent domain/selector/size scoring workers. 0 uses the
+# up to four configured CPU lanes automatically; nested cKDTree/BLAS workers are fixed at 1.
+# Set a larger explicit value only on a high-memory-bandwidth host after profiling.
+target_multi_view_qualification_workers = 0
+# 0 gives FEAS1 one single-level global worker for every CPU-budget lane
+# (normally 90% of logical threads). All domains/profiles feed the same queue.
+# Positive values cap that global pool. Execution only.
+target_coverage_feasibility_global_workers = 0
+# Compatibility aliases from PERF2/PERF1. Leave at 0 for new campaigns. If a
+# legacy alias is positive it must agree with the new global-worker setting.
+target_coverage_feasibility_block_workers = 0
+target_coverage_feasibility_family_workers = 0
+# Bounded cKDTree witness-query block. Scientific results are block invariant.
