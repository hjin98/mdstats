+    )
+    completed = len(result.checkpoint.completed_frame_uids)
+    requested = len(result.checkpoint.plan.requested_frame_uids)
+    _update_benchmark(
+        paths,
+        "prepare_model_sweep",
+        {
+            "wall_seconds": time.monotonic() - start,
+            "status": result.checkpoint.status.value,
+            "completed_frames": completed,
+            "requested_frames": requested,
+            "inference_batch_size": sweep_batch_size,
+            "batch_calibration_digest": calibration.content_digest,
+            "descriptor_signature_digest": calibration.descriptor_signature_digest,
+            "resource_budget": sweep_resources.summary(),
+        },
+    )
+    if result.complete:
+        _ok(f"foundation sweep complete ({completed}/{requested} frames)")
+        return result
+    _warn(f"foundation sweep incomplete ({completed}/{requested}); rerun `prepare` to resume")
+    return None
+
