+def _monitor_graph_memory_store(token: str, batch: Any, counts: np.ndarray) -> None:
+    global _MACE_MONITOR_GRAPH_CACHE_BYTES
+    if _MACE_MONITOR_GRAPH_CACHE_MAX_BYTES <= 0:
