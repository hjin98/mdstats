+            raise DensityNumericalInputError(
+                "selected_geometry exceeds max_logical_voxels."
+            )
+        if self.coarsest_geometry.logical_voxel_count > limit:
+            raise DensityNumericalInputError(
+                "coarsest_geometry exceeds max_logical_voxels."
+            )
+        resource_signature = _nonempty(
