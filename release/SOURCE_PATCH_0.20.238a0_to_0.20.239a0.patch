+def _current_train2_deploy_authority(
+    cfg: Mapping[str, Any],
+    *,
+    store: CampaignStore,
+    campaign: Any,
+    model_dtype: str,
+) -> Any | None:
+    """Return the live DEPLOY-VERIFY1 authority or ``None`` when it is stale."""
+
+    import mdstats
+    import shutil as _shutil
+
+    authority = store.get_record_optional("deploy_verify", mdstats.DeployVerifyCampaignRecord)
+    if authority is None:
+        return None
+    try:
+        convergence = _load_verified_target_size_convergence_authority(store)
+        stage_context, runs = _deploy_verify_candidate_runs(campaign, convergence)
+        expected = {run.content_digest for run in runs}
+        observed = {record.run_plan_digest for record in authority.run_records}
+        if (
+            authority.campaign_plan_digest != campaign.content_digest
+            or authority.target_size_convergence_digest != convergence.content_digest
+            or authority.stage_context != stage_context
+            or observed != expected
+        ):
+            return None
+        live_policy = _deploy_verify_policy(cfg, model_dtype=model_dtype)
+        if any(record.policy.policy_digest != live_policy.policy_digest for record in authority.run_records):
+            return None
+        executable_text = str(_cfg(cfg, "verification", "deployment_lammps_executable", "lmp"))
+        executable = Path(executable_text).expanduser()
+        if not executable.is_file():
+            resolved = _shutil.which(executable_text)
+            if resolved is None:
+                return None
+            executable = Path(resolved)
+        executable = executable.resolve()
+        live_exe_sha = _sha256(executable)
+        live_args = tuple(
+            str(v) for v in _cfg(
+                cfg,
+                "verification",
+                "deployment_lammps_arguments",
+                ("-k", "on", "g", "1", "-sf", "kk", "-pk", "kokkos", "newton", "on", "neigh", "half"),
+            )
+        )
+        for record in authority.run_records:
+            target = Path(record.target_only_model_path).resolve()
+            mliap = Path(record.mliap_artifact_path).resolve()
+            if (
+                not target.is_file()
+                or _sha256(target) != record.target_only_model_sha256
+                or not mliap.is_file()
+                or _sha256(mliap) != record.mliap_artifact_sha256
+                or record.lammps_run0.executable_sha256 != live_exe_sha
+                or tuple(record.lammps_run0.command_arguments) != live_args
+            ):
+                return None
+    except Exception:
+        return None
+    return authority
+
