+    @classmethod
+    def from_dict(cls, payload: Mapping[str, Any]) -> "FrameRegistrationResult":
+        if payload.get("schema") != FRAME_REGISTRATION_RESULT_SCHEMA:
+            raise RegistrationValidationError("Unsupported frame-registration result schema.")
