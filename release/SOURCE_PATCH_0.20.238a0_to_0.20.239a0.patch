+def _assert_seed_extension_same_folds(
+    store: CampaignStore, *, mode: str, selection_size: int, seed: int, parent_seeds: Sequence[int]
+) -> None:
+    """Require the appended optimizer seed to use exactly the existing MLCV role split."""
+
+    entries = {entry.variant_id: entry for entry in _current_data8_entries(store)}
+    new_id = f"{mode}-n{int(selection_size)}-seed{int(seed)}"
+    new_entry = entries.get(new_id)
+    if new_entry is None or getattr(new_entry.bundle, "mlcv_role_catalog", None) is None:
+        raise CampaignCliError(f"Seed extension did not materialize MLCV role evidence for {new_id}.")
+    siblings = []
+    for parent_seed in parent_seeds:
+        sibling_id = f"{mode}-n{int(selection_size)}-seed{int(parent_seed)}"
+        sibling = entries.get(sibling_id)
+        if sibling is not None and getattr(sibling.bundle, "mlcv_role_catalog", None) is not None:
+            siblings.append(sibling)
+    if not siblings:
+        raise CampaignCliError("Seed extension cannot authenticate an existing sibling fold plan.")
+    expected = siblings[0].bundle.mlcv_role_catalog.content_digest
+    if any(item.bundle.mlcv_role_catalog.content_digest != expected for item in siblings):
+        raise CampaignCliError("Existing seed variants do not share one MLCV fold-role catalog.")
+    observed = new_entry.bundle.mlcv_role_catalog.content_digest
+    if observed != expected:
+        raise CampaignCliError(
+            "Seed extension violated the same-fold requirement: the new seed has a different "
+            "MLCV role-catalog digest. Refusing training so optimizer-seed variance remains "
+            "separate from partition variance."
+        )
+
+
+def _variant_specs(
+    cfg: Mapping[str, Any], *, selection_sizes: Sequence[int] | None = None
+) -> tuple[_VariantSpec, ...]:
+    sizes = tuple(int(value) for value in (selection_sizes if selection_sizes is not None else _cfg(cfg, "selection", "sizes", (512,))))
+    if not sizes or len(set(sizes)) != len(sizes) or any(value <= 0 for value in sizes):
+        raise CampaignCliError("[selection].sizes must contain unique positive integers.")
+    variants: list[_VariantSpec] = []
+    for method in _training_method_specs(cfg):
+        for size in sizes:
+            for seed in method.seeds:
+                fold_seed = method.fold_partition_seed
+                if method.seed_mode == "optimizer_and_cv_partition":
+                    # Stable, platform-independent seed mixing.  It changes only
+                    # the CV partition plan; the final-development domain remains
+                    # the same complete development set for every optimizer seed.
+                    fold_seed = int(digest({
+                        "schema": "mdstats.mlcv-per-seed-fold-partition.v1",
+                        "base_fold_partition_seed": method.fold_partition_seed,
+                        "optimizer_seed": seed,
+                    })[:8], 16)
+                variants.append(_VariantSpec(
+                    mode=method.mode,
+                    selection_size=size,
+                    seed=seed,
+                    cross_validation_folds=method.cross_validation_folds,
+                    fold_partition_seed=fold_seed,
+                ))
+    return tuple(variants)
+
