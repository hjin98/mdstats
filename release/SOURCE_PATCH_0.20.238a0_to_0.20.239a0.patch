+def _coerce_generation(
+    value: TrajectoryGenerationIdentity | None,
+    *,
+    collection_identity: ObservableCollectionIdentity,
+) -> TrajectoryGenerationIdentity | None:
+    if value is None:
+        return None
+    value.verify_output(collection_identity)
+    return value
