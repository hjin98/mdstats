+        )
+    except Exception as exc:
+        print(
+            f"[DATA6 restart] compact checkpoint is not directly reusable ({exc}); "
+            "entering verified recovery",
+            flush=True,
+        )
+    signature_hint = (
+        None
+        if restored is None
+        else getattr(restored.checkpoint.plan, "descriptor_signature", None)
+    )
