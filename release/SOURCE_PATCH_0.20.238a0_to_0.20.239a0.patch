+SEED_EXTENSION_SCHEMA = "mdstats.mlff-campaign-seed-extension.v1"
+SEED_EXTENSION_ARCHIVE_SCHEMA = "mdstats.mlff-campaign-seed-extension-archive.v1"
+
+
+def _seed_extension_key(mode: str, selection_size: int, seed: int) -> str:
+    return f"seed_extension:{mode}:n{int(selection_size)}:seed{int(seed)}"
+
+
+def _method_spec_by_mode(cfg: Mapping[str, Any], mode: str) -> _TrainingMethodSpec:
+    matches = tuple(item for item in _training_method_specs(cfg) if item.mode == str(mode))
+    if len(matches) != 1:
+        raise CampaignCliError(f"Training method {mode!r} is not uniquely enabled in campaign.toml.")
+    return matches[0]
+
+
+def _replace_method_seed_array(
+    config_path: Path, *, mode: str, expected_existing: Sequence[int], new_seed: int
+) -> tuple[str, str]:
+    """Append one seed to a generated nested training-method table, preserving TOML comments."""
+
+    text = config_path.read_text(encoding="utf-8")
+    before_sha = _sha256(config_path)
+    section = f"[training.{mode}]"
+    start = text.find(section)
+    if start < 0:
+        raise CampaignCliError(
+            "Seed extension requires the explicit nested training-method tables used by current "
+            f"campaigns; {section} is absent. Migrate the TOML before extending this campaign."
+        )
+    end_match = re.search(r"(?m)^\[[^\n]+\]\s*$", text[start + len(section):])
+    end = len(text) if end_match is None else start + len(section) + end_match.start()
+    block = text[start:end]
+    matches = list(re.finditer(r"(?m)^(?P<indent>\s*)seeds\s*=\s*\[(?P<body>[^\]]*)\](?P<tail>\s*(?:#.*)?)$", block))
+    if len(matches) != 1:
+        raise CampaignCliError(f"{section} must contain exactly one simple `seeds = [...]` assignment.")
+    observed = tuple(int(value) for value in re.findall(r"-?\d+", matches[0].group("body")))
+    expected = tuple(int(value) for value in expected_existing)
+    if observed != expected:
+        raise CampaignCliError(
+            f"{section}.seeds changed while seed extension was being prepared: "
+            f"parsed {observed}, expected {expected}."
+        )
+    if int(new_seed) in observed:
+        return before_sha, before_sha
+    updated = tuple((*observed, int(new_seed)))
+    replacement = (
+        f"{matches[0].group('indent')}seeds = ["
+        + ", ".join(str(value) for value in updated)
+        + "]"
+        + matches[0].group("tail")
+    )
+    block = block[:matches[0].start()] + replacement + block[matches[0].end():]
+    new_text = text[:start] + block + text[end:]
+    temporary = config_path.with_suffix(config_path.suffix + ".seed-extension.tmp")
+    temporary.write_text(new_text, encoding="utf-8")
+    os.replace(temporary, config_path)
+    try:
+        with config_path.open("rb") as handle:
+            parsed = tomllib.load(handle)
+        parsed_method = _method_spec_by_mode(parsed, mode)
+        if parsed_method.seeds != updated:
+            raise CampaignCliError(
+                f"Seed extension wrote {section}, but TOML reparse produced seeds={parsed_method.seeds}."
+            )
+    except Exception:
+        # The original bytes are deliberately not reconstructed here; the atomic write
+        # either produced valid TOML or the explicit validation failure stops the command.
+        raise
+    return before_sha, _sha256(config_path)
+
