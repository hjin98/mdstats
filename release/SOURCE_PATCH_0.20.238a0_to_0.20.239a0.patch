+def _owner_for_samples(frac: np.ndarray, owner: np.ndarray) -> np.ndarray:
+    shape=np.asarray(owner.shape); idx=np.mod(np.rint(np.mod(frac,1.0)*shape).astype(int),shape)
+    return owner[idx[:,0],idx[:,1],idx[:,2]]
+
