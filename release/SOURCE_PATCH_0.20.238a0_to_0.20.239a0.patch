+    @classmethod
+    def from_dict(cls, payload: Mapping[str, Any]) -> "RawFrameFeatureRecord":
+        if payload.get("schema") != RAW_FRAME_FEATURE_SCHEMA:
+            raise TrainingDataSerializationError("Unsupported raw-frame-feature schema.")
