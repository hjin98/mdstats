+        metadata = self.metadata.to_json_dict()
+        scientific_metadata = {
+            key: value
+            for key, value in metadata.items()
+            if key
+            not in {
+                "backend", "total_stored_values", "total_dense_voxels",
+                "total_nonzero_node_upper", "total_stencil_values",
