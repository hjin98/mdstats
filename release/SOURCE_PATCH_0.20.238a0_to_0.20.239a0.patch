+@dataclass(frozen=True, slots=True)
+class LtaFrameSelectionDescriptor:
+    frame_uid: str
+    frame_record_digest: str
+    policy_digest: str
+    named_features: tuple[tuple[str, float], ...]
+    missing_mask: tuple[bool, ...]
