+    def from_dict(cls, payload: Mapping[str, Any]) -> "PrimitiveRingKey":
+        return cls(
+            edge_tokens=tuple(
+                PrimitiveRingEdgeToken.from_dict(x) for x in payload["edge_tokens"]
+            )
+        )
