+def _evaluation_acceleration_binding(cfg: Mapping[str, Any], paths: CampaignPaths) -> dict[str, Any]:
+    """Bind the doctor-frozen inference realization for generalized campaigns.
+
+    Pre-MH1 campaigns did not persist an acceleration realization.  Their
+    configuration is either head-blind or normalized with
+    ``legacy_normalized=true`` and must remain evaluable under the historical
+    acceleration-policy semantics.  New canonical ``[foundation]`` campaigns
+    fail closed if the realization is absent or unqualified.
+    """
+
+    foundation = cfg.get("foundation")
+    if not isinstance(foundation, Mapping) or bool(foundation.get("legacy_normalized", False)):
+        return {}
+    realization = _stored_acceleration_realization(cfg, paths, require_qualified=True)
+    assert realization is not None
+    return {
+        "acceleration_realization_digest": realization.content_digest,
+        "resolved_acceleration_kernel_mode": realization.resolved_kernel_mode,
+    }
+
