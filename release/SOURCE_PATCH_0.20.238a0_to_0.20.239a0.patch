+def _print_production_gate_diagnostics(frames: Any, qualification: Any) -> None:
+    if "unresolved_frame_strain" in qualification.blockers:
+        frame_by_uid = {item.frame_uid: item for item in frames.frames}
+        counts: dict[str, int] = {}
+        for item in frames.strain_records:
+            if item.tensor_class.value == "unresolved":
+                run_id = frame_by_uid[item.frame_uid].run_id
+                counts[run_id] = counts.get(run_id, 0) + 1
+        print("Unresolved strain frames by run:", flush=True)
+        for run_id, count in sorted(counts.items()):
+            resolution = frames.reference_cell_catalog.resolution_for_run(run_id)
+            reason = "; ".join(resolution.reasons) or "frame-level strain reconstruction failed"
+            print(f"  - {run_id}: {count:,} frame(s); {reason}", flush=True)
+    if "profile_extension_coverage_not_materialized" in qualification.blockers:
+        print(
+            "Profile-extension evidence exists in DATA4/DATA6 but the selected DATA7 coverage "
+            "classes are absent. This release invalidates and rebuilds affected DATA7 coverage artifacts.",
+            flush=True,
+        )
