+            object.__setattr__(self, "spread_sample_size", resolution.spread_sample_size)
+            object.__setattr__(self, "spread_sample_seed", resolution.spread_sample_seed)
+            object.__setattr__(
+                self,
+                "spread_sampling_strategy",
