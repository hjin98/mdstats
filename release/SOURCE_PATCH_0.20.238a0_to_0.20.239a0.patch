+def _path_cache_identity(path: Path, expected_sha256: str) -> tuple[str, int, int, int, str]:
+    resolved = path.resolve()
+    stat = resolved.stat()
+    return (
+        str(resolved),
+        int(stat.st_size),
+        int(stat.st_mtime_ns),
+        int(getattr(stat, "st_ino", 0)),
+        validate_digest(expected_sha256, name="monitor_sha256"),
+    )
