+        volume = Fraction(self.fractional_volume)
+        if volume <= 0:
+            raise LtaNaturalTilingInputError("fractional_volume must be positive.")
+        point = tuple(Fraction(value) for value in self.strict_interior_point)
+        if len(point) != 3:
