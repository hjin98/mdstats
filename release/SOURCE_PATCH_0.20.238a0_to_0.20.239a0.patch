+IntArray = NDArray[np.int64]
+
+DENSITY_DIRECT_REALIZATION_LIMITS_SCHEMA = (
+    "mdstats.density-direct-realization-limits.v2"
+)
+DENSITY_DIRECT_REALIZATION_PLAN_SCHEMA = "mdstats.density-direct-realization-plan.v1"
