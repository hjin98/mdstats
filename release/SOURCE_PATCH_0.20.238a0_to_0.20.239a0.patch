+            raise TrainingDataInputError("MLCV-AGG1 requires all configured folds to survive.")
+        if self.dispersion_gate_enabled:
+            raise TrainingDataInputError("MLCV-AGG1 keeps cross-fold dispersion diagnostic-only.")
+
