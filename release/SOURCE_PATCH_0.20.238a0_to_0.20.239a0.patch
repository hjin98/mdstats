+def _evaluation_foundation_binding(cfg: Mapping[str, Any], paths: CampaignPaths) -> dict[str, Any]:
+    """Bind canonical source-foundation authority for evaluation baselines.
+
+    Legacy MPA-0 configurations preserve the historical head-only selector.
+    New generalized campaigns bind the inspected scientific foundation and the
+    exact doctor-frozen inference realization; no independent source-head knob
+    remains in the evaluation policy.
+    """
+
+    import mdstats
+
+    foundation = cfg.get("foundation")
+    acceleration_binding = _evaluation_acceleration_binding(cfg, paths)
+    if not isinstance(foundation, Mapping) or bool(foundation.get("legacy_normalized", False)):
+        return {
+            "replay_baseline_head_name": _canonical_foundation_head(cfg),
+            **acceleration_binding,
+        }
+    potential = _resolved_foundation_potential_identity(cfg, paths)
+    realization = _stored_acceleration_realization(cfg, paths, require_qualified=True)
+    assert realization is not None
+    inference = _foundation_inference_identity(
+        cfg,
+        potential,
+        adapter_version=mdstats.MACE_ADAPTER_VERSION,
+        resolved_kernel_mode=realization.resolved_kernel_mode,
+    )
+    if realization.foundation_inference_identity_digest != inference.content_digest:
+        raise CampaignCliError(
+            "Evaluation foundation inference identity disagrees with the doctor-frozen acceleration realization."
+        )
+    return {
+        "replay_baseline_head_name": None,
+        "foundation_potential_identity": potential,
+        "foundation_inference_identity": inference,
+        **acceleration_binding,
+    }
