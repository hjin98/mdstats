+def _data6_bundle_matches_live_inputs(
+    data6: Any,
+    *,
+    sources: Any,
+    frames: Any,
+    data4: Any,
+    data5: Any,
+    sweep: Any,
+    policy: Any,
+) -> bool:
+    """Return whether finalized DATA6 can be reused byte-for-byte.
+
+    The check covers scientific lineage and policy identities.  Sidecars remain
+    authenticated lazily by their consumers; this avoids a second all-file scan
+    immediately after a completed sweep.
+    """
+
+    descriptor_digest = (
+        None
+        if sweep.descriptor_manifest is None
+        else sweep.descriptor_manifest.content_digest
+    )
+    prediction_digest = (
+        None
+        if sweep.prediction_manifest is None
+        else sweep.prediction_manifest.content_digest
+    )
+    return bool(
+        data6.source_catalog_digest == sources.content_digest
+        and data6.frame_catalog_digest == frames.content_digest
+        and data6.data4_bundle_digest == data4.content_digest
+        and data6.data5_bundle_digest == data5.content_digest
+        and data6.policy.policy_digest == policy.policy_digest
+        and data6.model_sweep_plan is not None
+        and data6.model_sweep_plan.content_digest
+        == sweep.checkpoint.plan.content_digest
+        and data6.model_sweep_checkpoint_digest
+        == sweep.checkpoint.content_digest
+        and data6.checkpoint_identity is not None
+        and data6.checkpoint_identity.content_digest
+        == sweep.checkpoint.plan.checkpoint_identity.content_digest
+        and (
+            None
+            if data6.mace_descriptor_manifest is None
+            else data6.mace_descriptor_manifest.content_digest
+        )
+        == descriptor_digest
+        and (
+            None
+            if data6.prediction_manifest is None
+            else data6.prediction_manifest.content_digest
+        )
+        == prediction_digest
+    )
+
