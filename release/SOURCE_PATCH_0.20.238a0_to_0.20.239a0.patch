+    @staticmethod
+    def _hash_identity_payload(payload: Mapping[str, Any]) -> str:
+        encoded = json.dumps(payload, sort_keys=True, separators=(",", ":"), allow_nan=False)
+        return hashlib.sha256(encoded.encode("ascii")).hexdigest()
