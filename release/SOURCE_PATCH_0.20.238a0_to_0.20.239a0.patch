+DEFAULT_MAX_DIRECT_TARGET_BLOCKS = 2_000_000
+DEFAULT_MAX_DIRECT_TARGET_NODES = 20_000_000
+DEFAULT_MAX_DIRECT_CANDIDATE_PAIRS = 500_000_000
+DEFAULT_MAX_DIRECT_EXACT_CONTRIBUTIONS = 500_000_000
