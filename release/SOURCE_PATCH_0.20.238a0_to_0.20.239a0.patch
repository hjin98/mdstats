@@ -0,0 +1,46 @@
+"""Provenance records for normalized atomistic frame collections."""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import Literal
+
+
+SourceFormat = Literal[
+    "vasp-vasprun-xml",
+    "vasp-xdatcar",
