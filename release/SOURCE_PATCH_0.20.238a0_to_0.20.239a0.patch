+def _deploy_verify_candidate_runs(campaign: Any, convergence: Any) -> tuple[str, tuple[Any, ...]]:
+    import mdstats
+
+    if convergence.outcome == "awaiting_stage_c_full_training":
+        sizes = set(int(v) for v in convergence.stage_b_finalist_sizes)
+        seed = int(convergence.policy.screening_optimizer_seed)
+        runs = tuple(
+            sorted(
+                (
+                    run for run in campaign.runs
+                    if run.kind is mdstats.MaceJobKind.FINAL_DEVELOPMENT
+                    and run.seed == seed
+                    and run.selection_size in sizes
+                ),
+                key=lambda run: (run.selection_size, run.seed, run.run_id),
+            )
+        )
+        if {run.selection_size for run in runs} != sizes:
+            raise CampaignCliError(
+                "DEPLOY-VERIFY1 cannot resolve both TARGET-DATA2D Stage-C final-development finalists."
+            )
+        return "target_size_stage_c", runs
+    if convergence.outcome == "selected":
+        selected_size = int(convergence.selected_target_size)
+        runs = tuple(
+            sorted(
+                (
+                    run for run in campaign.runs
+                    if run.kind is mdstats.MaceJobKind.FINAL_DEVELOPMENT
+                    and run.selection_size == selected_size
+                ),
+                key=lambda run: (run.seed, run.run_id),
+            )
+        )
+        if not runs:
+            raise CampaignCliError("DEPLOY-VERIFY1 found no selected-size final-development candidates.")
+        return "production", runs
+    raise CampaignCliError(
+        "DEPLOY-VERIFY1 requires completed EVAL2 static evidence for Stage C or a frozen production target size; "
+        f"TARGET-DATA2D outcome is {convergence.outcome!r}."
+    )
+
+
+def _deploy_verify_record_is_current(
+    record: Any,
+    *,
+    run: Any,
+    eval2_record: Any,
+    policy: Any,
+    probe_set: Any,
+    require_target_deployment_identity: bool = False,
+) -> bool:
+    try:
+        if require_target_deployment_identity and getattr(record, "target_head_deployment_identity", None) is None:
+            return False
+        if (
+            record.run_plan_digest != run.content_digest
+            or record.eval2_run_record_digest != eval2_record.content_digest
+            or record.policy.policy_digest != policy.policy_digest
+            or record.probe_set.content_digest != probe_set.content_digest
+            or record.selected_checkpoint_sha256 != eval2_record.selected_checkpoint_sha256
+            or record.selected_checkpoint_epoch != eval2_record.selected_checkpoint_epoch
+        ):
+            return False
+        target = Path(record.target_only_model_path).resolve()
+        mliap = Path(record.mliap_artifact_path).resolve()
+        executable = Path(record.lammps_run0.executable_path).resolve()
+        return bool(
+            target.is_file()
+            and mliap.is_file()
+            and executable.is_file()
+            and _sha256(target) == record.target_only_model_sha256
+            and _sha256(mliap) == record.mliap_artifact_sha256
+            and _sha256(executable) == record.lammps_run0.executable_sha256
+            and record.passed
+        )
+    except Exception:
+        return False
+
