+def _dyn_stage_c_training_evidence(
+    *,
+    cfg: Mapping[str, Any],
+    paths: CampaignPaths,
+    store: CampaignStore,
+    campaign: Any,
+    convergence: Any,
+    deploy: Any,
+    dyn: Any,
+) -> tuple[Any, ...]:
+    """Bind completed DEPLOY/PES/RELAX/DYN qualification into TARGET-DATA2D Stage C."""
+
+    import mdstats
+
+    pes = store.get_record("pes_verify", mdstats.PESVerifyCampaignRecord)
+    relax = store.get_record("relax_verify", mdstats.RelaxVerifyCampaignRecord)
+    entries = _current_data8_entries(store)
+    jobs = _job_lookup(entries)
+    executions = _available_successful_executions(cfg, paths, store, campaign, jobs)
+    screening_seed = int(convergence.policy.screening_optimizer_seed)
+    expected_sizes = set(int(v) for v in convergence.stage_b_finalist_sizes)
+    runs = [
+        run for run in campaign.runs
+        if run.kind is mdstats.MaceJobKind.FINAL_DEVELOPMENT
+        and run.seed == screening_seed and run.selection_size in expected_sizes
+    ]
+    if {run.selection_size for run in runs} != expected_sizes:
+        raise CampaignCliError("DYN-VERIFY2 cannot resolve both TARGET-DATA2D Stage-C finalist runs.")
+    deploy_by_run = {v.run_plan_digest: v for v in deploy.run_records}
+    pes_by_run = {v.run_plan_digest: v for v in pes.run_records}
+    relax_by_run = {v.run_plan_digest: v for v in relax.run_records}
+    dyn_by_run = {v.run_plan_digest: v for v in dyn.run_records}
+    short_by_size = {v.target_size: v for v in convergence.short_training_evidence}
+    evidence = []
+    for run in sorted(runs, key=lambda value: value.selection_size):
+        bundle, job, root = jobs[run.mace_job_artifact_digest]
+        execution = executions.get(run.content_digest)
+        if execution is None:
+            raise CampaignCliError(f"DYN-VERIFY2 Stage-C run {run.run_id} lost its successful TRAIN2 execution.")
+        runtime = store.get_record_optional(f"train2_runtime:{run.run_id}", mdstats.Train2RuntimeSummary)
+        if runtime is None:
+            runtime = mdstats.load_train2_runtime_summary(paths.runs / run.run_id / "checkpoints")
+        eval_record = store.get_record(f"eval2_run:{run.run_id}", mdstats.Eval2RunRecord)
+        selected = eval_record.selected_checkpoint
+        if selected is None:
+            raise CampaignCliError(f"DYN-VERIFY2 Stage-C run {run.run_id} lacks a selected EVAL2 checkpoint.")
+        admission = job.protocol.checkpoint_admissibility_policy
+        if admission is None:
+            raise CampaignCliError("DYN-VERIFY2 Stage-C run lacks TRAIN2 admissibility policy.")
+        target_pass = selected.target_metrics.force_component_rmse_ev_per_angstrom <= admission.maximum_target_force_rmse_ev_per_angstrom
+        if admission.replay_enabled:
+            replay_pass = bool(
+                selected.replay_degradation_ev_per_angstrom is not None
+                and selected.replay_label_mode == admission.replay_label_requirement
+                and selected.replay_degradation_ev_per_angstrom <= float(admission.replay_degradation_budget_ev_per_angstrom)
+            )
+        else:
+            replay_pass = True
+        deploy_record = deploy_by_run.get(run.content_digest)
+        pes_record = pes_by_run.get(run.content_digest)
+        relax_record = relax_by_run.get(run.content_digest)
+        dyn_record = dyn_by_run.get(run.content_digest)
+        physical_pass = bool(
+            deploy_record is not None and deploy_record.passed
+            and pes_record is not None and pes_record.passed
+            and relax_record is not None and relax_record.passed
+            and dyn_record is not None and dyn_record.passed
+        )
+        physical_digest = digest({
+            "schema": "mdstats.train2-physical-qualification-chain.v1",
+            "run_plan_digest": run.content_digest,
+            "deploy_verify_run_digest": None if deploy_record is None else deploy_record.content_digest,
+            "pes_verify_run_digest": None if pes_record is None else pes_record.content_digest,
+            "relax_verify_run_digest": None if relax_record is None else relax_record.content_digest,
+            "dyn_verify_run_digest": None if dyn_record is None else dyn_record.content_digest,
+            "passed": physical_pass,
+        })
+        parent = short_by_size.get(run.selection_size)
+        if parent is None:
+            raise CampaignCliError(f"DYN-VERIFY2 Stage-C run n={run.selection_size} lost its Stage-B continuation parent.")
+        wall_time = sum(float(attempt.elapsed_seconds) for attempt in execution.attempts)
+        failure_reasons = list(selected.rejection_reasons)
+        if not physical_pass:
+            failure_reasons.append("physical_qualification_failed")
+        evidence.append(mdstats.TargetSizeTrainingEvidence(
+            stage="final", target_size=run.selection_size, optimizer_seed=run.seed,
+            completed_epochs=runtime.completed_epochs, planned_epochs=runtime.planned_epochs,
+            optimizer_update_count=runtime.completed_updates, structures_presented=runtime.structures_presented,
+            normalized_schedule_progress=runtime.normalized_progress,
+            instantaneous_learning_rate=runtime.instantaneous_learning_rate, wall_time_seconds=wall_time,
+            target_force_score_mev_per_a=selected.target_metrics.force_component_rmse_ev_per_angstrom * 1000.0,
+            numerical_valid=True, target_hard_gates_passed=target_pass,
+            foundation_identity_digest=job.protocol.foundation_checkpoint.canonical_content_digest,
+            evaluation_role_digest=selected.target_metrics.target_role_digest,
+            training_policy_digest=_train2_policy_set_digest(job.protocol), training_run_digest=run.content_digest,
+            checkpoint_digest=selected.trajectory_point.checkpoint_sha256,
+            schedule_digest=job.protocol.learning_rate_schedule_policy.policy_digest,
+            optimizer_state_digest=runtime.optimizer_state_digest,
+            rng_state_digest=runtime.rng_state_digest,
+            target_evaluation_digest=selected.target_metrics.content_digest,
+            replay_diagnostic_force_rmse_mev_per_a=(
+                None if selected.replay_candidate_force_rmse_ev_per_angstrom is None
+                else selected.replay_candidate_force_rmse_ev_per_angstrom * 1000.0
+            ),
+            replay_evaluation_digest=selected.evaluation_record_digest,
+            replay_admissible=replay_pass,
+            physical_qualification_passed=physical_pass,
+            physical_qualification_digest=physical_digest,
+            parent_checkpoint_digest=parent.checkpoint_digest,
+            parent_optimizer_state_digest=parent.optimizer_state_digest,
+            parent_rng_state_digest=parent.rng_state_digest,
+            failure_reasons=tuple(failure_reasons),
+        ))
+    return tuple(evidence)
+
+
+def _select2_candidate_records(
+    *,
+    store: CampaignStore,
+    campaign: Any,
+    convergence: Any,
+    deploy: Any,
+    dyn: Any,
+) -> tuple[Any, Any]:
+    """Reconstruct production final-development seed representatives and one shared policy."""
+
+    import mdstats
+
+    if convergence.outcome != "selected" or convergence.selected_target_size is None:
+        raise CampaignCliError("SELECT2 requires a frozen TARGET-DATA2D production target size.")
+    if dyn.stage_context != "production":
+        raise CampaignCliError("SELECT2 may only consume production-context DYN-VERIFY2 evidence.")
+    decision = store.get_record("target_production_corpus_decision", mdstats.TargetProductionCorpusDecision)
+    if decision.selected_target_size != int(convergence.selected_target_size):
+        raise CampaignCliError("SELECT2 target-production-corpus decision disagrees with TARGET-DATA2D.")
+    pes = store.get_record("pes_verify", mdstats.PESVerifyCampaignRecord)
+    relax = store.get_record("relax_verify", mdstats.RelaxVerifyCampaignRecord)
+    if not (
+        deploy.campaign_plan_digest == pes.campaign_plan_digest == relax.campaign_plan_digest
+        == dyn.campaign_plan_digest == campaign.content_digest
+    ):
+        raise CampaignCliError("SELECT2 physical qualification campaign lineage mismatch.")
+    if not (
+        pes.deploy_verify_campaign_digest == deploy.content_digest
+        and relax.pes_verify_campaign_digest == pes.content_digest
+        and dyn.relax_verify_campaign_digest == relax.content_digest
+        and dyn.deploy_verify_campaign_digest == deploy.content_digest
+    ):
+        raise CampaignCliError("SELECT2 physical qualification chain is stale or incomplete.")
+
+    selected_size = int(convergence.selected_target_size)
+    runs = tuple(sorted(
+        (
+            run for run in campaign.runs
+            if run.kind is mdstats.MaceJobKind.FINAL_DEVELOPMENT
+            and run.selection_size == selected_size
+        ),
+        key=lambda run: (run.seed, run.run_id),
+    ))
+    if not runs:
+        raise CampaignCliError("SELECT2 found no selected-size final-development production seeds.")
+
+    entries = _current_data8_entries(store)
+    jobs = _job_lookup(entries)
+    deploy_by_run = {v.run_plan_digest: v for v in deploy.run_records}
+    pes_by_run = {v.run_plan_digest: v for v in pes.run_records}
+    relax_by_run = {v.run_plan_digest: v for v in relax.run_records}
+    dyn_by_run = {v.run_plan_digest: v for v in dyn.run_records}
+    policies: dict[str, Any] = {}
+    candidates = []
+    target_role_digests: set[str] = set()
+    for run in runs:
+        try:
+            _bundle, job, _root = jobs[run.mace_job_artifact_digest]
+        except KeyError as exc:
+            raise CampaignCliError(f"SELECT2 lost DATA8 job lineage for {run.run_id}.") from exc
+        policy = job.protocol.checkpoint_selection_policy
+        if policy is None:
+            raise CampaignCliError(f"SELECT2 run {run.run_id} lacks CheckpointSelectionPolicy authority.")
+        policies[policy.policy_digest] = policy
+        eval_record = store.get_record(f"eval2_run:{run.run_id}", mdstats.Eval2RunRecord)
+        selected = eval_record.selected_checkpoint
+        if eval_record.outcome != "selected" or selected is None:
+            raise CampaignCliError(f"SELECT2 run {run.run_id} lacks one admissible EVAL2 representative.")
+        target_role_digests.add(selected.target_metrics.target_role_digest)
+
+        deploy_record = deploy_by_run.get(run.content_digest)
+        pes_record = pes_by_run.get(run.content_digest)
+        relax_record = relax_by_run.get(run.content_digest)
+        dyn_record = dyn_by_run.get(run.content_digest)
+        reasons = []
+        if deploy_record is None or not deploy_record.passed:
+            reasons.append("deployment_parity_failed")
+        if pes_record is None or not pes_record.passed:
+            reasons.append("pes_qualification_failed")
+        if relax_record is None or not relax_record.passed:
+            reasons.append("relax_qualification_failed")
+        if dyn_record is None or not dyn_record.passed:
+            reasons.append("dynamics_qualification_failed")
+        physical = not reasons
+        candidates.append(mdstats.Select2CandidateRecord(
+            run_plan_digest=run.content_digest,
+            run_id=run.run_id,
+            optimizer_seed=run.seed,
+            eval2_run_record_digest=eval_record.content_digest,
+            selected_checkpoint=selected,
+            deploy_verify_run_digest=None if deploy_record is None else deploy_record.content_digest,
+            pes_verify_run_digest=None if pes_record is None else pes_record.content_digest,
+            relax_verify_run_digest=None if relax_record is None else relax_record.content_digest,
+            dyn_verify_run_digest=None if dyn_record is None else dyn_record.content_digest,
+            physical_qualified=physical,
+            failure_reasons=tuple(reasons),
+            target_only_model_path=None if deploy_record is None else deploy_record.target_only_model_path,
+            target_only_model_sha256=None if deploy_record is None else deploy_record.target_only_model_sha256,
+            mliap_artifact_path=None if deploy_record is None else deploy_record.mliap_artifact_path,
+            mliap_artifact_sha256=None if deploy_record is None else deploy_record.mliap_artifact_sha256,
+        ))
+    if len(policies) != 1:
+        raise CampaignCliError("SELECT2 final-development seeds do not share one frozen checkpoint-selection policy.")
+    if len(target_role_digests) != 1:
+        raise CampaignCliError(
+            "SELECT2 seed comparison requires one identical leakage-safe target role across all final-development seeds."
+        )
+    return tuple(candidates), next(iter(policies.values()))
+
+
+def _command_verify_train2_select2(
+    *,
+    cfg: Mapping[str, Any],
+    paths: CampaignPaths,
+    store: CampaignStore,
+    campaign: Any,
+    convergence: Any,
+    deploy: Any,
+    dyn: Any,
+) -> int:
+    """Freeze the physics-qualified target-first production candidate before locked testing."""
+
+    import mdstats
+
+    candidates, selection_policy = _select2_candidate_records(
+        store=store, campaign=campaign, convergence=convergence, deploy=deploy, dyn=dyn,
+    )
+    target_decision = store.get_record("target_production_corpus_decision", mdstats.TargetProductionCorpusDecision)
+    selection = mdstats.build_select2_selection(
+        campaign_plan_digest=campaign.content_digest,
+        target_production_corpus_decision_digest=target_decision.content_digest,
+        dyn_verify_campaign_digest=dyn.content_digest,
+        selection_policy=selection_policy,
+        candidates=candidates,
+    )
+    prior_selection = store.get_record_optional("select2_selection", mdstats.Select2SelectionRecord)
+    if prior_selection is not None and prior_selection.content_digest != selection.content_digest:
+        store.delete_record("select2_frozen_candidate")
+    store.put_record("select2_selection", selection)
+    _atomic_json(paths.results / "select2-selection.json", selection.to_dict())
+
+    if selection.outcome != "selected" or selection.selected_candidate is None:
+        store.delete_record("select2_frozen_candidate")
+        _mark_stage(store, paths, "verify", StageState.FAILED, selection.decision_reason)
+        print(f"\nSELECT2 failed: {selection.decision_reason}")
+        return 1
+
+    winner = selection.selected_candidate
+    source_target = Path(str(winner.target_only_model_path)).resolve()
+    source_mliap = Path(str(winner.mliap_artifact_path)).resolve()
+    if (
+        not source_target.is_file() or _sha256(source_target) != winner.target_only_model_sha256
+        or not source_mliap.is_file() or _sha256(source_mliap) != winner.mliap_artifact_sha256
+    ):
+        raise CampaignCliError("SELECT2 selected deployment artifacts changed after physical qualification.")
+
+    freeze_root = paths.models / "select2-frozen"
+    freeze_root.mkdir(parents=True, exist_ok=True)
+    epoch = winner.selected_checkpoint.trajectory_point.epoch
+    target_path = freeze_root / f"seed-{winner.optimizer_seed}-epoch-{epoch}-target.model"
+    mliap_suffix = source_mliap.suffix or ".pt"
+    mliap_path = freeze_root / f"seed-{winner.optimizer_seed}-epoch-{epoch}-mliap{mliap_suffix}"
+
+    existing = store.get_record_optional("select2_frozen_candidate", mdstats.Select2FrozenCandidateRecord)
+    reusable = bool(
+        existing is not None
+        and existing.campaign_plan_digest == campaign.content_digest
+        and existing.selection_record_digest == selection.content_digest
+        and existing.selected_candidate_digest == winner.content_digest
+        and existing.target_model_sha256 == winner.target_only_model_sha256
+        and existing.mliap_artifact_sha256 == winner.mliap_artifact_sha256
+        and Path(existing.target_model_path).is_file()
+        and Path(existing.mliap_artifact_path).is_file()
+        and _sha256(Path(existing.target_model_path)) == existing.target_model_sha256
+        and _sha256(Path(existing.mliap_artifact_path)) == existing.mliap_artifact_sha256
+    )
+    if not reusable:
+        shutil.rmtree(freeze_root, ignore_errors=True)
+        freeze_root.mkdir(parents=True, exist_ok=True)
+        _atomic_copy_file(source_target, target_path)
+        _atomic_copy_file(source_mliap, mliap_path)
+        if _sha256(target_path) != winner.target_only_model_sha256 or _sha256(mliap_path) != winner.mliap_artifact_sha256:
+            raise CampaignCliError("SELECT2 frozen-candidate bytes changed during atomic promotion.")
+        frozen = mdstats.Select2FrozenCandidateRecord(
+            campaign_plan_digest=campaign.content_digest,
+            selection_record_digest=selection.content_digest,
+            selected_candidate_digest=winner.content_digest,
+            run_plan_digest=winner.run_plan_digest,
+            run_id=winner.run_id,
+            optimizer_seed=winner.optimizer_seed,
+            checkpoint_sha256=winner.selected_checkpoint.trajectory_point.checkpoint_sha256,
+            checkpoint_epoch=epoch,
+            target_model_path=str(target_path.resolve()),
+            target_model_sha256=winner.target_only_model_sha256,
+            mliap_artifact_path=str(mliap_path.resolve()),
+            mliap_artifact_sha256=winner.mliap_artifact_sha256,
+            frozen_at_utc=_utc_now(),
+        )
+        store.put_record("select2_frozen_candidate", frozen)
+    else:
+        frozen = existing
+        assert frozen is not None
+
+    _atomic_json(paths.results / "select2-frozen-candidate.json", frozen.to_dict())
+    _mark_stage(
+        store, paths, "verify", StageState.WAITING,
+        f"SELECT2 froze seed {winner.optimizer_seed}; activating one-shot locked post-freeze test",
+    )
+    _ok(
+        f"SELECT2 selected seed {winner.optimizer_seed} epoch {epoch}: "
+        f"target={winner.selected_checkpoint.target_metrics.force_component_rmse_ev_per_angstrom*1000.0:.2f} meV/A"
+    )
+    print(
+        "\nSELECT2 production candidate is frozen. Activating the one-shot locked post-freeze test; "
+        "that evidence may evaluate this candidate but has zero authority to select another seed/checkpoint.",
+        flush=True,
+    )
+    return _command_verify_train2_locked_test(
+        cfg=cfg, paths=paths, store=store, campaign=campaign,
+        selection=selection, frozen=frozen,
+    )
+
+
+def _locked_test2_policy(cfg: Mapping[str, Any], *, default_target_force_ceiling: float) -> Any:
+    import mdstats
+
+    def optional(name: str) -> float | None:
+        value = _cfg(cfg, "verification", name, None)
+        return None if value is None else float(value)
+
+    return mdstats.LockedTest2Policy(
+        maximum_target_force_rmse_ev_per_angstrom=float(
+            _cfg(cfg, "verification", "locked_maximum_target_force_rmse_ev_per_angstrom", default_target_force_ceiling)
+        ),
+        maximum_energy_mae_ev_per_atom=optional("locked_maximum_energy_mae_ev_per_atom"),
+        maximum_worst_stratum_force_rmse_ev_per_angstrom=optional(
+            "locked_maximum_worst_stratum_force_rmse_ev_per_angstrom"
+        ),
+        maximum_force_error_p99_ev_per_angstrom=optional("locked_maximum_force_error_p99_ev_per_angstrom"),
+        maximum_stress_rmse_ev_per_angstrom3=optional("locked_maximum_stress_rmse_ev_per_angstrom3"),
+    )
+
+
+def _train2_locked_test_context(
+    cfg: Mapping[str, Any],
+    paths: CampaignPaths,
+    store: CampaignStore,
+    *,
+    campaign: Any,
+    frozen: Any,
+) -> tuple[Any, Any, Any, Any, str, tuple[str, ...], tuple[str, ...]]:
+    """Resolve sealed locked-E lineage without exposing or rewriting locked bytes."""
+    import mdstats
+
+    role_freeze = store.get_record("target_data_role_freeze", mdstats.TargetDataRoleFreeze)
+    run = next((v for v in campaign.runs if v.content_digest == frozen.run_plan_digest), None)
+    if run is None:
+        raise CampaignCliError("LOCKED-TEST2 frozen SELECT2 run disappeared from the campaign plan.")
+    entries = _current_data8_entries(store)
+    jobs = _job_lookup(entries)
+    try:
+        bundle, _job, _root = jobs[run.mace_job_artifact_digest]
+    except KeyError as exc:
+        raise CampaignCliError("LOCKED-TEST2 lost DATA8 lineage for the frozen run.") from exc
+    label_domain_id = _eval2_label_domain_id(bundle, role_freeze)
+    domains = [v for v in role_freeze.domains if v.label_domain_id == label_domain_id]
+    if len(domains) != 1:
+        raise CampaignCliError("LOCKED-TEST2 could not resolve one frozen target label domain.")
+    domain = domains[0]
+    if not domain.locked_test_frame_uids or not domain.locked_test_unit_ids:
+        raise CampaignCliError("LOCKED-TEST2 requires a non-empty frozen locked-test E role.")
+    sealed = [
+        v for v in bundle.sealed_outer_evaluations
+        if v.role == "locked_interpolation_test" and v.label_domain_id == label_domain_id
+    ]
+    if len(sealed) != 1:
+        raise CampaignCliError("LOCKED-TEST2 requires exactly one sealed DATA8 locked-E authority for the selected domain.")
+    sealed_role = sealed[0]
+    if tuple(sealed_role.frame_uids) != tuple(domain.locked_test_frame_uids):
+        raise CampaignCliError("LOCKED-TEST2 DATA8 sealed membership differs from TARGET-DATA2A locked-E membership.")
+
+    sources, frames, _data4, data5 = _load_prepared(store, include_data4=False)
+    if sealed_role.frame_catalog_digest != frames.content_digest or sealed_role.data5_bundle_digest != data5.content_digest:
+        raise CampaignCliError("LOCKED-TEST2 sealed DATA8 lineage differs from current DATA5/frame catalog.")
+    if role_freeze.partition_unit_catalog_digest != data5.unit_catalog.content_digest:
+        raise CampaignCliError("LOCKED-TEST2 partition-unit authority changed after TARGET-DATA2A freeze.")
+    blocks = tuple(data5.unit_catalog.unit_for_frame(uid).unit_id for uid in domain.locked_test_frame_uids)
+    locked_units = tuple(domain.locked_test_unit_ids)
+    allowed = set(locked_units)
+    if any(block not in allowed for block in blocks):
+        raise CampaignCliError("LOCKED-TEST2 frame-to-correlation-block mapping escaped locked-E units.")
+    return role_freeze, sealed_role, sources, frames, label_domain_id, locked_units, blocks
+
+
+def _materialize_train2_locked_test_artifact(
+    cfg: Mapping[str, Any],
+    paths: CampaignPaths,
+    store: CampaignStore,
+    *,
+    campaign: Any,
+    frozen: Any,
+    sources: Any,
+    frames: Any,
+    label_domain_id: str,
+) -> tuple[Any, Path]:
+    """Materialize locked E exactly once, at first activation only."""
+    import mdstats
+
+    role_freeze = store.get_record("target_data_role_freeze", mdstats.TargetDataRoleFreeze)
+    domains = [v for v in role_freeze.domains if v.label_domain_id == label_domain_id]
+    if len(domains) != 1:
+        raise CampaignCliError("LOCKED-TEST2 could not resolve one frozen target label domain for materialization.")
+    domain = domains[0]
+    frame_data = _load_or_rebuild_frame_data(cfg, paths, sources)
+    root = paths.internal / "locked-test2" / "locked-E"
+    artifact = mdstats.write_mace_extxyz_artifact(
+        root, dataset_id=str(label_domain_id), role="locked_postfreeze_test_E", filename="locked-E.extxyz",
+        frame_uids=domain.locked_test_frame_uids, frame_catalog=frames, frame_data_by_run=frame_data,
+        data7_bundle=None, policy=mdstats.MaceExtxyzPolicy(),
+    )
+    target = (root / artifact.relative_path).resolve()
+    if not target.is_file() or _sha256(target) != artifact.sha256:
+        raise CampaignCliError("LOCKED-TEST2 locked-E materialization failed authentication.")
+    return artifact, target
+
+
+def _validate_existing_locked_test2_activation(
+    *,
+    existing: Any,
+    campaign: Any,
+    selection: Any,
+    frozen: Any,
+    role_freeze: Any,
+    sealed_role: Any,
+    label_domain_id: str,
+    locked_units: tuple[str, ...],
+    block_ids: tuple[str, ...],
+    policy: Any,
+) -> Path:
+    """Authenticate a previously activated locked test without touching its bytes."""
+    immutable_checks = {
+        "campaign plan": existing.campaign_plan_digest == campaign.content_digest,
+        "SELECT2 selection": existing.select2_selection_digest == selection.content_digest,
+        "SELECT2 frozen candidate": existing.select2_frozen_candidate_digest == frozen.content_digest,
+        "TARGET-DATA2A role freeze": existing.target_data_role_freeze_digest == role_freeze.content_digest,
+        "run plan": existing.run_plan_digest == frozen.run_plan_digest,
+        "optimizer seed": existing.optimizer_seed == frozen.optimizer_seed,
+        "label domain": existing.label_domain_id == label_domain_id,
+        "frozen target model": existing.frozen_target_model_sha256 == frozen.target_model_sha256,
+        "frozen ML-IAP artifact": existing.frozen_mliap_artifact_sha256 == frozen.mliap_artifact_sha256,
+        "locked policy": existing.policy.policy_digest == policy.policy_digest,
+        "sealed locked role": existing.sealed_locked_role_digest == sealed_role.content_digest,
+        "locked units": tuple(existing.locked_unit_ids) == tuple(locked_units),
+        "correlation blocks": tuple(existing.correlation_block_ids) == tuple(block_ids),
+    }
+    failed = [name for name, passed in immutable_checks.items() if not passed]
+    if failed:
+        raise CampaignCliError(
+            "LOCKED-TEST2 was already activated and its immutable authority changed ("
+            + ", ".join(failed)
+            + "). Refusing a second look at locked E; start a new campaign/protocol identity instead."
+        )
+    locked_path = Path(existing.locked_artifact_path).resolve()
+    if not locked_path.is_file() or _sha256(locked_path) != existing.locked_artifact_sha256:
+        raise CampaignCliError(
+            "LOCKED-TEST2 was already activated but its frozen locked-E bytes changed or disappeared. "
+            "Refusing rematerialization; start a new campaign/protocol identity instead."
+        )
+    return locked_path
+
+
+def _locked_test2_prediction_digest(predictions: Sequence[Any]) -> str:
+    import numpy as np
+    h = hashlib.sha256()
+    h.update(b"mdstats.locked-test2-predictions.v1\0")
+    for item in predictions:
+        energy = np.asarray([float(item.energy_ev)], dtype="<f8")
+        forces = np.asarray(item.forces_ev_per_angstrom, dtype="<f8", order="C")
+        h.update(energy.tobytes()); h.update(forces.tobytes())
+        stress = item.stress_ev_per_angstrom3
+        if stress is None:
+            h.update(b"nostress")
+        else:
+            h.update(np.asarray(stress, dtype="<f8", order="C").tobytes())
+    return h.hexdigest()
+
+
+def _command_verify_train2_locked_test(
+    *,
+    cfg: Mapping[str, Any],
+    paths: CampaignPaths,
+    store: CampaignStore,
+    campaign: Any,
+    selection: Any,
+    frozen: Any,
+) -> int:
+    """Evaluate locked E exactly once, then publish or reject the frozen SELECT2 bytes."""
+    import mdstats
+    try:
+        from ase.io import read
+    except ModuleNotFoundError as exc:
+        raise CampaignCliError(f"LOCKED-TEST2 requires ASE: {exc}") from exc
+
+    if selection.outcome != "selected" or selection.selected_candidate is None:
+        raise CampaignCliError("LOCKED-TEST2 cannot activate without one SELECT2 winner.")
+    winner = selection.selected_candidate
+    if frozen.selection_record_digest != selection.content_digest or frozen.selected_candidate_digest != winner.content_digest:
+        raise CampaignCliError("LOCKED-TEST2 SELECT2 frozen-candidate lineage mismatch.")
+    target_model = Path(frozen.target_model_path).resolve()
+    mliap_model = Path(frozen.mliap_artifact_path).resolve()
+    if not target_model.is_file() or _sha256(target_model) != frozen.target_model_sha256:
+        raise CampaignCliError("LOCKED-TEST2 frozen target-only model bytes changed.")
+    if not mliap_model.is_file() or _sha256(mliap_model) != frozen.mliap_artifact_sha256:
+        raise CampaignCliError("LOCKED-TEST2 frozen ML-IAP bytes changed.")
+
+    run = next((v for v in campaign.runs if v.content_digest == frozen.run_plan_digest), None)
+    if run is None:
+        raise CampaignCliError("LOCKED-TEST2 selected run disappeared from campaign plan.")
+    jobs = _job_lookup(_current_data8_entries(store))
+    try:
+        _bundle, job, _root = jobs[run.mace_job_artifact_digest]
+    except KeyError as exc:
+        raise CampaignCliError("LOCKED-TEST2 lost training-protocol authority for the selected run.") from exc
+    admissibility = job.protocol.checkpoint_admissibility_policy
+    if admissibility is None:
+        raise CampaignCliError("LOCKED-TEST2 selected TRAIN2 run lacks checkpoint-admissibility authority.")
+    policy = _locked_test2_policy(
+        cfg, default_target_force_ceiling=admissibility.maximum_target_force_rmse_ev_per_angstrom
+    )
+    role_freeze, sealed, sources, frames, label_domain_id, locked_units, block_ids = _train2_locked_test_context(
+        cfg, paths, store, campaign=campaign, frozen=frozen,
+    )
+    existing_activation = store.get_record_optional("locked_test2_activation", mdstats.LockedTest2ActivationRecord)
+    if existing_activation is None:
+        artifact, locked_path = _materialize_train2_locked_test_artifact(
+            cfg, paths, store, campaign=campaign, frozen=frozen, sources=sources, frames=frames,
+            label_domain_id=label_domain_id,
+        )
+        activation = mdstats.LockedTest2ActivationRecord(
+            campaign_plan_digest=campaign.content_digest,
+            select2_selection_digest=selection.content_digest,
+            select2_frozen_candidate_digest=frozen.content_digest,
+            target_data_role_freeze_digest=role_freeze.content_digest,
+            run_plan_digest=frozen.run_plan_digest, optimizer_seed=frozen.optimizer_seed,
+            label_domain_id=label_domain_id, frozen_target_model_sha256=frozen.target_model_sha256,
+            frozen_mliap_artifact_sha256=frozen.mliap_artifact_sha256, policy=policy,
+            sealed_locked_role_digest=sealed.content_digest, locked_artifact_digest=artifact.content_digest,
+            locked_artifact_sha256=artifact.sha256, locked_artifact_path=str(locked_path),
+            locked_frame_uids=artifact.frame_uids, locked_unit_ids=locked_units, correlation_block_ids=block_ids,
+            activated_at_utc=_utc_now(),
+        )
+        store.put_record("locked_test2_activation", activation)
+        _atomic_json(paths.results / "locked-test2-activation.json", activation.to_dict())
+    else:
+        activation = existing_activation
+        locked_path = _validate_existing_locked_test2_activation(
+            existing=activation, campaign=campaign, selection=selection, frozen=frozen,
+            role_freeze=role_freeze, sealed_role=sealed, label_domain_id=label_domain_id,
+            locked_units=locked_units, block_ids=block_ids, policy=policy,
+        )
+
+    result = store.get_record_optional("locked_test2_result", mdstats.LockedTest2ResultRecord)
+    if result is not None:
+        if result.activation_digest != activation.content_digest or result.frozen_target_model_sha256 != frozen.target_model_sha256:
+            raise CampaignCliError("LOCKED-TEST2 stored result does not match the immutable activation.")
+    else:
+        atoms = read(locked_path, index=":", format="extxyz")
+        if not isinstance(atoms, list):
+            atoms = [atoms]
+        atoms = tuple(atoms)
+        if len(atoms) != len(activation.locked_frame_uids):
+            raise CampaignCliError("LOCKED-TEST2 materialized frame count changed after activation.")
+        evaluation_policy = mdstats.CheckpointEvaluationPolicy(
+            target_head_name=job.protocol.checkpoint_control_policy.target_head_name,
+            replay_head_name="pt_head", replay_baseline_head_name=None,
+            focus_atomic_numbers=tuple(int(v) for v in _cfg(cfg, "profile", "mobile_atomic_numbers", (3, 11, 19))),
+            device=str(_cfg(cfg, "evaluation", "device", _cfg(cfg, "training", "device", "cuda"))),
+            default_dtype=str(_binary_model_precision_contract(cfg)["model_dtype"]),
+            batch_size=int(_cfg(cfg, "evaluation", "batch_size", 8)),
+            cache_monitor_datasets=True, cache_replay_baseline=False, evaluate_foundation_on_target=False,
+            acceleration_policy=_acceleration_policy(cfg),
+            **_evaluation_acceleration_binding(cfg, paths),
+            critical_precision_policy=_critical_precision_policy(cfg),
+        )
+        view = mdstats.cached_evaluation_dataset_view(
+            f"locked-test2:{activation.locked_artifact_sha256}", atoms,
+            energy_key=evaluation_policy.energy_key, forces_key=evaluation_policy.forces_key,
+            stress_key=evaluation_policy.stress_key, focus_atomic_numbers=evaluation_policy.focus_atomic_numbers,
+            condition_keys=evaluation_policy.condition_keys,
+        )
+        model_view = mdstats.predict_mace_model_on_probe(
+            target_model, atoms, device=evaluation_policy.device, model_dtype=evaluation_policy.default_dtype, head=None,
+        )
+        import numpy as np
+        energies = np.asarray(model_view["energy"], dtype=np.float64)
+        flat_forces = np.asarray(model_view["forces"], dtype=np.float64).reshape(-1)
+        stresses = None if "stress" not in model_view else np.asarray(model_view["stress"], dtype=np.float64)
+        predictions = []
+        offset = 0
+        for index, source in enumerate(atoms):
+            size = len(source) * 3
+            if offset + size > flat_forces.size:
+                raise CampaignCliError("LOCKED-TEST2 MACE force prediction length is invalid.")
+            force = flat_forces[offset:offset+size].reshape(len(source), 3); offset += size
+            stress = None if stresses is None else stresses[index]
+            predictions.append(mdstats.AtomicModelPrediction(float(energies[index]), force, stress))
+        if offset != flat_forces.size or len(predictions) != len(atoms):
+            raise CampaignCliError("LOCKED-TEST2 MACE prediction inventory changed.")
+        prediction_digest = _locked_test2_prediction_digest(predictions)
+        metrics = mdstats.eval2_target_metrics_from_prediction_view(
+            view, predictions, block_ids=activation.correlation_block_ids,
+            target_role_digest=activation.content_digest, prediction_digest=prediction_digest,
+        )
+        result = mdstats.build_locked_test2_result(
+            activation, metrics, prediction_digest=prediction_digest, evaluated_at_utc=_utc_now(),
+        )
+        store.put_record("locked_test2_result", result)
+        _atomic_json(paths.results / "locked-test2-result.json", result.to_dict())
+
+    if not result.passed:
+        _mark_stage(
+            store, paths, "verify", StageState.FAILED,
+            "LOCKED-TEST2 rejected the already frozen SELECT2 candidate; no fallback is permitted",
+        )
+        _warn(
+            "LOCKED-TEST2 failed. The SELECT2 candidate remains frozen for audit, but no other seed/checkpoint/target size "
+            "will be evaluated on locked E. A new scientific campaign/protocol identity is required."
+        )
+        return 1
+
+    existing_production = store.get_record_optional("locked_test2_production_model", mdstats.LockedTest2ProductionModelRecord)
+    published_target = (paths.models / "production_best.model").resolve()
+    published_mliap = (paths.models / "production_best-mliap_lammps.pt").resolve()
+    if existing_production is not None:
+        production = existing_production
+        expected = {
+            "campaign plan": production.campaign_plan_digest == campaign.content_digest,
+            "SELECT2 frozen candidate": production.select2_frozen_candidate_digest == frozen.content_digest,
+            "locked activation": production.locked_test_activation_digest == activation.content_digest,
+            "locked result": production.locked_test_result_digest == result.content_digest,
+            "run plan": production.run_plan_digest == frozen.run_plan_digest,
+            "optimizer seed": production.optimizer_seed == frozen.optimizer_seed,
+            "checkpoint": production.checkpoint_sha256 == frozen.checkpoint_sha256,
+            "checkpoint epoch": production.checkpoint_epoch == frozen.checkpoint_epoch,
+            "target path": Path(production.target_model_path).resolve() == published_target,
+            "target SHA": production.target_model_sha256 == frozen.target_model_sha256,
+            "ML-IAP path": Path(production.mliap_artifact_path).resolve() == published_mliap,
+            "ML-IAP SHA": production.mliap_artifact_sha256 == frozen.mliap_artifact_sha256,
+        }
+        failed = [name for name, passed in expected.items() if not passed]
+        if failed:
+            raise CampaignCliError(
+                "LOCKED-TEST2 already published production under different immutable authority ("
+                + ", ".join(failed)
+                + "). Refusing replacement after publication."
+            )
+        if not published_target.is_file() or _sha256(published_target) != production.target_model_sha256:
+            raise CampaignCliError("LOCKED-TEST2 published target model bytes changed after final publication.")
+        if not published_mliap.is_file() or _sha256(published_mliap) != production.mliap_artifact_sha256:
+            raise CampaignCliError("LOCKED-TEST2 published ML-IAP bytes changed after final publication.")
+        if published_target.stat().st_size != production.target_model_byte_size or published_mliap.stat().st_size != production.mliap_artifact_byte_size:
+            raise CampaignCliError("LOCKED-TEST2 published production artifact byte sizes changed.")
+    else:
+        _atomic_copy_file(target_model, published_target)
+        _atomic_copy_file(mliap_model, published_mliap)
+        if _sha256(published_target) != frozen.target_model_sha256 or _sha256(published_mliap) != frozen.mliap_artifact_sha256:
+            raise CampaignCliError("LOCKED-TEST2 production publication changed frozen SELECT2 bytes.")
+        production = mdstats.LockedTest2ProductionModelRecord(
+            campaign_plan_digest=campaign.content_digest, select2_frozen_candidate_digest=frozen.content_digest,
+            locked_test_activation_digest=activation.content_digest, locked_test_result_digest=result.content_digest,
+            run_plan_digest=frozen.run_plan_digest, optimizer_seed=frozen.optimizer_seed,
+            checkpoint_sha256=frozen.checkpoint_sha256, checkpoint_epoch=frozen.checkpoint_epoch,
+            target_model_path=str(published_target), target_model_sha256=frozen.target_model_sha256,
+            target_model_byte_size=published_target.stat().st_size,
+            mliap_artifact_path=str(published_mliap), mliap_artifact_sha256=frozen.mliap_artifact_sha256,
+            mliap_artifact_byte_size=published_mliap.stat().st_size, published_at_utc=_utc_now(),
+        )
+        store.put_record("locked_test2_production_model", production)
+    _atomic_json(paths.results / "locked-test2-production-model.json", production.to_dict())
+    summary = {
+        "schema": "mdstats.locked-test2-summary.v1",
+        "activation": activation.to_dict(), "result": result.to_dict(), "production_model": production.to_dict(),
+        "next_gate": "complete",
+    }
+    summary["content_digest"] = digest(summary)
+    _atomic_json(paths.results / "locked-test2.json", summary)
+    _mark_stage(
+        store, paths, "verify", StageState.COMPLETE,
+        f"LOCKED-TEST2 passed once; published immutable production seed {frozen.optimizer_seed}",
+    )
+    _ok(
+        f"LOCKED-TEST2 PASS: locked-E target RMSE={result.target_metrics.force_component_rmse_ev_per_angstrom*1000.0:.2f} meV/A; "
+        f"published {published_target.name} and {published_mliap.name}"
+    )
+    return 0
+
