+        require_lammps_run0=True,
+        float32_rtol=float(_cfg(cfg, "verification", "deployment_float32_rtol", 1.0e-5)),
+        float32_atol=float(_cfg(cfg, "verification", "deployment_float32_atol", 1.0e-6)),
+        float64_rtol=float(_cfg(cfg, "verification", "deployment_float64_rtol", 1.0e-9)),
+        float64_atol=float(_cfg(cfg, "verification", "deployment_float64_atol", 1.0e-10)),
