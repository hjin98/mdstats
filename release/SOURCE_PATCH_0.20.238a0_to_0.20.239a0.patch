+@dataclass
+class _MutableFamily:
+    family: str
+    retention_class: ArtifactRetentionClass
+    auto: str
+    manual: str
+    capabilities: tuple[str, ...]
+    logical: int = 0
+    allocated: int = 0
+    unique: int = 0
+    files: int = 0
+    directories: int = 0
