+        print(
+            "Adaptive migration: pending authority-alias closure; rerun `verify` once under "
+            "mdstats >=0.20.128a0 to reconcile 0.20.127 evidence.",
+            flush=True,
+        )
+    try:
+        mlcv_migration = store.get_record_optional(
+            "mlcv_migration", mdstats.MlcvMigrationRecord
