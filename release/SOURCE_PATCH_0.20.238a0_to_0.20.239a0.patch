+        _VIEW_CACHE_BYTES += resident_bytes
+        while _VIEW_CACHE and _VIEW_CACHE_BYTES > _VIEW_CACHE_MAX_BYTES:
+            _, (_, removed_bytes) = _VIEW_CACHE.popitem(last=False)
+            _VIEW_CACHE_BYTES -= removed_bytes
