+            )
+
+    def to_dict(self) -> dict[str, Any]:
+        return {
+            "schema": CLOSEST_PERIODIC_IMAGE_SCHEMA,
+            "displacement": list(self.displacement),
+            "image_shift": list(self.image_shift),
+            "vector": list(self.vector),
