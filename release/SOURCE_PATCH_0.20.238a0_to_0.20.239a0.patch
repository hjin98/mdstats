+            candidate.plan_for(candidate.preferred_backend)
+            for candidate in atomic_candidates
+        ]
+        used_voxels = sum(
+            plan.logical_node_count
+            for plan in provisional_atomic
+            if str(plan.metadata.get("backend", DENSE_BACKEND)) == DENSE_BACKEND
