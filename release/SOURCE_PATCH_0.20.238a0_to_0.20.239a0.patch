+@mace_runtime_warning_handled("foundation checkpoint E0 extraction")
+def _extract_foundation_e0(
+    model_path: Path,
+    atomic_numbers: Sequence[int],
+    *,
+    foundation_identity: Any,
+) -> dict[int, float]:
+    """Extract atomic E0 values from the exact resolved foundation head."""
+
+    try:
+        import torch
+    except Exception as exc:
+        raise CampaignCliError(f"PyTorch is required to read foundation E0 values: {exc}") from exc
+    model = torch.load(model_path, map_location="cpu", weights_only=False)
+    numbers = tuple(int(v) for v in model.atomic_numbers.detach().cpu().reshape(-1).tolist())
+    if tuple(getattr(foundation_identity, "model_atomic_numbers", ())) != numbers:
+        raise CampaignCliError("Foundation E0 atomic-number table disagrees with the inspected foundation identity.")
+    model_heads = tuple(str(v) for v in getattr(model, "heads", ("default",))) or ("default",)
+    recorded_heads = tuple(str(v) for v in getattr(foundation_identity, "available_heads", ()))
+    if recorded_heads and model_heads != recorded_heads:
+        raise CampaignCliError("Foundation E0 head table disagrees with the inspected foundation identity.")
+    head = str(getattr(foundation_identity, "foundation_head", "")).strip()
+    if head not in model_heads:
+        raise CampaignCliError(f"Resolved foundation head {head!r} is absent from checkpoint heads {model_heads}.")
+    values = model.atomic_energies_fn.atomic_energies.detach().cpu()
+    if values.ndim == 1:
+        if len(model_heads) != 1:
+            raise CampaignCliError(
+                "Multi-head foundation exposes a one-dimensional E0 table; head/E0 layout is inconsistent."
+            )
+        selected = values
+    elif values.ndim == 2:
+        if values.shape[0] != len(model_heads):
+            raise CampaignCliError(
+                "Foundation E0 table row count does not match the checkpoint head count."
+            )
+        selected = values[model_heads.index(head)]
+    else:
+        raise CampaignCliError(f"Unsupported foundation E0 tensor shape {tuple(values.shape)}.")
+    energies = [float(v) for v in selected.reshape(-1).tolist()]
+    if len(energies) != len(numbers):
+        raise CampaignCliError("Foundation E0 table width does not match the checkpoint atomic-number table.")
+    requested_atomic_numbers = frozenset(int(value) for value in atomic_numbers)
+    table = {z: e for z, e in zip(numbers, energies) if z in requested_atomic_numbers}
+    missing = sorted(requested_atomic_numbers - set(table))
+    if missing:
+        raise CampaignCliError(f"Foundation checkpoint lacks E0 values for atomic numbers {missing}.")
+    return table
+
+
+def _model_checkpoint_identity(cfg: Mapping[str, Any], paths: CampaignPaths) -> Any:
+    """Build the head-aware DATA6 root identity from the inspected foundation."""
+
+    import mdstats
+
+    potential = _resolved_foundation_potential_identity(cfg, paths)
+    realization = _stored_acceleration_realization(cfg, paths, require_qualified=False)
+    inference = _foundation_inference_identity(
+        cfg,
+        potential,
+        adapter_version=mdstats.MACE_ADAPTER_VERSION,
+        resolved_kernel_mode=(None if realization is None else realization.resolved_kernel_mode),
+    )
+    if realization is not None and realization.foundation_inference_identity_digest != inference.content_digest:
+        raise CampaignCliError("Stored acceleration realization/inference identity mismatch.")
+    model_path = _path_cfg(cfg, paths, "foundation_model")
+    assert model_path is not None
+    device = str(_cfg(cfg, "model", "device", _cfg(cfg, "training", "device", "cuda")))
+    dtype = str(_cfg(cfg, "model", "dtype", "float32"))
+    acceleration = _acceleration_policy(cfg)
+    requested_numbers = tuple(
+        int(v)
+        for v in _cfg(cfg, "profile", "all_atomic_numbers", (3, 8, 11, 13, 14, 19))
+    )
+    return mdstats.ModelCheckpointIdentity(
+        model_family=potential.model_family,
+        checkpoint_locator=str(model_path),
+        checkpoint_sha256=potential.sha256,
+        calculator_class="mace.calculators.MACECalculator",
+        model_version=str(_foundation_config(cfg).get("label", "MACE")),
+        supported_atomic_numbers=potential.model_atomic_numbers,
+        model_supported_atomic_numbers=potential.model_atomic_numbers,
+        requested_atomic_numbers=requested_numbers,
+        foundation_potential_digest=potential.canonical_content_digest,
+        foundation_inference_digest=inference.content_digest,
+        foundation_head=potential.foundation_head,
+        device=device,
+        default_dtype=dtype,
+        metadata=(
+            ("acceleration_backend", acceleration.backend.value),
+            ("acceleration_policy_digest", acceleration.policy_digest),
+            ("resolved_kernel_mode", inference.resolved_kernel_mode),
+            ("enable_cueq", str(acceleration.enable_cueq).lower()),
+            ("only_cueq", str(acceleration.only_cueq).lower()),
+            ("foundation_architecture_signature", str(potential.architecture_signature)),
+        ),
+    )
+
+
+@mace_runtime_warning_handled("campaign MACE provider construction")
+def _provider(cfg: Mapping[str, Any], paths: CampaignPaths, checkpoint_identity: Any | None = None) -> tuple[Any, Any]:
+    import mdstats
+    try:
+        from mace.calculators import MACECalculator
+    except Exception as exc:
+        raise CampaignCliError(f"MACE calculator import failed: {exc}. Run `doctor`.") from exc
+
+    model_path = _path_cfg(cfg, paths, "foundation_model")
+    assert model_path is not None
+    # If the caller already built the expected DATA6 plan, that v2 checkpoint
+    # identity is itself evidence that strict foundation inspection/head
+    # resolution completed before calculator construction. Avoid reloading the
+    # large checkpoint solely to rediscover the same head.
+    checkpoint = checkpoint_identity or _model_checkpoint_identity(cfg, paths)
+    if not bool(getattr(checkpoint, "foundation_bound", False)):
+        raise CampaignCliError("Source-foundation provider requires a head-aware ModelCheckpointIdentity.v2.")
+    if checkpoint.checkpoint_sha256 != _sha256(model_path):
+        raise CampaignCliError("DATA6 checkpoint identity does not match the current foundation bytes.")
+    resolved_head = str(getattr(checkpoint, "foundation_head", "")).strip()
+    if not resolved_head:
+        raise CampaignCliError("DATA6 checkpoint identity has no resolved foundation head.")
+    device = str(_cfg(cfg, "model", "device", _cfg(cfg, "training", "device", "cuda")))
+    dtype = str(_cfg(cfg, "model", "dtype", "float32"))
+    acceleration = _acceleration_policy(cfg)
+    metadata = dict(getattr(checkpoint, "metadata", ()))
+    if (
+        checkpoint.device != device
+        or checkpoint.default_dtype != dtype
+        or metadata.get("acceleration_policy_digest") != acceleration.policy_digest
+    ):
+        raise CampaignCliError("DATA6 checkpoint execution identity does not match the active campaign runtime policy.")
+    critical_precision = _critical_precision_policy(cfg)
+    mdstats.activate_mace_critical_precision_policy(critical_precision)
+    try:
+        kernel_mode = mdstats.MaceAccelerationKernelMode(metadata.get("resolved_kernel_mode", ""))
+    except Exception as exc:
+        raise CampaignCliError("DATA6 checkpoint has no valid resolved acceleration-kernel mode.") from exc
+    if kernel_mode.backend.value != acceleration.backend.value:
+        raise CampaignCliError("DATA6 checkpoint acceleration realization disagrees with the active requested backend.")
+    if kernel_mode is mdstats.MaceAccelerationKernelMode.CUEQ_UNRESOLVED:
+        raise CampaignCliError("CuEq execution is unresolved; rerun `doctor` in a qualified CuEq/OEQ runtime.")
+    calculator = MACECalculator(
+        model_paths=str(model_path),
+        head=resolved_head,
+        device=device,
+        default_dtype=dtype,
+        **kernel_mode.calculator_kwargs(),
+    )
+    return mdstats.MaceCalculatorProvider.from_calculator(calculator, checkpoint_identity=checkpoint), checkpoint
+
