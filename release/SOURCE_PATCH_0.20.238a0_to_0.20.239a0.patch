+                    collection.frame_ids[0],
+                    collection.frame_ids[0] + collection.n_frames,
+                    dtype=np.int64,
+                ),
+            )
+        ),
+    }
+
+    return VACFResult(
+        lag_steps=lags,
+        lag_times=lag_times,
+        scalar_sum=scalar,
