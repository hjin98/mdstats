+        neighbor_diagnostics = neighbor_search.diagnostics().to_dict()
+    if geometry_cache is not None:
+        neighbor_diagnostics = {
+            **dict(neighbor_diagnostics),
+            "geometry_cache": geometry_cache.to_dict(),
+        }
