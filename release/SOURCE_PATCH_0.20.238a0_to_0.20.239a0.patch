+
+    def to_dict(self, *, include_values: bool = True) -> dict[str, Any]:
+        p = {"schema": MATCHED_MEAN_FORCE_FIELD_SCHEMA, "grid_shape": list(self.grid_shape), "sample_count": self.sample_count,
