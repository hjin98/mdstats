+    coarse_survivor_sizes_by_seed: tuple[tuple[int, tuple[int, ...]], ...]
+    short_finalist_sizes_by_seed: tuple[tuple[int, tuple[int, ...]], ...]
+    eventual_finalist_sizes_by_seed: tuple[tuple[int, tuple[int, ...]], ...]
