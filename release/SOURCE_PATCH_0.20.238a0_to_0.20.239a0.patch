+def _run_evidence(sources: Any) -> dict[str, Any]:
+    runs = []
+    for source in sources.sources:
+        assertions = dict(source.assertions)
+        target = assertions.get("target_temperature_kelvin", assertions.get("temperature_kelvin"))
+        if source.quality_outcome is None or source.production_status is None:
+            raise CampaignCliError(
+                f"Run {source.run_id!r} lacks completed source-quality/production assessment. "
+                "Do not promote an unaudited source; inspect its VASP controls and trajectory-quality evidence."
+            )
+        quality = source.quality_outcome
+        production = source.production_status
+        ensemble_status = source.ensemble_status
+        ensemble = source.ensemble
+        if ensemble_status != "resolved":
+            asserted_ensemble = assertions.get("ensemble")
+            assertion_basis = assertions.get("ensemble_assertion_basis")
+            if asserted_ensemble in (None, "") or assertion_basis in (None, ""):
+                raise CampaignCliError(
+                    f"Run {source.run_id!r} has unresolved ensemble controls. Add reviewed manifest assertions "
+                    "`ensemble` and `ensemble_assertion_basis` (for example, the originating INCAR or run log), "
+                    "or repair the source controls before production promotion."
+                )
+            ensemble = str(asserted_ensemble).lower()
+            ensemble_status = "resolved"
+        runs.append(
+            {
+                "run_id": source.run_id,
+                "frame_count": source.frame_count,
+                "energy_complete": True,
+                "forces_complete": True,
+                "stress_complete": True,
+                "ensemble_status": ensemble_status,
+                "quality_outcome": quality,
+                "production_status": production,
+                "reduced_formula": source.composition.reduced_formula,
+                "ensemble": ensemble,
+                "ensemble_assertion_basis": assertions.get("ensemble_assertion_basis"),
+                "target_start_kelvin": None if target is None else float(target),
+                "target_end_kelvin": None if target is None else float(target),
+            }
+        )
+    return {"schema": "mdstats.mlff-campaign-run-evidence.v1", "runs": runs}
