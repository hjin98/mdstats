+TILED_MESH_TILE_REPORT_LEGACY_SCHEMA = "mdstats.tiled-mesh-tile-report.v1"
+TILED_MESH_EXTRACTION_SCHEMA = "mdstats.tiled-mesh-extraction.v2"
+TILED_MESH_EXTRACTION_LEGACY_SCHEMA = "mdstats.tiled-mesh-extraction.v1"
