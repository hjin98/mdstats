+        raise TargetCoverageExactNeighborhoodNativeStoreError(f"Missing {label} array identity.")
+    byte_count = int(reference.get("byte_count", -1))
+    mmap_mode = "r" if byte_count >= max(0, int(mmap_threshold_bytes)) else None
