+        bundle,
+        lags,
+        origin_stride=stride,
+        atom_block_size=atom_block_size,
+        origin_block_size=origin_block_size,
+        memory_target_bytes=DEFAULT_DISPLACEMENT_MEMORY_TARGET_BYTES,
+    )
