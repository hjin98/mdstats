+        object.__setattr__(self, "signature", expected)
+
+    def to_dict(self) -> dict[str, Any]:
+        return {
+            "schema": TEMPORAL_ASSIGNMENT_RESOURCES_SCHEMA,
+            "max_samples": self.max_samples,
+            "max_atoms": self.max_atoms,
