+        if self.n_frames != expected_frames:
+            raise TopologyStatisticsConsistencyError(
+                "n_frames disagrees with the half-open interval bounds."
+            )
+        if self.sample_span != self.n_frames - 1:
+            raise TopologyStatisticsConsistencyError(
