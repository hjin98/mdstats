+    "CANONICAL_FACE_CERTIFICATE_SCHEMA",
+    "CANONICAL_FACE_CONSTRAINT_SYSTEM_SCHEMA",
+    "CANONICAL_FACE_PAIR_CERTIFICATE_SCHEMA",
+    "CANONICAL_FACE_PLACEMENT_SCHEMA",
