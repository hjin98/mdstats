+def load_train2_runtime_summary(checkpoint_directory: str | Path) -> Train2RuntimeSummary:
+    path = Path(checkpoint_directory).resolve() / TRAIN2_RUNTIME_SUMMARY_FILENAME
+    if not path.is_file():
