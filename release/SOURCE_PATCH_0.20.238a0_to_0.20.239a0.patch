+        raise TrainingDataInputError("TARGET-DATA2C-MVQUAL1 has no globally common materializable target sizes.")
+    by_domain = {v.label_domain_id: v for v in domains}
+    legacy_common_n95 = next(
+        (
+            size
+            for size in common_sizes
+            if all(
