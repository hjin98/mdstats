+def _deploy_verify_one_train2_run(
+    *,
+    cfg: Mapping[str, Any],
+    paths: CampaignPaths,
+    store: CampaignStore,
+    run: Any,
+    job: Any,
+    bundle: Any,
+    root: Path,
+    execution: Any,
+    convergence: Any,
+    role_freeze: Any,
+    ladder: Any,
+    policy: Any,
+    model_dtype: str,
+    local_wrappers: Mapping[str, Path],
+) -> Any:
+    import mdstats
+
+    eval2_record = store.get_record(f"eval2_run:{run.run_id}", mdstats.Eval2RunRecord)
+    if eval2_record.outcome != "selected" or eval2_record.selected_checkpoint is None:
+        raise CampaignCliError(f"DEPLOY-VERIFY1 requires one selected EVAL2 checkpoint for {run.run_id}.")
+    target_role = _eval2_target_role_for_run(
+        store=store,
+        convergence=convergence,
+        role_freeze=role_freeze,
+        ladder=ladder,
+        bundle=bundle,
+        run=run,
+    )
+    target_artifact, target_path = _eval2_target_artifact_for_run(
+        paths=paths,
+        store=store,
+        bundle=bundle,
+        job=job,
+        root=root,
+        role=target_role,
+    )
+    if not target_path.is_file() or _sha256(target_path) != target_artifact.sha256:
+        raise CampaignCliError("DEPLOY-VERIFY1 target-role artifact bytes changed after EVAL2.")
+    probe_set = mdstats.build_deploy_verify_probe_set(
+        target_role,
+        target_artifact_digest=target_artifact.content_digest,
+        target_artifact_sha256=target_artifact.sha256,
+        maximum_configurations=policy.maximum_probe_configurations,
+    )
+    record_key = f"deploy_verify_run:{run.run_id}"
+    prior = store.get_record_optional(record_key, mdstats.DeployVerifyRunRecord)
+    if prior is not None and _deploy_verify_record_is_current(
+        prior,
+        run=run,
+        eval2_record=eval2_record,
+        policy=policy,
+        probe_set=probe_set,
+        require_target_deployment_identity=not bool(_foundation_config(cfg).get("legacy_normalized", False)),
+    ):
+        _ok(f"{run.run_id}: reused authenticated DEPLOY-VERIFY1 parity record")
+        return prior
+    store.delete_record(record_key)
+
+    catalog = _evaluation_checkpoint_catalog(store, run.run_id, execution)
+    checkpoint = next(
+        (item for item in catalog.checkpoints if item.sha256 == eval2_record.selected_checkpoint_sha256),
+        None,
+    )
+    if checkpoint is None:
+        raise CampaignCliError(f"DEPLOY-VERIFY1 selected checkpoint disappeared for {run.run_id}.")
+    source = (Path(catalog.root_directory) / checkpoint.relative_path).resolve()
+    if not source.is_file() or _sha256(source) != checkpoint.sha256:
+        raise CampaignCliError(f"DEPLOY-VERIFY1 selected checkpoint bytes changed for {run.run_id}.")
+
+    job_root = (root / job.relative_directory).resolve()
+    config_path = (root / job.config_relative_path).resolve()
+    cache_root = paths.runs / run.run_id / "checkpoint-model-cache"
+    _print_header(f"DEPLOY-VERIFY1 {run.run_id}")
+    print("[DEPLOY] materializing selected checkpoint model", flush=True)
+    source_model = mdstats.materialize_mace_checkpoint_model(
+        checkpoint,
+        source,
+        mace_config_path=config_path,
+        job_working_directory=job_root,
+        cache_directory=cache_root,
+        wrapper_path=local_wrappers["mdstats-mace-train"],
+        allow_checkpoint_dtype_template_cast=False,
+    )
+    source_model_sha = _sha256(source_model)
+
+    output_root = paths.models / "deploy-verify" / run.run_id
+    output_root.mkdir(parents=True, exist_ok=True)
+    target_model = output_root / "target-only.model"
+    target_head = job.protocol.checkpoint_control_policy.target_head_name
+    print(f"[DEPLOY] exporting explicit target head {target_head!r}", flush=True)
+    target_sha, _ = mdstats.export_target_head_model_artifact(
+        source_model,
+        target_model,
+        target_head_name=target_head,
+        target_device="cpu",
+        wrapper_path=local_wrappers["mdstats-mace-select-head"],
+        deployment_dtype=model_dtype,
+    )
+    target_head_deployment_identity = mdstats.TargetHeadDeploymentIdentity(
+        run_plan_digest=run.content_digest,
+        eval2_run_record_digest=eval2_record.content_digest,
+        source_model_sha256=source_model_sha,
+        target_model_sha256=target_sha,
+        target_head=target_head,
+        deployment_dtype=model_dtype,
+    )
+    target_head_export_digest = mdstats.target_head_export_digest(
+        source_model_sha256=source_model_sha,
+        target_model_sha256=target_sha,
+        target_head=target_head,
+        deployment_dtype=model_dtype,
+        target_head_deployment_identity_digest=target_head_deployment_identity.content_digest,
+    )
+
+    try:
+        from ase.io import read
+    except ModuleNotFoundError as exc:
+        raise CampaignCliError(f"DEPLOY-VERIFY1 requires ASE: {exc}") from exc
+    all_atoms = tuple(read(target_path, index=":"))
+    if len(all_atoms) != target_artifact.configuration_count:
+        raise CampaignCliError("DEPLOY-VERIFY1 target artifact configuration count changed.")
+    probe_atoms = tuple(all_atoms[index] for index in probe_set.configuration_indices)
+    device = str(_cfg(cfg, "verification", "device", _cfg(cfg, "training", "device", "cuda")))
+    rtol, atol = policy.tolerances
+    print(f"[DEPLOY] comparing checkpoint target head to exported target-only model on {len(probe_atoms)} probes", flush=True)
+    checkpoint_predictions = mdstats.predict_mace_model_on_probe(
+        source_model, probe_atoms, device=device, model_dtype=model_dtype, head=target_head
+    )
+    target_predictions = mdstats.predict_mace_model_on_probe(
+        target_model, probe_atoms, device=device, model_dtype=model_dtype, head=None
+    )
+    checkpoint_to_target = mdstats.compare_prediction_channels(
+        checkpoint_predictions,
+        target_predictions,
+        reference_identity=f"checkpoint:{checkpoint.sha256}:head:{target_head}",
+        observed_identity=f"target-only:{target_sha}",
+        rtol=rtol,
+        atol=atol,
+    )
+    if not checkpoint_to_target.passed:
+        raise CampaignCliError(
+            f"DEPLOY-VERIFY1 target-head export parity failed for {run.run_id}."
+        )
+
+    print("[DEPLOY] converting target-only model to ML-IAP artifact", flush=True)
+    mliap_path, mliap_export_digest = mdstats.export_mliap_lammps_artifact(
+        target_model,
+        output_root,
+        model_dtype=model_dtype,
+        target_head=target_head,
+        source_identity_digest=target_head_deployment_identity.content_digest,
+        timeout_seconds=float(_cfg(cfg, "verification", "deployment_mliap_export_timeout_seconds", 1800.0)),
+    )
+    lammps_executable = str(_cfg(cfg, "verification", "deployment_lammps_executable", "lmp"))
+    lammps_arguments = tuple(
+        str(v) for v in _cfg(
+            cfg,
+            "verification",
+            "deployment_lammps_arguments",
+            ("-k", "on", "g", "1", "-sf", "kk", "-pk", "kokkos", "newton", "on", "neigh", "half"),
+        )
+    )
+    run0_root = output_root / "lammps-run0"
+    shutil.rmtree(run0_root, ignore_errors=True)
+    print("[DEPLOY] running ML-IAP LAMMPS run 0 parity probes", flush=True)
+    lammps_predictions, run0_record = mdstats.run_lammps_mliap_run0(
+        mliap_path,
+        target_model,
+        probe_atoms,
+        probe_set_digest=probe_set.content_digest,
+        lammps_executable=lammps_executable,
+        lammps_arguments=lammps_arguments,
+        work_directory=run0_root,
+        timeout_seconds=float(_cfg(cfg, "verification", "deployment_lammps_timeout_seconds", 600.0)),
+    )
+    target_to_lammps = mdstats.compare_prediction_channels(
+        target_predictions,
+        lammps_predictions,
+        reference_identity=f"target-only:{target_sha}",
+        observed_identity=f"mliap-lammps-run0:{run0_record.content_digest}",
+        rtol=rtol,
+        atol=atol,
+    )
+    if not target_to_lammps.passed:
+        raise CampaignCliError(
+            f"DEPLOY-VERIFY1 ML-IAP/LAMMPS parity failed for {run.run_id}."
+        )
+    record = mdstats.DeployVerifyRunRecord(
+        run_plan_digest=run.content_digest,
+        eval2_run_record_digest=eval2_record.content_digest,
+        policy=policy,
+        probe_set=probe_set,
+        selected_checkpoint_sha256=checkpoint.sha256,
+        selected_checkpoint_epoch=checkpoint.epoch,
+        selected_checkpoint_model_sha256=source_model_sha,
+        target_head_name=target_head,
+        target_only_model_path=str(target_model.resolve()),
+        target_only_model_sha256=target_sha,
+        target_head_export_digest=target_head_export_digest,
+        mliap_artifact_path=str(mliap_path.resolve()),
+        mliap_artifact_sha256=_sha256(mliap_path),
+        mliap_export_digest=mliap_export_digest,
+        checkpoint_to_target_comparison=checkpoint_to_target,
+        target_to_lammps_comparison=target_to_lammps,
+        lammps_run0=run0_record,
+        target_head_deployment_identity=target_head_deployment_identity,
+        mliap_source_identity_digest=target_head_deployment_identity.content_digest,
+    )
+    store.put_record(record_key, record)
+    _ok(f"{run.run_id}: DEPLOY-VERIFY1 passed checkpoint -> target-only -> ML-IAP/LAMMPS run 0 parity")
+    return record
+
