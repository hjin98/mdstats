+            "maximum_degradation_fraction": self.maximum_degradation_fraction,
+            "require_disjoint_monitor": self.require_disjoint_monitor,
+            "failure_behavior": self.failure_behavior,
+        }
+
+    @property
+    def policy_digest(self) -> str:
