+        return self.value_a2_per_ps * _A2_PER_PS_TO_CM2_PER_S
+
+    @property
+    def standard_error_cm2_per_s(self) -> float | None:
+        if self.standard_error_a2_per_ps is None:
+            return None
+        return self.standard_error_a2_per_ps * _A2_PER_PS_TO_CM2_PER_S
