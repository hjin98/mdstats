+            if active_probe.cueq_available
+            else MaceAccelerationKernelMode.CUEQ_UNRESOLVED.value
+        ),
+        device=device,
+        dtype=dtype,
+        training_checkpoint_reference=str(path),
+        training_checkpoint_sha256=checkpoint_sha,
