+_existing_getattr = globals().get("__getattr__")
+def __getattr__(name: str):
+    if name in _LAZY_MLFF_LTA_EXPORTS:
+        from . import training_data as _training_data
+        value = getattr(_training_data, name)
+        globals()[name] = value
+        return value
+    if _existing_getattr is not None:
+        return _existing_getattr(name)
+    raise AttributeError(f"module {__name__!r} has no attribute {name!r}")
