+def _normalized_digest_tuple(values: Sequence[str], *, name: str) -> tuple[str, ...]:
+    result = tuple(sorted(set(validate_digest(v, name=name) for v in values)))
+    if not result:
+        raise TrainingDataInputError(f"{name} values must be non-empty.")
+    return result
