+def _variant_cross_validation_plans(
+    data5: Any,
+    frames: Any,
+    data4: Any,
+    variant: _VariantSpec,
+) -> tuple[Any, ...]:
+    """Build the exact deterministic fold plan requested by one method.
+
+    DATA5 owns the immutable units and outer-role partition.  Method-specific
+    K-fold plans are derived from those same units so naïve and replay methods
+    can use either paired folds (same count/seed) or intentionally different
+    fold matrices without rebuilding DATA2-DATA6.
+    """
+
+    import mdstats
+
+    if variant.cross_validation_folds == 0:
+        return ()
+
+    plans = mdstats.build_cross_validation_plans(
+        data5.unit_catalog,
+        data5.outer_partitions,
+        data5.feasibility_reports,
+        policy=data5.partition_policy,
+        fold_count_override=variant.cross_validation_folds,
+        fold_seed_override=variant.fold_partition_seed,
+    )
+    leakage = mdstats.audit_partition_leakage(
+        data5.unit_catalog,
+        data5.outer_partitions,
+        plans,
+        frames,
+        data4,
+        partition_policy=data5.partition_policy,
+    )
+    if not leakage.passed:
+        raise CampaignCliError(
+            f"Method-specific fold plan failed leakage audit for {variant.variant_id}."
+        )
+    return plans
+
+
+def _pre_materialization_corpus_blockers(frames: Any, data5: Any) -> tuple[str, ...]:
+    """Return corpus blockers that must be known before expensive DATA7/DATA8 work."""
+    blockers: list[str] = []
+    if any(item.tensor_class.value == "unresolved" for item in frames.strain_records):
+        blockers.append("unresolved_frame_strain")
+    if any(item.state.value == "ineligible" for item in frames.eligibility.decisions):
+        blockers.append("rejected_training_frames_present")
+    if not all(report.is_usable for report in data5.feasibility_reports):
+        blockers.append("data5_role_feasibility_insufficient")
+    if not bool(data5.leakage_audit.passed):
+        blockers.append("data5_leakage_audit_failed")
+    return tuple(blockers)
+
