+        _MACE_MONITOR_GRAPH_CACHE_BYTES += resident
+        while (
+            _MACE_MONITOR_GRAPH_CACHE
+            and _MACE_MONITOR_GRAPH_CACHE_BYTES > _MACE_MONITOR_GRAPH_CACHE_MAX_BYTES
