+def _pes_verify_common_target(
+    *,
+    paths: CampaignPaths,
+    store: CampaignStore,
+    campaign: Any,
+    convergence: Any,
+    deploy: Any,
+) -> tuple[tuple[Any, ...], Any]:
+    """Restore the candidate-independent target domain used by DEPLOY/PES."""
+
+    import mdstats
+    try:
+        from ase.io import read
+    except ModuleNotFoundError as exc:
+        raise CampaignCliError(f"PES-VERIFY1 requires ASE: {exc}") from exc
+
+    _, expected_runs = _deploy_verify_candidate_runs(campaign, convergence)
+    run_by_digest = {run.content_digest: run for run in expected_runs}
+    first_deploy = deploy.run_records[0]
+    run = run_by_digest.get(first_deploy.run_plan_digest)
+    if run is None:
+        raise CampaignCliError("PES-VERIFY1 DEPLOY authority does not resolve to a live campaign run.")
+    entries = _current_data8_entries(store)
+    jobs = _job_lookup(entries)
+    bundle, job, root = jobs[run.mace_job_artifact_digest]
+    role_freeze = store.get_record("target_data_role_freeze", mdstats.TargetDataRoleFreeze)
+    ladder = _load_verified_target_data_ladder_authority(store)
+    role = _eval2_target_role_for_run(
+        store=store,
+        convergence=convergence,
+        role_freeze=role_freeze,
+        ladder=ladder,
+        bundle=bundle,
+        run=run,
+    )
+    artifact, target_path = _eval2_target_artifact_for_run(
+        paths=paths,
+        store=store,
+        bundle=bundle,
+        job=job,
+        root=root,
+        role=role,
+    )
+    for record in deploy.run_records:
+        if (
+            record.probe_set.target_role_digest != role.content_digest
+            or record.probe_set.target_artifact_digest != artifact.content_digest
+            or record.probe_set.target_artifact_sha256 != artifact.sha256
+        ):
+            raise CampaignCliError("PES-VERIFY1 candidates do not share one authenticated target-role authority.")
+    values = read(target_path, index=":", format="extxyz")
+    if not isinstance(values, list):
+        values = [values]
+    if len(values) != artifact.configuration_count:
+        raise CampaignCliError("PES-VERIFY1 target artifact configuration count changed.")
+    return tuple(values), artifact
+
+
+def _pes_reference_protocol_digest(cfg: Mapping[str, Any]) -> str | None:
+    value = _cfg(cfg, "verification", "pes_reference_protocol_digest", "")
+    text = "" if value is None else str(value).strip()
+    return text or None
+
+
+def _pes_external_reference_path(cfg: Mapping[str, Any], paths: CampaignPaths) -> Path | None:
+    value = _cfg(cfg, "verification", "pes_reference_extxyz", "")
+    if value in (None, ""):
+        return None
+    return _resolve_path(value, paths.config_dir)
+
+
+def _command_verify_train2_pes(
+    args: argparse.Namespace,
+    *,
+    cfg: Mapping[str, Any],
+    paths: CampaignPaths,
+    store: CampaignStore,
+    campaign: Any,
+    model_dtype: str,
+    deploy: Any,
+) -> int:
+    """Run/reuse PES-VERIFY1, pausing cleanly while matched DFT labels are absent."""
+
+    import mdstats
+
+    convergence = _load_verified_target_size_convergence_authority(store)
+    if deploy.campaign_plan_digest != campaign.content_digest or deploy.target_size_convergence_digest != convergence.content_digest:
+        raise CampaignCliError("PES-VERIFY1 received stale DEPLOY-VERIFY1 authority.")
+    foundation_audit = _load_verified_foundation_audit_authority(store)
+    foundation_model = _path_cfg(cfg, paths, "foundation_model")
+    assert foundation_model is not None
+    foundation_model = foundation_model.resolve()
+    if not foundation_model.is_file() or _sha256(foundation_model) != foundation_audit.foundation_checkpoint_sha256:
+        raise CampaignCliError("PES-VERIFY1 foundation checkpoint bytes changed after FOUNDATION-AUDIT1.")
+
+    target_atoms, _ = _pes_verify_common_target(
+        paths=paths,
+        store=store,
+        campaign=campaign,
+        convergence=convergence,
+        deploy=deploy,
+    )
+    probe_digests = {record.probe_set.content_digest for record in deploy.run_records}
+    if len(probe_digests) != 1:
+        raise CampaignCliError("PES-VERIFY1 requires all deployment candidates to share one probe membership.")
+    policy = _pes_verify_policy(cfg)
+    probe_set, request_atoms = mdstats.build_pes_probe_set(
+        deploy.run_records[0].probe_set,
+        target_atoms,
+        policy=policy,
+        material_contracts=_material_profile_contracts(cfg),
+    )
+    request_root = (paths.results / "pes-verify1").resolve()
+    request = mdstats.write_pes_probe_request(probe_set, request_atoms, request_root)
+    store.put_record("pes_verify_probe_set", probe_set)
+    store.put_record("pes_verify_probe_request", request)
+
+    cached_reference = store.get_record_optional("pes_verify_reference", mdstats.PESReferenceArtifact)
+    reference = None
+    ordered_reference = None
+    reference_predictions = None
+    if cached_reference is not None:
+        cached_path = Path(cached_reference.reference_path).resolve()
+        if (
+            cached_reference.probe_set_digest == probe_set.content_digest
+            and cached_path.is_file()
+            and _sha256(cached_path) == cached_reference.reference_sha256
+        ):
+            try:
+                reference, ordered_reference, reference_predictions = mdstats.load_pes_reference_extxyz(
+                    probe_set,
+                    request_atoms,
+                    cached_path,
+                    policy=policy,
+                    protocol_digest=cached_reference.protocol_digest,
+                    protocol_source=cached_reference.protocol_source,
+                    source_file_sha256s=cached_reference.source_file_sha256s,
+                )
+            except Exception:
+                reference = ordered_reference = reference_predictions = None
+        if reference is None:
+            store.delete_record("pes_verify_reference")
+
+    external = _pes_external_reference_path(cfg, paths)
+    if reference is None and external is not None:
+        protocol_digest = _pes_reference_protocol_digest(cfg)
+        if protocol_digest is None:
+            raise CampaignCliError(
+                "PES-VERIFY1 external reference ExtXYZ requires [verification].pes_reference_protocol_digest "
+                "to authenticate the fixed-geometry DFT protocol."
+            )
+        reference, ordered_reference, reference_predictions = mdstats.load_pes_reference_extxyz(
+            probe_set,
+            request_atoms,
+            external,
+            policy=policy,
+            protocol_digest=protocol_digest,
+            protocol_source="campaign_config_external_extxyz",
+        )
+
+    if reference is None:
+        collected = mdstats.collect_pes_reference_from_vasp(
+            probe_set,
+            request_atoms,
+            request,
+            output_path=request_root / "dft-reference.extxyz",
+            policy=policy,
+        )
+        if collected is not None:
+            reference, ordered_reference, reference_predictions = collected
+
+    if reference is None or ordered_reference is None or reference_predictions is None:
+        _mark_stage(
+            store,
+            paths,
+            "verify",
+            StageState.WAITING,
+            "PES-VERIFY1 finite-displacement DFT reference requested; fixed-geometry single points are pending",
+        )
+        print("\nPES-VERIFY1 DFT reference is required before verification can continue.")
+        print(f"  request manifest: {request.manifest_path}")
+        print(f"  request ExtXYZ:   {request.extxyz_path}")
+        print("  Run one fixed-geometry VASP single-point calculation in every dft-inputs directory")
+        print("  using identical INCAR/KPOINTS/POTCAR settings, then rerun `verify`.")
+        return 0
+    store.put_record("pes_verify_reference", reference)
+
+    pes_foundation_potential = getattr(foundation_audit, "foundation_potential_identity", None)
+    pes_foundation_inference = getattr(foundation_audit, "foundation_inference_identity", None)
+    if (pes_foundation_potential is None) != (pes_foundation_inference is None):
+        raise CampaignCliError("PES-VERIFY1 foundation audit carries incomplete canonical identity.")
+    pes_foundation_head = (
+        _canonical_foundation_head(cfg)
+        if pes_foundation_potential is None
+        else pes_foundation_potential.foundation_head
+    )
+    pes_foundation_calculator_kwargs: dict[str, Any] = {}
+    if pes_foundation_potential is not None:
+        realization = _stored_acceleration_realization(cfg, paths, require_qualified=True)
+        assert realization is not None
+        if realization.foundation_inference_identity_digest != pes_foundation_inference.content_digest:
+            raise CampaignCliError("PES-VERIFY1 foundation inference identity disagrees with doctor-frozen acceleration realization.")
+        pes_foundation_calculator_kwargs = dict(
+            mdstats.MaceAccelerationKernelMode(realization.resolved_kernel_mode).calculator_kwargs()
+        )
+
+    # Reuse a fully authenticated result without repeating model inference.
+    cached_campaign = store.get_record_optional("pes_verify", mdstats.PESVerifyCampaignRecord)
+    if cached_campaign is not None:
+        live_candidate = {record.run_plan_digest: record for record in deploy.run_records}
+        reusable = bool(
+            cached_campaign.campaign_plan_digest == campaign.content_digest
+            and cached_campaign.deploy_verify_campaign_digest == deploy.content_digest
+            and cached_campaign.foundation_audit_digest == foundation_audit.content_digest
+            and cached_campaign.foundation_model_sha256 == foundation_audit.foundation_checkpoint_sha256
+            and cached_campaign.foundation_head_name == pes_foundation_head
+            and (
+                (pes_foundation_potential is None and cached_campaign.foundation_potential_identity is None)
+                or (
+                    pes_foundation_potential is not None
+                    and cached_campaign.foundation_potential_identity is not None
+                    and cached_campaign.foundation_potential_identity.canonical_content_digest == pes_foundation_potential.canonical_content_digest
+                    and cached_campaign.foundation_inference_identity.content_digest == pes_foundation_inference.content_digest
+                )
+            )
+            and cached_campaign.policy.policy_digest == policy.policy_digest
+            and cached_campaign.probe_set.content_digest == probe_set.content_digest
+            and cached_campaign.probe_request.content_digest == request.content_digest
+            and cached_campaign.reference_artifact.content_digest == reference.content_digest
+            and {v.run_plan_digest for v in cached_campaign.run_records} == set(live_candidate)
+        )
+        if reusable:
+            for record in cached_campaign.run_records:
+                deploy_record = live_candidate[record.run_plan_digest]
+                model_path = Path(record.candidate_model_path).resolve()
+                if (
+                    record.deploy_verify_run_digest != deploy_record.content_digest
+                    or record.candidate_model_sha256 != deploy_record.target_only_model_sha256
+                    or not model_path.is_file()
+                    or _sha256(model_path) != record.candidate_model_sha256
+                ):
+                    reusable = False
+                    break
+        if reusable:
+            if cached_campaign.all_candidates_failed:
+                _mark_stage(store, paths, "verify", StageState.FAILED, "PES-VERIFY1 rejected every deployment candidate")
+                return 1
+            _ok(f"PES-VERIFY1 reused for {len(cached_campaign.run_records)} candidate(s)")
+            return _command_verify_train2_relax(
+                args, cfg=cfg, paths=paths, store=store, campaign=campaign, model_dtype=model_dtype,
+                deploy=deploy, pes=cached_campaign,
+            )
+        store.delete_record("pes_verify")
+
+    device = str(_cfg(cfg, "verification", "device", _cfg(cfg, "training", "device", "cuda")))
+    foundation_head = pes_foundation_head
+    _mark_stage(store, paths, "verify", StageState.RUNNING, "running PES-VERIFY1 finite-displacement local-PES qualification")
+    print(f"[PES] evaluating foundation model on {len(request_atoms)} common DFT probes", flush=True)
+    foundation_view = mdstats.predict_mace_model_on_probe(
+        foundation_model,
+        request_atoms,
+        device=device,
+        model_dtype=model_dtype,
+        head=foundation_head,
+        calculator_kwargs=pes_foundation_calculator_kwargs,
+        foundation_potential_identity=pes_foundation_potential,
+        foundation_inference_identity=pes_foundation_inference,
+    )
+    foundation_predictions = mdstats.prediction_payload_from_mace_view(foundation_view, request_atoms)
+    foundation_qualification = mdstats.assess_pes_model(
+        probe_set,
+        reference_predictions,
+        foundation_predictions,
+        policy=policy,
+        model_role="foundation",
+        model_sha256=foundation_audit.foundation_checkpoint_sha256,
+    )
+
+    run_records = []
+    for deploy_record in deploy.run_records:
+        candidate_path = Path(deploy_record.target_only_model_path).resolve()
+        if not candidate_path.is_file() or _sha256(candidate_path) != deploy_record.target_only_model_sha256:
+            raise CampaignCliError("PES-VERIFY1 candidate target-only model bytes changed after DEPLOY-VERIFY1.")
+        print(f"[PES] evaluating candidate {deploy_record.run_plan_digest[:12]}...", flush=True)
+        candidate_view = mdstats.predict_mace_model_on_probe(
+            candidate_path,
+            request_atoms,
+            device=device,
+            model_dtype=model_dtype,
+            head=None,
+        )
+        candidate_predictions = mdstats.prediction_payload_from_mace_view(candidate_view, request_atoms)
+        qualification = mdstats.assess_pes_model(
+            probe_set,
+            reference_predictions,
+            candidate_predictions,
+            policy=policy,
+            model_role="candidate",
+            model_sha256=deploy_record.target_only_model_sha256,
+        )
+        run_record = mdstats.PESVerifyRunRecord(
+            run_plan_digest=deploy_record.run_plan_digest,
+            deploy_verify_run_digest=deploy_record.content_digest,
+            candidate_model_path=str(candidate_path),
+            candidate_model_sha256=deploy_record.target_only_model_sha256,
+            candidate_qualification=qualification,
+        )
+        store.put_record(f"pes_verify_run:{deploy_record.run_plan_digest}", run_record)
+        run_records.append(run_record)
+        status = "PASS" if run_record.passed else "FAIL"
+        print(f"[PES {status}] {deploy_record.run_plan_digest[:12]}: failed_modes={qualification.failed_mode_count}", flush=True)
+
+    authority = mdstats.PESVerifyCampaignRecord(
+        campaign_plan_digest=campaign.content_digest,
+        deploy_verify_campaign_digest=deploy.content_digest,
+        foundation_audit_digest=foundation_audit.content_digest,
+        foundation_model_sha256=foundation_audit.foundation_checkpoint_sha256,
+        policy=policy,
+        probe_set=probe_set,
+        probe_request=request,
+        reference_artifact=reference,
+        foundation_qualification=foundation_qualification,
+        run_records=tuple(run_records),
+        stage_context=deploy.stage_context,
+        foundation_head_name=foundation_head,
+        foundation_potential_identity=pes_foundation_potential,
+        foundation_inference_identity=pes_foundation_inference,
+    )
+    store.put_record("pes_verify", authority)
+    summary = authority.to_dict()
+    _atomic_json(request_root / "pes-verify1.json", summary)
+    if authority.all_candidates_failed:
+        _mark_stage(store, paths, "verify", StageState.FAILED, "PES-VERIFY1 rejected every deployment candidate")
+        print("\nPES-VERIFY1 failed: every deployment candidate has a wrong local restoring-force/curvature mode.")
+        return 1
+    _ok(
+        f"PES-VERIFY1 complete: {authority.passed_run_count}/{len(authority.run_records)} candidate(s) passed; "
+        f"foundation baseline={'PASS' if foundation_qualification.passed else 'FAIL'} (diagnostic)"
+    )
+    return _command_verify_train2_relax(
+        args, cfg=cfg, paths=paths, store=store, campaign=campaign, model_dtype=model_dtype,
+        deploy=deploy, pes=authority,
+    )
