+TRAINING_CAMPAIGN_POLICY_V2_SCHEMA = "mdstats.training-campaign-policy.v2"
+TRAINING_CAMPAIGN_POLICY_LEGACY_SCHEMA = "mdstats.training-campaign-policy.v1"
