+                local=local[keep]; dq=dq[keep]; dy=dq@L
+                fit_radius=max(a.local_chart.validity_radius*options.chart_radius_factor,
+                               float(np.max(np.linalg.norm(dy,axis=1))) if len(dy) else 0.0)
+            else:
