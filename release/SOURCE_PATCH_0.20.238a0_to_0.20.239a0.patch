+def _finalize_train2_dyn(
+    *,
+    cfg: Mapping[str, Any],
+    paths: CampaignPaths,
+    store: CampaignStore,
+    campaign: Any,
+    deploy: Any,
+    authority: Any,
+) -> int:
+    """Advance TARGET-DATA2D after DYN Stage C or wait for SELECT2 in production."""
+
+    import mdstats
+
+    if authority.stage_context == "target_size_stage_c":
+        convergence = _load_verified_target_size_convergence_authority(store)
+        evidence = _dyn_stage_c_training_evidence(
+            cfg=cfg, paths=paths, store=store, campaign=campaign,
+            convergence=convergence, deploy=deploy, dyn=authority,
+        )
+        updated = mdstats.with_stage_c_evidence(convergence, evidence)
+        store.put_record("target_size_convergence", updated)
+        if updated.outcome == "selected":
+            decision = _ensure_target_production_corpus_decision(store)
+            assert decision is not None
+            _mark_stage(
+                store, paths, "verify", StageState.COMPLETE,
+                f"DYN-VERIFY2 complete; TARGET-DATA2D selected N_target={updated.selected_target_size}",
+            )
+            _ok(f"DYN-VERIFY2 complete; TARGET-DATA2D selected N_target={updated.selected_target_size}")
+            print("\nTarget-size physical qualification is frozen. Next: `train` for the selected-size production matrix.")
+            return 0
+        _mark_stage(store, paths, "verify", StageState.FAILED, updated.decision_reason)
+        print(f"\nTARGET-DATA2D Stage C did not select a production target size: {updated.decision_reason}")
+        return 1
+
+    if authority.all_candidates_failed:
+        _mark_stage(store, paths, "verify", StageState.FAILED, "DYN-VERIFY2 rejected every production candidate")
+        return 1
+    _ok(f"DYN-VERIFY2 complete: {authority.passed_run_count}/{len(authority.run_records)} RELAX-qualified candidate(s) passed")
+    return _command_verify_train2_select2(
+        cfg=cfg, paths=paths, store=store, campaign=campaign,
+        convergence=_load_verified_target_size_convergence_authority(store), deploy=deploy, dyn=authority,
+    )
+
+
+
+def _command_verify_train2_dyn(
+    args: argparse.Namespace,
+    *,
+    cfg: Mapping[str, Any],
+    paths: CampaignPaths,
+    store: CampaignStore,
+    campaign: Any,
+    model_dtype: str,
+    deploy: Any,
+    relax: Any,
+) -> int:
+    """Run/reuse DYN-VERIFY2 on common DFT-relaxed bases through deployed ML-IAP/LAMMPS."""
+
+    import mdstats
+    try:
+        from ase.io import read
+    except ModuleNotFoundError as exc:
+        raise CampaignCliError(f"DYN-VERIFY2 requires ASE: {exc}") from exc
+
+    if relax.campaign_plan_digest != campaign.content_digest or relax.stage_context != deploy.stage_context:
+        raise CampaignCliError("DYN-VERIFY2 received stale RELAX-VERIFY1 authority.")
+    policy = _dyn_verify_policy(cfg)
+    plan = mdstats.build_dyn_verify_plan(relax, policy=policy)
+    reference_path = Path(relax.reference_artifact.reference_path).resolve()
+    if not reference_path.is_file() or _sha256(reference_path) != relax.reference_artifact.reference_sha256:
+        raise CampaignCliError("DYN-VERIFY2 common DFT-relaxed reference bytes changed after RELAX-VERIFY1.")
+    all_reference = read(reference_path, index=":")
+    if not isinstance(all_reference, list):
+        all_reference = [all_reference]
+    references = tuple(all_reference[i] for i in plan.base_reference_indices)
+    if len(references) != len(plan.base_frame_uids):
+        raise CampaignCliError("DYN-VERIFY2 reference-base inventory changed.")
+
+    eligible_relax = {record.run_plan_digest: record for record in relax.run_records if record.passed}
+    deploy_by_run = {record.run_plan_digest: record for record in deploy.run_records}
+    cached = store.get_record_optional("dyn_verify", mdstats.DynVerifyCampaignRecord)
+    if cached is not None:
+        reusable = bool(
+            cached.campaign_plan_digest == campaign.content_digest
+            and cached.relax_verify_campaign_digest == relax.content_digest
+            and cached.deploy_verify_campaign_digest == deploy.content_digest
+            and cached.policy.policy_digest == policy.policy_digest
+            and cached.plan.content_digest == plan.content_digest
+            and {v.run_plan_digest for v in cached.run_records} == set(eligible_relax)
+        )
+        if reusable:
+            for record in cached.run_records:
+                relax_record = eligible_relax[record.run_plan_digest]
+                deploy_record = deploy_by_run.get(record.run_plan_digest)
+                mliap = Path(record.mliap_artifact_path).resolve()
+                exe = Path(record.lammps_executable_path).resolve()
+                if (
+                    deploy_record is None
+                    or record.relax_verify_run_digest != relax_record.content_digest
+                    or record.deploy_verify_run_digest != deploy_record.content_digest
+                    or not mliap.is_file() or _sha256(mliap) != record.mliap_artifact_sha256
+                    or not exe.is_file() or _sha256(exe) != record.lammps_executable_sha256
+                    or any(
+                        not metric.trajectory_path or not Path(metric.trajectory_path).is_file()
+                        or _sha256(Path(metric.trajectory_path)) != metric.trajectory_sha256
+                        for metric in record.case_metrics
+                    )
+                ):
+                    reusable = False
+                    break
+        if reusable:
+            _ok(f"DYN-VERIFY2 reused for {len(cached.run_records)} RELAX-qualified candidate(s)")
+            return _finalize_train2_dyn(cfg=cfg, paths=paths, store=store, campaign=campaign, deploy=deploy, authority=cached)
+        store.delete_record("dyn_verify")
+
+    root = (paths.results / "dyn-verify2").resolve(); root.mkdir(parents=True, exist_ok=True)
+    _mark_stage(store, paths, "verify", StageState.RUNNING, "running DYN-VERIFY2 short deployed structural dynamics")
+    timeout = float(_cfg(cfg, "verification", "dyn_lammps_timeout_seconds", 3600.0))
+    records = []
+    for relax_record in sorted(eligible_relax.values(), key=lambda v: v.run_plan_digest):
+        deploy_record = deploy_by_run.get(relax_record.run_plan_digest)
+        if deploy_record is None:
+            raise CampaignCliError("DYN-VERIFY2 RELAX-qualified candidate lost its DEPLOY-VERIFY1 record.")
+        mliap = Path(deploy_record.mliap_artifact_path).resolve()
+        if not mliap.is_file() or _sha256(mliap) != deploy_record.mliap_artifact_sha256:
+            raise CampaignCliError("DYN-VERIFY2 ML-IAP artifact bytes changed after DEPLOY-VERIFY1.")
+        case_metrics = []
+        seed_index = 0
+        for base_index, (uid, selected, reference) in enumerate(zip(
+            plan.base_frame_uids, plan.topology_atom_indices_by_base, references
+        )):
+            for temperature in plan.temperatures_kelvin:
+                velocity_seed = plan.case_velocity_seeds[seed_index]; seed_index += 1
+                case_root = root / relax_record.run_plan_digest / f"base-{base_index:02d}-T{temperature:g}K"
+                print(
+                    f"[DYN] {relax_record.run_plan_digest[:12]} base={base_index} T={temperature:g} K "
+                    f"({policy.nvt_steps} NVT + {policy.nve_steps} NVE steps)", flush=True,
+                )
+                metric = mdstats.run_lammps_mliap_dynamics_case(
+                    mliap, reference, base_frame_uid=uid, topology_atom_indices=selected,
+                    temperature_kelvin=temperature, velocity_seed=velocity_seed,
+                    element_order=deploy_record.lammps_run0.element_order, policy=policy,
+                    lammps_executable=deploy_record.lammps_run0.executable_path,
+                    lammps_arguments=deploy_record.lammps_run0.command_arguments,
+                    work_directory=case_root, timeout_seconds=timeout,
+                    expected_executable_sha256=deploy_record.lammps_run0.executable_sha256,
+                )
+                case_metrics.append(metric)
+                status = "PASS" if metric.passed else "FAIL"
+                print(
+                    f"[DYN {status}] base={base_index} T={temperature:g} K: drift={metric.absolute_energy_drift_ev_per_atom_per_ps:.4g} "
+                    f"eV/atom/ps; persistent_damage={metric.persistent_structural_damage}", flush=True,
+                )
+        record = mdstats.DynVerifyRunRecord(
+            run_plan_digest=relax_record.run_plan_digest, relax_verify_run_digest=relax_record.content_digest,
+            deploy_verify_run_digest=deploy_record.content_digest, mliap_artifact_path=str(mliap),
+            mliap_artifact_sha256=deploy_record.mliap_artifact_sha256,
+            lammps_executable_path=deploy_record.lammps_run0.executable_path,
+            lammps_executable_sha256=deploy_record.lammps_run0.executable_sha256,
+            lammps_arguments=deploy_record.lammps_run0.command_arguments,
+            policy_digest=policy.policy_digest, plan_digest=plan.content_digest, case_metrics=tuple(case_metrics),
+        )
+        store.put_record(f"dyn_verify_run:{record.run_plan_digest}", record)
+        records.append(record)
+    authority = mdstats.DynVerifyCampaignRecord(
+        campaign_plan_digest=campaign.content_digest, relax_verify_campaign_digest=relax.content_digest,
+        deploy_verify_campaign_digest=deploy.content_digest, policy=policy, plan=plan,
+        run_records=tuple(records), stage_context=relax.stage_context,
+    )
+    store.put_record("dyn_verify", authority)
+    _atomic_json(root / "dyn-verify2.json", authority.to_dict())
+    return _finalize_train2_dyn(cfg=cfg, paths=paths, store=store, campaign=campaign, deploy=deploy, authority=authority)
+
+
+def _command_verify_train2_deploy(
+    args: argparse.Namespace,
+    *,
+    cfg: Mapping[str, Any],
+    paths: CampaignPaths,
+    store: CampaignStore,
+    campaign: Any,
+    model_dtype: str,
+    evaluate_state: StageState,
+) -> int:
+    import mdstats
+
+    if evaluate_state is not StageState.COMPLETE:
+        raise CampaignCliError("DEPLOY-VERIFY1 requires completed EVAL2 static evaluation; rerun `evaluate` first.")
+    convergence = _load_verified_target_size_convergence_authority(store)
+    stage_context, runs = _deploy_verify_candidate_runs(campaign, convergence)
+    entries = _current_data8_entries(store)
+    jobs = _job_lookup(entries)
+    executions = _available_successful_executions(cfg, paths, store, campaign, jobs)
+    role_freeze = store.get_record("target_data_role_freeze", mdstats.TargetDataRoleFreeze)
+    ladder = _load_verified_target_data_ladder_authority(store)
+    policy = _deploy_verify_policy(cfg, model_dtype=model_dtype)
+    local_wrappers = _ensure_local_wrappers(paths)
+    _mark_stage(store, paths, "verify", StageState.RUNNING, "running DEPLOY-VERIFY1 deployment parity")
+    records = []
+    for run in runs:
+        execution = executions.get(run.content_digest)
+        if execution is None:
+            raise CampaignCliError(f"DEPLOY-VERIFY1 run {run.run_id} lacks a successful TRAIN2 execution.")
