+ONLINE_MONITOR_POLICY_SCHEMA = "mdstats.online-monitor-policy.v2"
+ONLINE_MONITOR_POLICY_V1_SCHEMA = "mdstats.online-monitor-policy.v1"
+ONLINE_MONITOR_RECORD_SCHEMA = "mdstats.online-monitor-record.v1"
