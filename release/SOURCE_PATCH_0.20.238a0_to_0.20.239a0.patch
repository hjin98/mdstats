+                np.asarray([0], dtype=np.int64),
+                np.cumsum(assignments[1:] != assignments[:-1], dtype=np.int64),
+            ]
+        )
+        if not np.array_equal(
+            self.cumulative_changed_boundaries.values, expected_cumulative
