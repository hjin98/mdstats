+            "focus_force_rmse_ev_per_angstrom",
+            tuple(sorted((str(k), _finite_nonnegative(v, name=f"focus_force_rmse[{k}]") or 0.0) for k, v in self.focus_force_rmse_ev_per_angstrom)),
+        )
+        object.__setattr__(
+            self,
+            "condition_force_rmse_ev_per_angstrom",
