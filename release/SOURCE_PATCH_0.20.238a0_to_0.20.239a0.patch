+        else:
+            optional_geometry = (
+                self.oxygen_vertex_centroid,
+                self.oxygen_area_centroid,
+                self.oxygen_area_centroid_fractional,
+                self.ordered_unit_normal,
+                self.covariance_eigenvalues,
+                self.vector_area_magnitude,
+                self.projected_area,
+                self.perimeter,
