+def _job_lookup(entries: Sequence[_Data8RuntimeEntry]) -> dict[str, tuple[Any, Any, Path]]:
+    result: dict[str, tuple[Any, Any, Path]] = {}
+    for entry in entries:
+        for job in entry.bundle.jobs:
+            result[job.content_digest] = (entry.bundle, job, entry.root)
+    return result
+
+
+def _resolve_data8_runtime_member(
+    bundle: Any,
+    runtime_root: Path,
+    recorded_path: str | Path,
+) -> Path:
+    """Rebase a bundle-scoped DATA8 member onto the promoted runtime tree.
+
+    Bundle-scoped artifacts use paths relative to the DATA8 bundle root, while
+    older replay records may contain absolute staging paths.  Run/job-scoped
+    ``MaceExtxyzArtifact.relative_path`` values are intentionally handled by
+    :func:`_resolve_data8_job_member` because those paths are relative to the
+    job directory that created them, not to the bundle root.
+    """
+
+    path = Path(recorded_path)
+    if not path.is_absolute():
+        return runtime_root / path
+    recorded_root = Path(bundle.output_directory)
+    try:
+        relative = path.relative_to(recorded_root)
+    except ValueError:
+        # Compatibility with directly materialized legacy bundles whose absolute
+        # replay artifact still exists outside the DATA8 tree.
+        return path
+    return runtime_root / relative
+
+
+def _resolve_data8_job_member(
+    bundle: Any,
+    runtime_root: Path,
+    job: Any,
+    recorded_path: str | Path,
+) -> Path:
+    """Resolve one DATA8 artifact whose relative path is job-directory scoped.
+
+    ``write_mace_extxyz_artifact(job_dir, ...)`` records paths relative to
+    ``job_dir`` (for example ``target_checkpoint_full.xyz``).  The promoted
+    runtime root, however, is the DATA8 bundle root.  Reattach the immutable job
+    directory before resolving the artifact so SELECT1/AGG1 inspect the bytes
+    that DATA8 actually materialized.  Historical absolute paths retain the
+    ordinary DATA8 staging-rebase behavior.
+    """
+
+    path = Path(recorded_path)
+    if path.is_absolute():
+        return _resolve_data8_runtime_member(bundle, runtime_root, path)
+
+    root = Path(runtime_root).resolve()
+    job_root = (root / job.relative_directory).resolve()
+    try:
+        job_root.relative_to(root)
+    except ValueError as exc:
+        raise CampaignCliError(
+            f"DATA8 job directory escaped its promoted bundle root: {job.relative_directory}"
+        ) from exc
+    candidate = (job_root / path).resolve()
+    try:
+        candidate.relative_to(job_root)
+    except ValueError as exc:
+        raise CampaignCliError(
+            f"DATA8 job artifact escaped its job directory: {recorded_path}"
+        ) from exc
+    return candidate
+
+
