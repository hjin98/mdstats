+    if mlcv_migration is not None:
+        print(
+            f"MLCV migration: complete ({mlcv_migration.migration_version}; "
+            f"historical records preserved={len(mlcv_migration.historical_evidence_keys)})",
+            flush=True,
+        )
+    else:
+        mlcv_production = store.get_record_optional(
+            "mlcv_production_model", mdstats.MlcvProductionModelRecord
+        )
+        if (authority is not None and authority.authority_kind == "mlcv_deployment") or mlcv_production is not None:
+            print(
+                "MLCV migration: pending closure; rerun `verify` once under mdstats >=0.20.140a0. "
+                "Completed SELECT1/AGG1/FINAL1/VERIFY1 evidence will be authenticated and reused.",
+                flush=True,
+            )
+    historical = _historical_algorithm_evidence_keys(store)
+    if historical:
+        print(
+            f"Historical evaluator evidence: {len(historical)} preserved record(s); read-only for adaptive selection.",
+            flush=True,
+        )
+    if next_command:
+        print(f"\nNext command: python tools/mdstats-mlff-campaign.py --config {paths.config} {next_command}")
+    else:
+        print("\nAll bounded campaign stages are complete.")
+    return 0
