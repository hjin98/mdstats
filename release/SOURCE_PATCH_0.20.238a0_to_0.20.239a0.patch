+class SpatialRegistrationMode(str, Enum):
+    """Coordinate registration used by the mean framework and trajectories."""
+
+    MATERIAL = "material"
+    FRAMEWORK_REGISTERED = "framework_registered"
+    LABORATORY = "laboratory"
+
