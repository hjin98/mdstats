+def _finite_nonnegative(value: float | None, *, name: str) -> float | None:
+    if value is None:
+        return None
+    result = float(value)
+    if not np.isfinite(result) or result < 0.0:
+        raise TrainingDataInputError(f"{name} must be finite and nonnegative when present.")
+    return result
+
