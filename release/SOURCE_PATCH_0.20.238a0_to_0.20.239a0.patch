+def detect_full_resolution_events(
+    frame_catalog: Any,
+    raw_features: Any,
+    *,
+    lta_features: Any | None = None,
+    profile_features: tuple[Any, ...] = (),
+    policy: EventDetectionPolicy | None = None,
+    progress_callback: Callable[[str], None] | None = None,
