+def _archive_extension_record(store: CampaignStore, extension_id: str, key: str) -> None:
+    payload = store.get_payload_optional(key)
+    if payload is None:
+        return
+    source_digest = store.record_digest(key) or digest(payload)
+    archive_key = f"historical_seed_extension:{extension_id}:{key}:{source_digest}"
+    if not store.has_record(archive_key):
+        store.put_record(
+            archive_key,
+            {
+                "schema": SEED_EXTENSION_ARCHIVE_SCHEMA,
+                "extension_id": extension_id,
+                "source_key": key,
+                "source_record_digest": source_digest,
+                "payload": payload,
+            },
+        )
+
+
+def _reopen_mlcv_authority_for_seed_extension(
+    store: CampaignStore, *, extension_id: str, parent_campaign: Any
+) -> None:
+    """Archive campaign-level derived authority while preserving run-local scientific evidence."""
+
+    # A seed extension is forbidden after VERIFY1/protocol freeze, so these are
+    # all derived records that are safe and necessary to rebuild against the
+    # strict campaign-plan superset. SELECT1, checkpoint evaluations, and outer
+    # fold records stay canonical and are reused by exact run-plan digest.
+    keys = [
+        "mlcv_lifecycle_authority",
+        "mlcv_campaign_cv",
+        "mlcv_final_selection",
+        "mlcv_final_committee",
+    ]
+    keys.extend(store.record_keys("mlcv_seed_cv:"))
+    keys.extend(store.record_keys("mlcv_final_committee_member:"))
+    for key in keys:
+        _archive_extension_record(store, extension_id, key)
+        store.delete_record(key)
+    historical_campaign_key = f"historical_training_campaign:{parent_campaign.content_digest}"
+    if not store.has_record(historical_campaign_key):
+        store.put_record(historical_campaign_key, parent_campaign)
+
+
+def _seed_extension_forbidden_authority(store: CampaignStore) -> tuple[str, ...]:
+    forbidden = (
+        "mlcv_verification",
+        "mlcv_locked_test",
+        "mlcv_production_model",
+        "mlcv_protocol_freeze",
+        "mlcv_migration",
+        "protocol_freeze",
+    )
+    return tuple(key for key in forbidden if store.has_record(key))
