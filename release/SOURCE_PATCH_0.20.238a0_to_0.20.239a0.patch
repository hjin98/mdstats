+            scientific_protocol_digest=str(payload["scientific_protocol_digest"]), mace_mh1_sha256=str(payload["mace_mh1_sha256"]),
+            mace_mpa0_sha256=str(payload["mace_mpa0_sha256"]), target_head=str(payload["target_head"]),
