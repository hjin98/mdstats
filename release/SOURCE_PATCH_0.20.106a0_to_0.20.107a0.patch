+    payload = json.loads(json_path.read_text(encoding="utf-8"))
+    assert [item["epoch"] for item in payload["epochs"]] == [0, 1, 2]
+    assert payload["epochs"][0]["rounds"][0]["fraction"] == 0.5
+    assert payload["epochs"][1]["outcome"] == "screened_out"
