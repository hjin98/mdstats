+def _normalize_legacy_storage_argv(argv: Sequence[str] | None) -> list[str]:
+    """Map pre-0.20.117 top-level storage commands into the unified hierarchy."""
+
+    tokens = list(sys.argv[1:] if argv is None else argv)
+    index = 0
