+"""GFX3D-2 common Plotly renderer for independent prepared layers.
+
+This renderer intentionally reuses the qualified legacy Plotly rendering
+functions one layer at a time.  Scientific products are never recomputed.  The
+fixed composite renderer therefore acts as a backend compatibility engine while
+GFX3D owns layer composition and trace ownership.
+"""
+
+from __future__ import annotations
+
+from dataclasses import replace
+from typing import Any
+
+from .contracts import PreparedGraphicsLayer3D, PreparedGraphicsScene3D
+from .errors import Graphics3DValidationError
+from .render_result import Graphics3DRenderResult, GraphicsLayerRenderResult
+
+
+def _render_options(layer: PreparedGraphicsLayer3D) -> dict[str, Any]:
+    from mdstats.plotting.atomic_density import AtomicDensity3DRenderOptions
+    from mdstats.plotting.framework_density import FrameworkDensity3DRenderOptions
+    from mdstats.plotting.framework_dynamics import (
+        AtomicMeanGraph3DRenderOptions,
+        Trajectory3DRenderOptions,
+    )
+
+    values = dict(layer.request.render_options)
+    if layer.request.layer_type == "trajectory":
+        return {"trajectory_options": Trajectory3DRenderOptions(**values)}
+    if layer.request.layer_type == "connectivity":
+        return {"atomic_mean_graph_options": AtomicMeanGraph3DRenderOptions(**values)}
+    if layer.request.layer_type == "density":
+        source_kind = str(layer.product_refs.get("density_source_kind", "atomic"))
+        if source_kind == "atomic":
+            return {"density_options": AtomicDensity3DRenderOptions(**values)}
+        return {"framework_density_options": FrameworkDensity3DRenderOptions(**values)}
+    if values:
+        # Framework style belongs to GraphStyle/Graph3DRenderOptions in the legacy
+        # backend and is intentionally deferred to GFX3D-5's universal style model.
+        raise Graphics3DValidationError(
+            "GFX3D-2 framework render_options are not yet mapped to the legacy GraphStyle; "
+            "leave them empty until GFX3D-5 universal styling."
+        )
+    return {}
+
+
+def _single_layer_legacy_scene(layer: PreparedGraphicsLayer3D):
+    from mdstats.plotting.framework_density import FrameworkDensityFields
+
+    source = layer.product_refs.get("source_scene")
+    if source is None:
+        raise Graphics3DValidationError(
+            f"Prepared layer {layer.request.name!r} has no source_scene compatibility reference."
+        )
+    kwargs: dict[str, Any] = {
+        "trajectory_paths": None,
+        "atomic_mean_graph": None,
+        "atomic_density_fields": (),
+        "framework_density_fields": None,
+        "topology_categories": (),
+        "topology_catalog": None,
+    }
+    kind = layer.request.layer_type
+    if kind == "trajectory":
+        kwargs["trajectory_paths"] = layer.product_refs["trajectory_paths"]
+    elif kind == "connectivity":
+        kwargs["atomic_mean_graph"] = layer.product_refs["atomic_mean_graph"]
+    elif kind == "density":
+        field = layer.product_refs["density_field"]
+        source_kind = str(layer.product_refs.get("density_source_kind", "atomic"))
+        if source_kind == "atomic":
+            kwargs["atomic_density_fields"] = (field,)
+        else:
+            is_vertex = "vertex" in source_kind
+            kwargs["framework_density_fields"] = FrameworkDensityFields(
+                vertex_density=field if is_vertex else None,
+                edge_length_density=None if is_vertex else field,
+                edge_source=(
+                    source.framework_density_fields.edge_source
+                    if source.framework_density_fields is not None
+                    else "projected"
+                ),
+                metadata={"gfx3d2_single_layer": True},
+            )
+    elif kind != "framework":
+        raise Graphics3DValidationError(f"Unsupported GFX3D-2 layer type {kind!r}.")
+    return replace(source, **kwargs)
+
+
+def _owned_trace_indices(layer: PreparedGraphicsLayer3D, result: Any) -> tuple[int, ...]:
+    if layer.request.layer_type == "framework":
+        values = set(int(v) for v in result.base_result.cell_trace_indices)
+        for mapping in (
+            result.base_result.node_trace_indices,
+            result.base_result.edge_trace_indices,
+            result.base_result.hover_trace_indices,
+        ):
+            for indices in mapping.values():
+                values.update(int(v) for v in indices)
+        return tuple(sorted(values))
+    if layer.request.layer_type == "connectivity":
+        values = set()
+        for indices in result.atomic_mean_graph_trace_indices.values():
+            values.update(int(v) for v in indices)
+        return tuple(sorted(values))
+    if layer.request.layer_type == "trajectory":
+        values = set(int(v) for v in result.endpoint_trace_indices)
+        for indices in result.trajectory_trace_indices.values():
+            values.update(int(v) for v in indices)
+        return tuple(sorted(values))
+    field = layer.product_refs["density_field"]
+    source_kind = str(layer.product_refs.get("density_source_kind", "atomic"))
+    mapping = result.density_trace_indices if source_kind == "atomic" else result.framework_density_trace_indices
+    return tuple(int(v) for v in mapping.get(str(field.field_key), ()))
+
+
+def render_graphics3d_plotly(
+    scene: PreparedGraphicsScene3D,
+    *,
+    periodic: Any = None,
+    browser_profile: str = "interactive_browser",
+    mesh_profile: Any = None,
+) -> Graphics3DRenderResult:
+    """Render arbitrary prepared layer combinations into one Plotly figure."""
+
+    if not isinstance(scene, PreparedGraphicsScene3D):
+        raise Graphics3DValidationError("scene must be PreparedGraphicsScene3D.")
+    if not scene.layers:
+        raise Graphics3DValidationError("Prepared GFX3D scene has no enabled layers.")
+
+    import plotly.graph_objects as go
+    from mdstats.plotting.framework_dynamics import plot_framework_dynamics_3d
+
+    output = go.Figure()
+    layer_results: dict[str, GraphicsLayerRenderResult] = {}
+    warnings: list[str] = []
+    base_layout_copied = False
+
+    for layer in scene.layers:
+        legacy_scene = _single_layer_legacy_scene(layer)
+        result = plot_framework_dynamics_3d(
+            legacy_scene,
+            periodic=periodic,
+            browser_profile=browser_profile,
+            mesh_profile=mesh_profile,
+            **_render_options(layer),
+        )
+        if not base_layout_copied:
+            output.update_layout(result.figure.layout)
+            base_layout_copied = True
+        owned = _owned_trace_indices(layer, result)
+        added: list[int] = []
+        for old_index in owned:
+            trace = result.figure.data[old_index]
+            trace.visible = True if layer.request.initially_visible else "legendonly"
+            output.add_trace(trace)
+            added.append(len(output.data) - 1)
+        layer_results[layer.request.name] = GraphicsLayerRenderResult(
+            layer_name=layer.request.name,
+            backend_object_indices=tuple(added),
+            legend_group=layer.request.name,
+            scientific_identity=layer.scientific_identity,
+            render_identity=layer.render_identity,
+            metadata={
+                "renderer": "plotly",
+                "gfx3d_gate": "GFX3D-2",
+                "legacy_backend_trace_count": len(result.figure.data),
+                "owned_trace_count": len(added),
+            },
+        )
+        warnings.extend(str(v) for v in result.base_result.warnings)
+
+    return Graphics3DRenderResult(
+        artifact=output,
+        scene=scene,
+        layer_results=layer_results,
+        render_metadata={
+            "renderer": "plotly",
+            "schema_version": "mdstats.graphics3d.plotly-render-result.gfx3d2.v1",
+            "layer_count": len(scene.layers),
+        },
+        warnings=tuple(dict.fromkeys(warnings)),
+    )
