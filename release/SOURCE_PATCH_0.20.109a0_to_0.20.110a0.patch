+def _critical_precision_policy(cfg: Mapping[str, Any]) -> Any:
+    """Return the profile-bound critical precision policy.
+
+    Schedule-free configurations retain the historical critical-FP64 policy.
+    Explicit PREC1 profiles bind the critical operation dtype into DATA8 and
+    all runtime stages consume the same policy rather than inferring behavior
+    from a local model dtype.
+    """
+
+    import mdstats
+
+    precision_schedule = _precision_schedule_policy(cfg)
+    if precision_schedule is None:
+        return mdstats.MaceCriticalPrecisionPolicy()
+    return mdstats.MaceCriticalPrecisionPolicy.for_dtype(
+        precision_schedule.critical_operation_dtype
+    )
+
