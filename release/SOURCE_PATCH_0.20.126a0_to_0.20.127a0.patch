+        if payload is None or payload.get("case_digest") != case_digest:
+            raise CampaignCliError(
+                "ADAPT-VERIFY1 verification-case evidence disappeared after the "
+                "candidate decision was frozen."
+            )
+        results.append(dict(payload["result"]))
