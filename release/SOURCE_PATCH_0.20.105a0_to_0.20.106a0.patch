+
+    mf_policy = _multi_fidelity_policy(cfg)
+    target_artifacts, training_replay_artifact = _artifact_lookup(bundle)
+    target_artifact = target_artifacts[run.target_monitor_artifact_digest]
+    job_root = (root / job.relative_directory).resolve()
+    target_path = (job_root / target_artifact.relative_path).resolve()
+    target_sidecar_path = (job_root / target_artifact.sidecar_relative_path).resolve()
+
+    active_training_replay_artifact = None
+    evaluation_replay_artifact = None
+    training_replay_path = None
+    replay_path = None
+    if run.replay_monitor_artifact_digest is not None:
+        if training_replay_artifact is None:
+            raise CampaignCliError(
