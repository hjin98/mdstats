+    prediction_cache_directory: Path,
+    graph_cache_directory: Path,
+    foundation_prediction_manifest: Any,
+    foundation_prediction_root: Path | None,
+    local_wrappers: Mapping[str, Path],
+) -> _CheckpointShortlist:
+    """Execute EVAL-MF1 and return the full-fidelity finalist catalog.
+
+    Partial round records are stored only under ``multifidelity_round:*`` keys.
+    The final 1.0 round additionally publishes the ordinary ``evaluation:*``
+    record, so the unchanged authoritative selection/export pipeline consumes
+    only complete-monitor evidence.
+    """
+
