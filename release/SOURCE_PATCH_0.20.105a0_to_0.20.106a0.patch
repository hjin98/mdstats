+
+    target_ladder = _load_or_build_multi_fidelity_ladder(
+        store,
+        domain="target",
+        monitor_path=target_path,
+        monitor_artifact_digest=target_artifact.content_digest,
+        geometry_identities=target_artifact.frame_uids,
+        policy=mf_policy,
+        condition_keys=evaluation_policy.condition_keys,
+        sidecar_path=target_sidecar_path,
+    )
+    replay_ladder = None
+    if evaluation_replay_artifact is not None and replay_path is not None:
+        replay_ladder = _load_or_build_multi_fidelity_ladder(
+            store,
+            domain="replay",
+            monitor_path=Path(replay_path),
+            monitor_artifact_digest=evaluation_replay_artifact.content_digest,
+            geometry_identities=evaluation_replay_artifact.geometry_identities,
+            policy=mf_policy,
+            condition_keys=evaluation_policy.condition_keys,
+            sidecar_path=None,
