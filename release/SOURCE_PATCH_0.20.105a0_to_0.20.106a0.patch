+multi_fidelity_round_fractions = [0.10, 0.33, 1.0]
+multi_fidelity_survival_fraction = 0.3333333333333333
+multi_fidelity_minimum_finalists = 4
 # Permit checkpoint evaluation after any run completes. Incomplete campaigns are
