+        atoms.info["config_type"] = "target"
+        atoms.info["run_id"] = "run-a" if index < 2 else "run-b"
+        atoms.info["source_frame_index"] = 10 + index
+        atoms.info["temperature_kelvin"] = 300 if index % 2 == 0 else 700
+        atoms_list.append(atoms)
