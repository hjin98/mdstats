+def _multi_fidelity_policy(cfg: Mapping[str, Any]) -> Any:
+    import mdstats
+
+    raw = _cfg(cfg, "evaluation", "multi_fidelity_round_fractions", [0.10, 0.33, 1.0])
+    if isinstance(raw, (int, float)):
+        fractions = (float(raw),)
+    else:
+        fractions = tuple(float(value) for value in raw)
+    return mdstats.MultiFidelityEvaluationPolicy(
+        round_fractions=fractions,
+        survival_fraction=float(
+            _cfg(cfg, "evaluation", "multi_fidelity_survival_fraction", 1.0 / 3.0)
+        ),
+        minimum_finalists=int(
+            _cfg(cfg, "evaluation", "multi_fidelity_minimum_finalists", 4)
+        ),
+    )
+
+
+def _monitor_order_metadata(
+    monitor_path: Path,
+    geometry_identities: Sequence[str],
+    *,
+    condition_keys: Sequence[str],
+    sidecar_path: Path | None = None,
+) -> tuple[tuple[str, ...], tuple[str, ...], tuple[int, ...]]:
+    """Return label-independent stratum/source/time metadata for one monitor."""
+
+    try:
+        from ase.io import read as ase_read
+    except ModuleNotFoundError as exc:  # pragma: no cover - campaign already needs ASE
+        raise CampaignCliError("ASE is required for multi-fidelity monitor planning.") from exc
+
+    atoms_list = tuple(ase_read(str(monitor_path), index=":"))
+    if len(atoms_list) != len(tuple(geometry_identities)):
+        raise CampaignCliError(
+            f"Multi-fidelity monitor metadata count changed for {monitor_path}."
+        )
+    strata: list[str] = []
+    sources: list[str] = []
+    temporal: list[int] = []
+    source_keys = ("run_id", "source_id", "trajectory_id", "source")
+    temporal_keys = ("source_frame_index", "frame_index", "step", "timestep")
+    for index, atoms in enumerate(atoms_list):
+        values = [str(atoms.info.get("config_type", "missing:config_type"))]
+        values.extend(
+            str(atoms.info.get(key, f"missing:{key}")) for key in condition_keys
+        )
+        strata.append("|".join(values))
+        source_value = "all"
+        for key in source_keys:
+            value = atoms.info.get(key)
+            if value not in (None, ""):
+                source_value = str(value)
+                break
+        sources.append(source_value)
+        temporal_value = index
+        for key in temporal_keys:
+            value = atoms.info.get(key)
+            if value in (None, ""):
+                continue
+            try:
+                temporal_value = int(value)
+            except (TypeError, ValueError):
+                continue
+            break
+        temporal.append(temporal_value)
+
+    if sidecar_path is not None and sidecar_path.is_file():
+        try:
+            import mdstats
+
+            sidecar = mdstats.MaceSidecarManifest.from_dict(
+                json.loads(sidecar_path.read_text(encoding="utf-8"))
+            )
+            sidecar_by_uid = {uid: dict(values) for uid, values in sidecar.records}
+            for index, identity in enumerate(geometry_identities):
+                payload = sidecar_by_uid.get(str(identity))
+                if payload is None:
+                    continue
+                sources[index] = str(payload.get("run_id", "all"))
+                temporal[index] = int(payload.get("source_frame_index", index))
+                domain = payload.get("label_domain_id")
+                if domain not in (None, ""):
+                    strata[index] = f"{strata[index]}|domain:{domain}"
+        except Exception as exc:
+            _warn(
+                f"multi-fidelity target sidecar metadata unavailable; falling back to "
+                f"extxyz-only deterministic ordering ({exc})"
+            )
+    return tuple(strata), tuple(sources), tuple(temporal)
+
+
+def _load_or_build_multi_fidelity_ladder(
+    store: CampaignStore,
+    *,
+    domain: str,
+    monitor_path: Path,
+    monitor_artifact_digest: str,
+    geometry_identities: Sequence[str],
+    policy: Any,
+    condition_keys: Sequence[str],
+    sidecar_path: Path | None = None,
+) -> Any:
+    import mdstats
+
+    key = f"multifidelity_ladder:{domain}:{monitor_artifact_digest}:{policy.policy_digest}"
+    if store.has_record(key):
+        try:
+            ladder = mdstats.MultiFidelityMonitorLadder.from_dict(store.get_payload(key))
+            if (
+                ladder.monitor_artifact_digest == monitor_artifact_digest
+                and ladder.round_fractions == policy.round_fractions
+                and ladder.geometry_identities == tuple(str(value) for value in geometry_identities)
+            ):
+                return ladder
+        except Exception:
+            store.delete_record(key)
+    strata, sources, temporal = _monitor_order_metadata(
+        monitor_path,
+        geometry_identities,
+        condition_keys=condition_keys,
+        sidecar_path=sidecar_path,
+    )
+    ladder = mdstats.build_monitor_ladder(
+        domain=domain,
+        monitor_artifact_digest=monitor_artifact_digest,
+        geometry_identities=geometry_identities,
+        policy=policy,
+        stratum_labels=strata,
+        source_labels=sources,
+        temporal_indices=temporal,
+    )
+    store.put_record(key, ladder.to_dict())
+    return ladder
+
