+def test_storage_cli_writes_read_only_report(tmp_path: Path) -> None:
+    config = _write_config(tmp_path)
+    cfg, paths = campaign_cli._load_config(config)
+    (paths.runs / "run-a" / "checkpoints").mkdir(parents=True)
