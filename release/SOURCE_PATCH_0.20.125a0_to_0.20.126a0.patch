+      "result": "5 passed"
+    },
+    {
+      "scope": "final focused EVAL1/MON1/historical-EVAL-MF regression after documentation freeze",
+      "result": "18 passed",
+      "note": "covers top-K/full-score policy, generated strategy/specification, full-target materialization, and historical EVAL-MF compatibility"
+    }
+  ],
+  "evaluation_policy": {
+    "target_force_rmse_threshold_ev_per_angstrom": 0.03,
+    "default_target_score_weight": 1.0,
+    "default_replay_score_weight": 1.0,
+    "default_replay_force_rmse_threshold_ev_per_angstrom": 0.03,
+    "score_expression": "(w_target * target_force_rmse + w_replay * replay_force_rmse) / (w_target + w_replay)",
+    "rescue_condition": "purchase next batch only when no already-purchased candidate is fully admissible"
+  }
+}
