+def prepare_auxiliary_replay_validation_loader(model: Any, valid_loaders: Mapping[str, Any]) -> dict[str, Any]:
+    """Inject the fixed true-label replay monitor for one-head/naive training.
+
+    Multi-head replay already exposes its independent ``pt_head`` validation
+    loader through MACE.  A naive fine-tuning model has only the target head,
+    but ADAPT-STOP1/RANK1 still require the same target+replay objective.  When
+    the campaign supplies the immutable ADAPT-MON1 replay path, build one
+    additional validation loader that evaluates those configurations through
+    the target head.  It is inserted *before* MACE's ordinary target loader so
+    MACE's historical "last validation head" checkpoint/patience behavior
+    remains target-driven.
+    """
+
+    policy = adaptive_stop_policy_from_environment()
+    replay_path = os.environ.get(ADAPTIVE_STOP_AUXILIARY_REPLAY_PATH_ENVIRONMENT_VARIABLE)
+    if policy is None or not policy.replay_enabled or not replay_path:
+        return dict(valid_loaders)
