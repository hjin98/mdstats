+        raise RuntimeError("ADAPT-STOP1 could not import MACE data utilities for auxiliary replay validation.") from exc
+
+    keys = KeySpecification.from_defaults()
+    keys.update(
+        info_keys={"energy": "REF_energy", "stress": "REF_stress"},
+        arrays_keys={"forces": "REF_forces"},
+    )
+    target_head = policy.target_head_name
+    heads = list(getattr(model, "heads", [target_head]))
+    if target_head not in heads:
