+@dataclass(frozen=True)
+class _StagedEvaluationTask:
+    """One OPT-EVAL4 checkpoint flowing through prepare/infer/finalize stages."""
+
+    display_index: int
+    key: str
+    label: str
+    start_detail: str
+    prepare: Callable[[], Any]
+    requires_inference: Callable[[Any], bool]
+    infer: Callable[[Any], Any]
+    finalize: Callable[[Any, Any], Any]
+    done_detail: Callable[[Any, float], str]
+    on_success: Callable[[Any], None] | None = None
+
+
+@dataclass
+class _StagedEvaluationTiming:
+    started: float
+    prepared_seconds: float = 0.0
+    inference_seconds: float = 0.0
+    finalized_seconds: float = 0.0
+
+
+def _run_staged_evaluation_tasks(
+    tasks: Sequence[_StagedEvaluationTask],
+    *,
+    cfg: Mapping[str, Any],
+    device: str,
+    progress: Any,
+) -> dict[str, Any]:
+    """Run evaluation as a bounded CPU -> accelerator -> CPU pipeline.
+
+    CPU checkpoint/model preparation stays ahead of inference, accelerator work
+    retains the existing adaptive CUDA/CPU admission controller, and prediction
+    persistence/metric reduction runs behind it.  No mutable calculator crosses
+    an inference-worker boundary.
+    """
+
+    phase = "evaluation"
+    if not tasks:
+        return {}
+    policy = _inference_concurrency_policy(cfg, phase)
+    try:
+        resources = detect_system_resources(
+            cpu_fraction=float(_cfg(cfg, "performance", "cpu_fraction", 0.90)),
+            ram_fraction=float(_cfg(cfg, "performance", "ram_fraction", 0.80)),
+            gpu_memory_fraction=float(policy.gpu_memory_fraction),
+            device=device,
+        )
+    except ValueError as exc:
+        raise CampaignCliError(str(exc)) from exc
+    cpu_probe = CpuTelemetryProbe(capacity_threads=resources.cpu_threads_available)
+    cpu_sample = cpu_probe.sample(blocking_seconds=0.10)
+    gpu_sample = query_gpu_telemetry(device)
+    plan = build_inference_concurrency_plan(
+        task_count=len(tasks),
+        device=device,
+        resources=resources,
+        policy=policy,
+        gpu_sample=gpu_sample,
+        cpu_sample=cpu_sample,
+    )
+    _configure_inference_thread_budget(plan)
+    controller = AdaptiveInferenceConcurrency(plan, policy)
+
+    def _positive_stage_workers(key: str, default: int) -> int:
+        value = int(_cfg(cfg, "execution", key, 0))
+        if value < 0:
+            raise CampaignCliError(
+                f"[execution].{key} must be zero (auto) or positive."
+            )
+        if value == 0:
+            return max(1, default)
+        return value
+
+    # These workers do not own MACE calculators.  Keep them deliberately small:
+    # their job is to overlap hashing/parsing/materialization and metric I/O with
+    # accelerator work, not to create a second CPU oversubscription problem.
+    auto_cpu_stage_workers = max(1, min(2, int(resources.cpu_threads_available)))
+    prepare_workers = min(
+        len(tasks),
+        _positive_stage_workers(
+            "parallel_evaluation_prepare_jobs", auto_cpu_stage_workers
+        ),
+    )
+    finalize_workers = min(
+        len(tasks),
+        _positive_stage_workers(
+            "parallel_evaluation_finalize_jobs", auto_cpu_stage_workers
+        ),
+    )
+    configured_buffer = int(
+        _cfg(cfg, "execution", "evaluation_pipeline_buffer_jobs", 0)
+    )
+    if configured_buffer < 0:
+        raise CampaignCliError(
+            "[execution].evaluation_pipeline_buffer_jobs must be zero (auto) or positive."
+        )
+    auto_buffer = max(2, min(8, max(1, int(plan.maximum_jobs)) * 2))
+    pipeline_buffer = min(
+        len(tasks), configured_buffer if configured_buffer > 0 else auto_buffer
+    )
+    pipeline_buffer = max(1, pipeline_buffer)
+    finalize_backlog_limit = max(
+        finalize_workers,
+        min(pipeline_buffer, max(2, int(plan.maximum_jobs) * 2)),
+    )
+
+    _ok(
+        "evaluation pipeline: "
+        f"{plan.summary()}; CPU prepare={prepare_workers}, "
+        f"CPU finalize={finalize_workers}, prepared buffer={pipeline_buffer}"
+    )
+
+    pending = deque(tasks)
+    ready_inference: deque[tuple[_StagedEvaluationTask, Any, _StagedEvaluationTiming]] = deque()
+    waiting_finalize: deque[
+        tuple[_StagedEvaluationTask, Any, Any | None, _StagedEvaluationTiming]
+    ] = deque()
+    active_prepare: dict[Future[Any], tuple[_StagedEvaluationTask, _StagedEvaluationTiming]] = {}
+    active_inference: dict[
+        Future[Any], tuple[_StagedEvaluationTask, Any, _StagedEvaluationTiming, _InferenceWorkerStatus]
+    ] = {}
+    active_finalize: dict[
+        Future[Any], tuple[_StagedEvaluationTask, _StagedEvaluationTiming]
+    ] = {}
+    results: dict[str, Any] = {}
+    failures: list[str] = []
+    stop_scheduling = False
+    stage_events: deque[tuple[str, str]] = deque()
+    stage_events_lock = threading.Lock()
+    last_report = 0.0
+    telemetry_ready_active_jobs: int | None = None
+
+    def report_stage_events() -> None:
+        with stage_events_lock:
+            events = tuple(stage_events)
+            stage_events.clear()
+        for task_label, stage in events:
+            print(f"[EVALUATION STAGE] {task_label}: {stage}", flush=True)
+
+    def execute_prepare(task: _StagedEvaluationTask, timing: _StagedEvaluationTiming) -> Any:
+        started = time.monotonic()
+        try:
+            return task.prepare()
+        finally:
+            timing.prepared_seconds += time.monotonic() - started
+
+    def execute_inference(
+        task: _StagedEvaluationTask,
+        prepared: Any,
+        timing: _StagedEvaluationTiming,
+        status: _InferenceWorkerStatus,
+    ) -> Any:
+        def update_phase(stage: str) -> None:
+            if status.set_phase(stage):
+                with stage_events_lock:
+                    stage_events.append((task.label, status.phase()))
+
+        started = time.monotonic()
+        try:
+            with inference_start_signal(
+                status.mark_workload_started,
+                phase_callback=update_phase,
+            ):
+                update_phase("accelerator model conversion / inference")
+                if not str(device).startswith("cuda"):
+                    return task.infer(prepared)
+                try:
+                    import torch
+
