+class _Probe:
+    def __init__(self, **kwargs):
+        pass
+
+    def sample(self, **kwargs):
+        return CpuTelemetrySample(time.monotonic(), 0.0)
+
+    def reset(self):
+        pass
+
+
+class _Progress:
+    def item_start(self, *args, **kwargs):
+        pass
+
+    def item_done(self, *args, **kwargs):
+        pass
+
