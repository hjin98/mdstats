+def _target_coverage_feasibility_parallelism(
+    cfg: Mapping[str, Any],
+    coverage_reference: Any,
+) -> tuple[int, int, Any]:
+    """Resolve bounded FEAS1 family/native-tree parallelism.
+
+    FEAS1 has two independent execution layers: feature families can run in
+    parallel, and each family can use native cKDTree workers.  Automatic mode
+    partitions the configured CPU-thread budget between these layers instead
+    of leaving the post-query family work serialized behind one eight-thread
+    tree.  Both counts are execution-only.
+    """
+
+    resources = detect_system_resources(
+        cpu_fraction=float(_cfg(cfg, "performance", "cpu_fraction", 0.90)),
+        ram_fraction=float(_cfg(cfg, "performance", "ram_fraction", 0.80)),
+        gpu_memory_fraction=float(_cfg(cfg, "performance", "gpu_memory_fraction", 0.90)),
+        device="cpu",
+    )
+    requested_tree = int(_cfg(cfg, "performance", "target_coverage_workers", 0))
+    requested_family = int(
+        _cfg(cfg, "performance", "target_coverage_feasibility_family_workers", 0)
+    )
+    if requested_tree < 0:
+        raise CampaignCliError(
+            "[performance].target_coverage_workers must be zero (automatic) or a positive integer."
+        )
+    if requested_family < 0:
+        raise CampaignCliError(
+            "[performance].target_coverage_feasibility_family_workers must be zero (automatic) or a positive integer."
+        )
+
+    max_families = max(
+        (len(domain.families) for domain in coverage_reference.domains),
+        default=1,
+    )
+    budget = max(1, int(resources.cpu_threads_budget))
+    available = max(1, int(resources.cpu_threads_available))
+
+    if requested_family > 0:
+        family_workers = min(max_families, requested_family, available)
+    elif requested_tree > 0:
+        resolved_tree = min(requested_tree, available)
+        family_workers = min(max_families, max(1, budget // max(1, resolved_tree)))
+    else:
+        # Keep at least roughly four native tree lanes per concurrent family
+        # when enough independent family work exists.  This exposes the serial
+        # per-family phases to parallel execution while staying inside budget.
+        family_workers = min(max_families, max(1, budget // 4))
+
+    if requested_tree > 0:
+        tree_workers = min(requested_tree, available)
+    else:
+        tree_workers = min(16, max(1, budget // max(1, family_workers)))
+
+    if family_workers * tree_workers > budget:
+        if requested_family > 0 and requested_tree > 0:
+            raise CampaignCliError(
+                "Explicit TARGET-DATA2B-FEAS1 family/tree workers exceed the configured CPU budget: "
+                f"{family_workers}x{tree_workers} > {budget}."
+            )
+        if requested_tree > 0:
+            family_workers = max(1, min(family_workers, budget // max(1, tree_workers)))
+        else:
+            tree_workers = max(1, budget // max(1, family_workers))
+
+    return int(tree_workers), int(family_workers), resources
+
+
