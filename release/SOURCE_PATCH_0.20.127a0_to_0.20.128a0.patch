+    """Read freeze/historical summary without mutating the campaign state DB."""
+
+    if not state_db.is_file():
+        return None, ()
+    import mdstats
+
+    uri = f"file:{state_db.resolve()}?mode=ro"
+    try:
+        db = sqlite3.connect(uri, uri=True, timeout=30.0)
+        try:
+            row = db.execute(
+                "SELECT payload FROM records WHERE key='protocol_freeze'"
+            ).fetchone()
+            key_rows = db.execute("SELECT key FROM records ORDER BY key").fetchall()
+        finally:
+            db.close()
+    except sqlite3.Error as exc:
+        raise CampaignCliError(
+            f"Could not read campaign migration/storage authority state: {exc}"
+        ) from exc
+    authority = None
+    if row is not None:
+        try:
+            payload = json.loads(row[0])
+            if not isinstance(payload, Mapping):
+                raise TypeError("protocol_freeze payload is not a mapping")
+            # Protocol freeze records are intentionally compact and never externalized.
+            if payload.get("schema") == EXTERNAL_RECORD_POINTER_SCHEMA:
+                raise TypeError("protocol_freeze unexpectedly uses an external pointer")
+            authority = mdstats.protocol_freeze_authority_from_payload(payload)
+        except Exception as exc:
+            raise CampaignCliError(
+                f"Stored protocol-freeze authority is unreadable: {exc}"
+            ) from exc
+    keys = tuple(str(row[0]) for row in key_rows)
+    prefixes = ("evaluation:", "multifidelity_policy:", "multifidelity_round:", "committee_member:")
+    exact = {"protocol_comparison", "committee"}
+    historical = tuple(
+        key for key in keys if key in exact or any(key.startswith(prefix) for prefix in prefixes)
+    )
