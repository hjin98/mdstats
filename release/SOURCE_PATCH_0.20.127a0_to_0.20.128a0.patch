+def _historical_algorithm_evidence_keys(store: "CampaignStore") -> tuple[str, ...]:
+    """Return preserved records produced by retired MLFF ranking/evaluation paths.
+
+    ADAPT-MIGRATE1 treats these as historical evidence.  Merely becoming
+    non-default never grants deletion authority.
+    """
+
+    prefixes = (
+        "evaluation:",
+        "multifidelity_policy:",
+        "multifidelity_round:",
+        "committee_member:",
+    )
+    exact = {"protocol_comparison", "committee"}
+    if hasattr(store, "record_keys"):
