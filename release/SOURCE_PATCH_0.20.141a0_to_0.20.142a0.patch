+            np.flatnonzero(sorted_indices[1:] != sorted_indices[:-1]).astype(np.int64) + 1,
+        )
+    )
+    reduced = np.add.reduceat(sorted_values, starts)
+    accumulator[sorted_indices[starts]] += reduced
