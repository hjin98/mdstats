+def _resolve_data8_job_member(
+    bundle: Any,
+    runtime_root: Path,
+    job: Any,
+    recorded_path: str | Path,
+) -> Path:
+    """Resolve one DATA8 artifact whose relative path is job-directory scoped.
+
+    ``write_mace_extxyz_artifact(job_dir, ...)`` records paths relative to
+    ``job_dir`` (for example ``target_checkpoint_full.xyz``).  The promoted
+    runtime root, however, is the DATA8 bundle root.  Reattach the immutable job
+    directory before resolving the artifact so SELECT1/AGG1 inspect the bytes
+    that DATA8 actually materialized.  Historical absolute paths retain the
+    ordinary DATA8 staging-rebase behavior.
+    """
+
+    path = Path(recorded_path)
+    if path.is_absolute():
+        return _resolve_data8_runtime_member(bundle, runtime_root, path)
+
+    root = Path(runtime_root).resolve()
+    job_root = (root / job.relative_directory).resolve()
+    try:
+        job_root.relative_to(root)
+    except ValueError as exc:
+        raise CampaignCliError(
+            f"DATA8 job directory escaped its promoted bundle root: {job.relative_directory}"
+        ) from exc
+    candidate = (job_root / path).resolve()
+    try:
+        candidate.relative_to(job_root)
+    except ValueError as exc:
+        raise CampaignCliError(
+            f"DATA8 job artifact escaped its job directory: {recorded_path}"
+        ) from exc
+    return candidate
+
