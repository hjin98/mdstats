+    def state_dict(self):
+        return {"_last_lr": list(self._last_lr), "base_lrs": list(self.base_lrs)}
+
+    def load_state_dict(self, state):
+        self._last_lr = list(state["_last_lr"])
+        self.base_lrs = list(state["base_lrs"])
