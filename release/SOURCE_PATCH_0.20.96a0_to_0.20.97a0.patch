+def _linear_checkpoint(path: Path, model: torch.nn.Module, *, epoch: int = 2) -> mdstats.CheckpointFileRecord:
+    torch.save(
+        {
+            "model": model.state_dict(),
+            "optimizer": {},
+            "lr_scheduler": {},
+        },
+        path,
+    )
+    return _record(path, epoch=epoch)
+
