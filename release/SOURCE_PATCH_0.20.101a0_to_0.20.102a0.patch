 def _minimum_distance(atoms: Any) -> float:
+    """Return the exact nearest distinct-atom distance without an N x N matrix.
+
+    The search uses ASE's periodic neighbor-list implementation with an
+    adaptive radius.  As soon as at least one distinct pair is found, the
+    minimum returned distance is globally exact: every omitted pair lies at or
+    beyond the active search radius.  The final radius is bounded by the
+    Cartesian bounding-box diagonal of wrapped positions, which always contains
+    the direct displacement of every distinct pair and therefore guarantees a
+    result for ``len(atoms) >= 2``.
+
+    This keeps the common condensed-phase path near linear in atom count and
+    removes verification's former dense periodic distance matrix.
+    """
     import numpy as np
-    distances = atoms.get_all_distances(mic=True)
-    mask = ~np.eye(len(atoms), dtype=bool)
-    return float(np.min(distances[mask]))
+    from ase.neighborlist import neighbor_list
+
+    n_atoms = len(atoms)
+    if n_atoms < 2:
+        raise ValueError("Minimum pair distance requires at least two atoms.")
+    positions = np.asarray(atoms.get_positions(wrap=True), dtype=float)
+    if positions.shape != (n_atoms, 3) or np.any(~np.isfinite(positions)):
+        raise ValueError("Verification positions must be finite with shape (n_atoms, 3).")
+
+    extent = np.ptp(positions, axis=0)
+    guaranteed_radius = float(np.linalg.norm(extent))
+    scale = max(1.0, guaranteed_radius, float(np.max(np.abs(positions), initial=0.0)))
+    epsilon = max(1.0e-10, np.finfo(float).eps * scale * 256.0)
+    guaranteed_radius = max(guaranteed_radius + epsilon, epsilon)
+
+    # Most condensed-matter verification cells have a nearest pair below 2 A.
+    # Starting there keeps the cell-list stencil local even for very large
+    # replicated cells.  Sparse/pathological cells expand geometrically until
+    # the guaranteed direct-displacement radius is reached.
+    cutoff = min(2.0, guaranteed_radius)
+    while True:
+        first, second, distances = neighbor_list(
+            "ijd", atoms, cutoff, self_interaction=False
+        )
+        first = np.asarray(first, dtype=np.int64)
+        second = np.asarray(second, dtype=np.int64)
+        distances = np.asarray(distances, dtype=float)
+        distinct = first != second
+        if np.any(distinct):
+            accepted = distances[distinct]
+            if np.any(~np.isfinite(accepted)):
+                raise ValueError("Neighbor-list distance search produced non-finite values.")
+            return float(np.min(accepted))
+        if cutoff >= guaranteed_radius:
+            # The direct Cartesian separation of every pair is <= the wrapped
+            # bounding-box diagonal. Reaching this branch for n>=2 therefore
+            # indicates a neighbor-list/runtime inconsistency rather than a
+            # legitimate no-pair configuration.
+            raise RuntimeError(
+                "Periodic neighbor-list search did not return a distinct atom pair "
+                "within the guaranteed direct-displacement radius."
+            )
+        cutoff = min(guaranteed_radius, max(cutoff * 2.0, cutoff + epsilon))
+
