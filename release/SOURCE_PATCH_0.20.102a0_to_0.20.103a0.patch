+def _post_calibration_gpu_poll_seconds(
+    cfg: Mapping[str, Any], policy: InferenceConcurrencyPolicy
+) -> float:
+    """Return the cheaper live-VRAM polling cadence after calibration."""
+
+    configured = float(
+        _cfg(
+            cfg,
+            "execution",
+            "parallel_inference_post_calibration_monitor_interval_seconds",
+            30.0,
+        )
+    )
+    if not math.isfinite(configured) or configured <= 0.0:
+        raise CampaignCliError(
+            "[execution].parallel_inference_post_calibration_monitor_interval_seconds "
+            "must be positive."
+        )
+    return max(float(policy.monitor_interval_seconds), configured)
+
