+        "model_dtype": policy.model_dtype,
+        "training_dtype": training_dtype,
+        "critical_dtype": policy.critical_operation_dtype,
+        "evaluation_dtype": policy.evaluation_dtype,
+        "verification_dtype": policy.verification_dtype,
+        "export_dtype": policy.export_dtype,
+        "mode": policy.mode,
+        "minimum_epochs": str(minimum_epochs),
+        "minimum_updates": str(minimum_updates),
+        "stages": "\n".join(stage_lines).rstrip(),
+    }
